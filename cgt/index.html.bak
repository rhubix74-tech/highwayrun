$('sAdd').addEventListener('click',()=>$('addf').click());
const _sg=setGfxUI; setGfxUI=function(on){ _sg(on); if(on){ renderSet(); $('rstBox').hidden=true; $('rstIn').value=''; $('rstGo').disabled=true; } };
$('rstOpen').addEventListener('click',()=>{ $('rstBox').hidden=false; $('rstOpen').hidden=true; $('rstIn').value=''; $('rstGo').disabled=true; $('rstIn').focus(); });

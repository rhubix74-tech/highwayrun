/* debug panel: press ` (backtick). Shift+1 beams, Shift+2 glow sprites, Shift+3 lamp pools, Shift+4 environment map, Shift+5 car lights, Shift+6 lock night on/off, Shift+7 car sprites, Shift+8 street-lamp sprites, Shift+9 traffic sprites */
{ const el=document.createElement('pre'); el.style.cssText='position:fixed;left:12px;bottom:70px;margin:0;padding:8px 10px;font:11px/1.4 ui-monospace,monospace;color:#9f9;background:rgba(0,0,0,.75);border-radius:6px;display:none;pointer-events:none;z-index:50'; document.body.appendChild(el);
  const env0=scene.environment; let lock=null;
  addEventListener('keydown',e=>{
    if(e.code==='Backquote'){ el.style.display=el.style.display==='none'?'block':'none'; return; }
    if(!e.shiftKey) return;
    if(e.code==='Digit1'){ dbg.noBeams=!dbg.noBeams; carLights.beams.forEach(b=>b.visible=!dbg.noBeams); }
    if(e.code==='Digit2') dbg.noSprites=!dbg.noSprites;
    if(e.code==='Digit3'){ dbg.noPools=!dbg.noPools; lampPools.forEach(p=>p.visible=!dbg.noPools); }
    if(e.code==='Digit4'){ dbg.noEnv=!dbg.noEnv; scene.environment=dbg.noEnv?null:env0; }
    if(e.code==='Digit5'){ dbg.noCarLights=!dbg.noCarLights; carLights.spots.concat(carLights.tails).forEach(l=>l.visible=!dbg.noCarLights); }
    if(e.code==='Digit7') dbg.noCarSp=!dbg.noCarSp;
    if(e.code==='Digit8') dbg.noLampSp=!dbg.noLampSp;
    if(e.code==='Digit9') dbg.noTrafSp=!dbg.noTrafSp;
    if(e.code==='Digit6'){ lock=lock===null?1:lock===1?0:null; window.__nightLock=lock===null?undefined:lock; }
  });
  setInterval(()=>{ if(el.style.display==='none') return;
    el.textContent=`night ${night.toFixed(3)}  L ${L.toFixed(2)}  exposure ${renderer.toneMappingExposure.toFixed(2)}\nfog ${scene.fog.near.toFixed(0)}-${scene.fog.far.toFixed(0)}  cam ${camera.position.x.toFixed(1)},${camera.position.y.toFixed(1)},${camera.position.z.toFixed(1)}\n`+
      `off: ${Object.keys(dbg).filter(k=>dbg[k]).join(' ')||'-'}  lock:${lock}\n`+`GL ${renderer.getContext().getParameter(renderer.getContext().VERSION)}`; },250);
}

addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
// test hooks

/* ---------------- online leaderboards: cash earned (lifetime total, spending doesn't reduce it), best score, total miles.
   Needs a tiny backend: deploy leaderboard-worker.js (Cloudflare Worker + D1) and paste its URL below.
   With LB_URL empty the boards run in offline mode and only show this device. */
const LB_URL='https://carreraleaderboards.rhubix74.workers.dev';
let prof=null; try{ prof=JSON.parse(localStorage.getItem('cgt_profile')||'null'); }catch(e){}
let stats={earned:wallet,miles:0,best:0}; try{ const q=JSON.parse(localStorage.getItem('cgt_stats')||'null'); if(q) stats=Object.assign(stats,q); }catch(e){}
const saveStats=()=>store.set('cgt_stats',JSON.stringify(stats)), saveProf=()=>store.set('cgt_profile',JSON.stringify(prof));
const rid=n=>{ const a=new Uint8Array(n); (crypto.getRandomValues?crypto:{getRandomValues:x=>x.map(()=>Math.random()*256)}).getRandomValues(a); return [...a].map(b=>b.toString(16).padStart(2,'0')).join(''); };
async function lbApi(path,body){
  if(!LB_URL) return null;
  try{ const c=new AbortController(), t=setTimeout(()=>c.abort(),7000);
    const r=await fetch(LB_URL.replace(/\/$/,'')+path,{method:body?'POST':'GET',headers:body?{'content-type':'application/json'}:undefined,body:body?JSON.stringify(body):undefined,signal:c.signal});
    clearTimeout(t); let j=null; try{ j=await r.json(); }catch(e){} return {ok:r.ok,status:r.status,j:j||{},bad:j===null}; }catch(e){ return {ok:false,status:0,j:{},err:e&&e.name==='AbortError'?'timed out after 7 s':'request blocked (network, CORS or offline)'}; }
}
let _subT=null;
function lbSubmit(){ clearTimeout(_subT); _subT=setTimeout(async()=>{
  if(isBetaCar()||!LB_URL||!prof||ADMIN) return;
  if(prof.pending){ const r=await lbApi('/register',{id:prof.id,name:prof.name,token:prof.token}); if(r&&(r.ok)){ prof.pending=false; saveProf(); } else return; }
  await lbApi('/submit',{id:prof.id,token:prof.token,earned:stats.earned,miles:+stats.miles.toFixed(3),best:stats.best});
},800); }
// hooks: every cash gain adds to the lifetime total; every finished run adds miles and updates the best score
{ const _ac=addCash; addCash=function(c){ if(isBetaCar()) return; _ac(c); if(c>0&&!ADMIN){ stats.earned+=c; saveStats(); lbSubmit(); } };
  const _rr=recordRun; recordRun=function(){ if(isBetaCar()) return []; const nb=_rr(); if(!ADMIN){ stats.miles+=Math.max(0,miles); stats.best=Math.max(stats.best,Math.floor(score)); saveStats(); lbSubmit(); } return nb; }; }
// --- username prompt (first launch / new save) and first-run tutorial
const lbShowName=on=>{ $('lbName').classList.toggle('show',on); window.__lbModal=on?'name':($('lb').classList.contains('show')?'lb':undefined); if(on) setTimeout(()=>$('lbIn').focus(),50); };
function showTutorial(){ $('tutorial').classList.add('show'); window.__lbModal='tutorial'; }
function closeTutorial(){ $('tutorial').classList.remove('show'); window.__lbModal=undefined; }
$('tutorialDone').addEventListener('click',closeTutorial);
async function lbCreate(){
  const name=$('lbIn').value.trim(), err=$('lbErr');
  if(!/^[A-Za-z0-9_]{3,16}$/.test(name)){ err.textContent='3-16 characters: letters, numbers or _'; return; }
  const p={id:rid(16),name,token:rid(16),pending:isBetaCar()}; $('lbGo').disabled=true; err.textContent=isBetaCar()?'Saving locally…':'Checking…';
  const r=isBetaCar()?null:await lbApi('/register',{id:p.id,name,token:p.token});
  $('lbGo').disabled=false;
  if(r&&r.status===409){ err.textContent='That name is taken - try another'; return; }
  if(r&&r.status===400){ err.textContent=(r.j&&r.j.error)||'Invalid name'; return; }
  if(!isBetaCar()&&LB_URL&&!(r&&r.ok)) p.pending=true; // Beta profile creation is local-only; registration waits until a ranked car is used
  prof=p; saveProf(); err.textContent=''; lbShowName(false); $('tLbV').textContent=name; if(!isBetaCar()) lbSubmit(); showTutorial();
}
$('lbGo').addEventListener('click',lbCreate); $('lbIn').addEventListener('keydown',e=>{ e.stopPropagation(); if(e.key==='Enter') lbCreate(); }); $('lbIn').addEventListener('keyup',e=>e.stopPropagation());
// --- leaderboard screen
let lbTab='cash';
function lbWhy(r){        // say what actually went wrong instead of one generic message
  if(!r||r.status===0) return 'Could not reach the leaderboard server ('+((r&&r.err)||'no response')+')';
  if(r.ok&&r.bad) return 'The server answered but it is not the leaderboard worker (redeploy leaderboard-worker.js)';
  if(r.ok) return 'The server answered without leaderboard data';
  const d=r.j&&(r.j.detail||r.j.error); return 'Leaderboard server error '+r.status+(d?': '+d:'')+(r.status===500?' (is the D1 table created and bound as DB?)':'');
}
const lbFmt=(b,v)=>b==='cash'?money(v):b==='score'?Math.floor(v).toLocaleString():(+v).toFixed(1)+' mi';
const lbMine=b=>b==='cash'?stats.earned:b==='score'?stats.best:stats.miles;
async function lbRender(){
  const b=lbTab, rows=$('lbRows'), note=$('lbNote'); document.querySelectorAll('.lbtabs button').forEach(x=>x.classList.toggle('on',x.dataset.b===b));
  $('lbWho').textContent=prof?prof.name+' · '+lbFmt(b,lbMine(b)):'';
  let list=null, r=null;
  if(LB_URL){ rows.innerHTML='<div><span>Loading…</span></div>'; r=await lbApi('/top?board='+b); if(lbTab!==b) return; list=r&&r.ok&&r.j&&r.j.rows; }
  if(!list){ note.textContent=LB_URL?lbWhy(r)+' - showing this device only.':'Online boards are not connected yet - showing this device only.'; list=prof?[{name:prof.name,v:lbMine(b)}]:[]; }
  else note.textContent='Top '+list.length+' · updates after every run';
  rows.innerHTML=list.map((r,i)=>'<div'+(prof&&r.name===prof.name?' class="me"':'')+'><b>'+(i+1)+'</b><span>'+String(r.name).replace(/[<>&]/g,'')+'</span><i>'+lbFmt(b,r.v)+'</i></div>').join('')||'<div><span>No entries yet</span></div>';
}
function openLB(){ if(!prof){ lbShowName(true); return; } $('lb').classList.add('show'); window.__lbModal='lb'; lbRender(); }
function closeLB(){ $('lb').classList.remove('show'); window.__lbModal=undefined; }
$('tLb').addEventListener('click',openLB); $('lbClose').addEventListener('click',closeLB);
document.querySelector('.lbtabs').addEventListener('click',e=>{ const x=e.target.closest('button'); if(x){ lbTab=x.dataset.b; lbRender(); } });
if(prof) $('tLbV').textContent=prof.name; else if(!ADMIN) lbShowName(true);
if(prof&&prof.pending) lbSubmit();

window.__t={setNight:v=>{window.__nightLock=v},setTime:h=>{window.__todLock=h},setRain:v=>{window.__rainLock=v},get tod(){return tod},get rain(){return rainK},setSpeed:k=>{speedTarget=speed=k/3.6},cam:camera,ctl:controls,view:goView,get dist(){return dist},set dist(v){dist=v},wheels,eng,sound:setSound,rg:RG,radio,RADIO,get diff(){return DIFF},get assist(){return brkAssist},get state(){return state},get runDist(){return runDist},set runDist(v){runDist=v},get score(){return score},set score(v){score=v},get px(){return px},set px(v){px=v},get wallet(){return wallet},get biome(){return BW.dom},get inTunnel(){return tunnelActive},goBiome:b=>{ for(let k=1;k<40;k++) if(biomeOf(k)===b){ dist=biomeBase+k*BZ+BP*1.7; return k; } }};
</script>
</body>
</html>

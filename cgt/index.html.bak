<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Russo+One&display=swap">
<title>Carrera GT – Highway Run</title>
<style>
  html,body{margin:0;height:100%;background:#0b0f16;overflow:hidden;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#fff;-webkit-user-select:none;user-select:none}
  canvas{display:block}
  #msg{position:fixed;left:12px;top:10px;font-size:13px;color:#fff;background:rgba(10,14,22,.55);padding:6px 10px;border-radius:6px}
  #hud{position:fixed;right:16px;top:12px;text-align:right;text-shadow:0 1px 6px rgba(0,0,0,.6);pointer-events:none}
  #hud b{font-size:34px;font-weight:600;letter-spacing:-.5px;font-variant-numeric:tabular-nums}
  #hud span{font-size:12px;opacity:.75;margin-left:4px}
  #ui{position:fixed;left:0;right:0;bottom:16px;display:flex;gap:10px;align-items:center;justify-content:center;flex-wrap:wrap;padding:0 12px;pointer-events:none}
  .panel{pointer-events:auto;background:rgba(14,18,28,.58);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:8px 14px;display:flex;align-items:center;gap:10px;font-size:13px}
  /* light switch */
  .switch{position:relative;display:inline-block;width:68px;height:34px;cursor:pointer}
  .switch input{position:absolute;opacity:0;width:0;height:0}
  .track{position:absolute;inset:0;border-radius:34px;background:linear-gradient(#7fb6ee,#4f8fd6);transition:background .5s;box-shadow:inset 0 2px 6px rgba(0,0,0,.35)}
  .thumb{position:absolute;top:3px;left:3px;width:28px;height:28px;border-radius:50%;background:#ffd76a;box-shadow:0 2px 6px rgba(0,0,0,.4),0 0 12px rgba(255,215,106,.7);transition:transform .45s cubic-bezier(.3,1.4,.5,1),background .45s,box-shadow .45s}
  .switch input:checked + .track{background:linear-gradient(#1b2542,#0c1226)}
  .switch input:checked + .track .thumb{transform:translateX(34px);background:#dfe6f5;box-shadow:0 2px 6px rgba(0,0,0,.5),0 0 12px rgba(190,210,255,.6)}
  .switch input:focus-visible + .track{outline:2px solid #fff;outline-offset:2px}
  .lbl{min-width:76px;font-weight:600}
  .lbl small{display:block;font-weight:400;opacity:.65;font-size:11px}
  input[type=range]{width:130px;accent-color:#c9d3e6}
  .seg button{background:none;border:0;color:#fff;font:inherit;padding:2px 8px;border-radius:999px;cursor:pointer;opacity:.7}
  .seg button.on{background:rgba(255,255,255,.18);opacity:1}
  .seg{display:flex;gap:2px}
  #snd{background:none;border:0;color:#fff;font:inherit;cursor:pointer;display:flex;align-items:center;gap:8px;padding:0}
  #snd svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  #snd .w{opacity:0}#snd[aria-pressed=true] .w{opacity:1}#snd[aria-pressed=true] .x{opacity:0}
  #snd:focus-visible{outline:2px solid #fff;outline-offset:4px;border-radius:999px}
  #snd:disabled{opacity:.4;cursor:default}
  #clk{font-size:12px;opacity:.85;margin-top:2px;font-variant-numeric:tabular-nums}
  #gRain{font-style:normal;margin-left:8px;color:#8fc8ff;font-size:11px;font-weight:700;letter-spacing:.06em}
  #hud #kmh,#hud>span,#eng{display:none}            /* the old text speedo is replaced by the gauge */
  #gauge{position:fixed;right:14px;bottom:12px;width:clamp(190px,21vw,270px);aspect-ratio:1;pointer-events:none;z-index:2}
  #gauge svg{width:100%;height:100%;overflow:visible;filter:drop-shadow(0 2px 7px rgba(0,0,0,.65))}
  /* squared, heavy numerals like a racing-game cluster; falls back to a similar system face when offline */
  #gauge text{font-family:'Russo One','Eurostile','Bank Gothic','Arial Black','Helvetica Neue',sans-serif;font-weight:400!important;font-variant-numeric:tabular-nums}
  @media (pointer:coarse){#gauge{bottom:158px;width:clamp(150px,34vw,210px)}}
  #eng{font-size:12px;opacity:.75;font-variant-numeric:tabular-nums;margin-top:2px}

  #game{position:fixed;left:12px;top:48px;background:rgba(10,14,22,.55);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);padding:10px 14px;border-radius:12px;min-width:160px;pointer-events:none}
  #game small{display:block;font-size:10px;letter-spacing:.12em;opacity:.65}
  #game b{font-size:24px;font-weight:600;font-variant-numeric:tabular-nums}
  #gScore{font-size:34px!important}
  #gMult{font-style:normal;margin-left:8px;color:#ffd76a;font-weight:700}
  .g2{display:flex;gap:20px;margin-top:6px}
  #game .best{margin-top:8px;font-size:11px;opacity:.7}
  #pops{position:fixed;left:0;right:0;top:24%;text-align:center;pointer-events:none}
  .pop{font-size:26px;font-weight:700;text-shadow:0 2px 10px rgba(0,0,0,.7);animation:pp 1.4s ease-out forwards;margin-bottom:4px}
  .pop.good{color:#7dffb0}.pop.bad{color:#ff6b5e}
  @keyframes pp{0%{opacity:0;transform:translateY(14px) scale(.9)}15%{opacity:1;transform:none}80%{opacity:1}100%{opacity:0;transform:translateY(-24px)}}
  #flash{position:fixed;inset:0;background:radial-gradient(transparent 40%,#f33);opacity:0;pointer-events:none;transition:opacity .35s}
  #ov{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(6,9,15,.55);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);z-index:5}
  #ov.hide{display:none}
  .card{background:rgba(14,18,28,.85);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:24px 30px;text-align:center;max-width:440px;width:calc(100% - 32px)}
  .card h1{margin:0;font-size:30px;font-weight:600;letter-spacing:-.5px}
  .card p{margin:4px 0 12px;opacity:.65;font-size:13px}
  #ovb{font-size:18px;margin:6px 0 10px}#ovb b{font-size:28px}.nb{color:#ffd76a;font-size:14px;font-weight:600;margin-top:6px}
  .cols{display:flex;gap:24px;justify-content:center;text-align:left;margin:12px 0}
  .cols h3{margin:0 0 4px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.6;font-weight:600}
  .cols ol{margin:0;padding-left:18px;font-size:14px;font-variant-numeric:tabular-nums}.cols li.e{opacity:.4}
  #goBtn{background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:10px 26px;cursor:pointer;margin-top:4px}
  #rad,#nxt,#addm{background:none;border:0;color:#fff;font:inherit;cursor:pointer;display:flex;align-items:center;gap:8px;padding:0}
  #rad svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  #rad .x{opacity:1}#rad[aria-pressed=true] .x{opacity:0}#nxt,#addm{opacity:.75;font-size:15px}
  #rad:focus-visible,#nxt:focus-visible,#addm:focus-visible{outline:2px solid #fff;outline-offset:4px;border-radius:999px}
  #np{font-size:12px;opacity:.8;max-width:260px;margin:2px 0 0 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .how{margin-top:14px;font-size:12px;opacity:.65;line-height:1.6}
  #touch{display:none;position:fixed;left:10px;right:10px;bottom:70px;justify-content:space-between;pointer-events:none}
  #touch div{display:flex;gap:10px}
  #touch button{pointer-events:auto;touch-action:none;width:74px;height:74px;border-radius:50%;border:1px solid rgba(255,255,255,.25);background:rgba(14,18,28,.55);color:#fff;font:600 14px system-ui}
  #touch button.dn{background:rgba(255,255,255,.3)}
  @media (pointer:coarse){#touch{display:flex}}
  #game .ex{margin-top:8px;font-size:12px;color:#7dffb0;font-weight:600}
  #game .ex span{font-variant-numeric:tabular-nums}
  .btns{display:flex;gap:10px;justify-content:center;align-items:center;margin-top:4px}
  #shopBtn,#garageBtn{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:999px;font:inherit;font-weight:600;padding:9px 20px;cursor:pointer}
  #menuBtn{background:none;color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:999px;font:inherit;font-weight:600;padding:9px 20px;cursor:pointer}
  #shopBtn:hover,#garageBtn:hover{background:rgba(255,255,255,.2)}
  #wal{margin:2px 0 6px;font-size:15px;color:#7dffb0;font-weight:600;font-variant-numeric:tabular-nums}
  #wal small{color:#fff;opacity:.6;font-weight:400;font-size:12px;margin-right:6px}
  #shop{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,9,15,.7);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);z-index:8}
  #shop.show{display:flex}
  #shop .card{max-width:480px;position:relative}
  #smile{position:absolute;top:8px;right:10px;width:14px;height:14px;padding:0;border:0;background:none;cursor:pointer;opacity:.5}
  #smile:hover{opacity:1}
  #smile svg{display:block;width:100%;height:100%;shape-rendering:crispEdges}
  #bm{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,9,15,.78);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);z-index:9}
  #bm.show{display:flex}
  #bm .card{max-width:500px;border-color:rgba(255,90,90,.35)}
  .bmi{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}
  .bmi div{border:1px dashed rgba(255,255,255,.25);border-radius:12px;padding:12px 8px;font-size:13px;opacity:.8}
  .bmi b{display:block;color:#ffd76a;font-size:14px;margin-top:3px}
  .bmi small{display:block;opacity:.6;font-size:11px;margin-top:2px}
  .items{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
  .item{border:1px dashed rgba(255,255,255,.25);border-radius:12px;padding:14px 6px;font-size:13px;opacity:.55}
  .item i{display:block;font-style:normal;font-size:26px;margin-bottom:4px}
  .item b{display:block;color:#7dffb0;font-size:12px;margin-top:3px}
  .item.on{opacity:1;border-style:solid;background:rgba(255,255,255,.06);color:#fff;font:inherit;font-size:13px;cursor:pointer}
  .item.on:hover{background:rgba(255,255,255,.14)}
  #carsPanel{display:none;text-align:left;margin:12px auto 0;max-width:560px;max-height:48vh;overflow:auto;padding-right:4px}
  .carshop-row{display:flex;align-items:center;gap:12px;padding:12px;margin:8px 0;border:1px solid rgba(255,255,255,.15);border-radius:12px;background:rgba(255,255,255,.045)}
  .carshop-row .carshop-info{flex:1;min-width:0}.carshop-row strong{display:block;font-size:14px}.carshop-row small{display:block;opacity:.65;font-size:11px;line-height:1.4;margin-top:3px}
  .carshop-row button{border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:8px 13px;font:inherit;font-size:11px;font-weight:700;white-space:nowrap;background:#e8edf7;color:#0b0f16}
  .carshop-row.owned{border-color:rgba(125,255,176,.4)}.carshop-row.owned button{background:rgba(125,255,176,.13);color:#7dffb0;border-color:rgba(125,255,176,.4)}
  .carshop-row.soon{opacity:.42;filter:grayscale(1)}.carshop-row.soon button{background:rgba(255,255,255,.06);color:#aaa;border-color:rgba(255,255,255,.16);cursor:not-allowed}
  #powerPanel{display:none;text-align:left;margin:12px auto 0;max-width:440px}
  #powerPanel .pup{display:flex;align-items:center;gap:12px;padding:10px;border:1px solid rgba(255,255,255,.14);border-radius:12px;margin:8px 0;background:rgba(255,255,255,.04)}
  #powerPanel .pup .pi{font-size:25px;width:34px;text-align:center}
  #powerPanel .pup .pd{flex:1;font-size:13px}.pup small{display:block;opacity:.65;margin-top:3px}
  #powerPanel .pup button,#loadout button{border:1px solid rgba(255,255,255,.25);border-radius:999px;background:rgba(255,255,255,.1);color:#fff;padding:7px 12px;font:inherit;font-size:12px;cursor:pointer}
  #powerPanel .pup button:disabled{opacity:.35;cursor:default}
  #loadout{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(5,8,14,.82);backdrop-filter:blur(9px);z-index:12}
  #loadout.show{display:flex}#loadout .card{max-width:470px;text-align:left}
  #loadout h1{text-align:center}#loadout p{text-align:center}
  .loadrow{display:flex;align-items:center;gap:12px;padding:11px 2px;border-bottom:1px solid rgba(255,255,255,.12)}
  .loadrow .li{font-size:24px;width:34px}.loadrow .ld{flex:1;font-size:13px}.loadrow small{display:block;opacity:.6;margin-top:3px}
  .loadrow input{width:18px;height:18px;accent-color:#7dffb0}
  #loadoutBtns{display:flex;justify-content:center;gap:10px;margin-top:16px}
  #loadoutBtns button{background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;padding:10px 20px;font:inherit;font-weight:600;cursor:pointer}
  #loadoutBtns #loadCancel{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.2)}
  #powerHud{position:fixed;left:50%;top:12px;transform:translateX(-50%);padding:7px 13px;border-radius:999px;background:rgba(10,14,22,.7);border:1px solid rgba(255,255,255,.18);font-size:12px;z-index:3;display:none;pointer-events:none}
  #powerHud.show{display:block}
  #paintPanel{display:none}
  #shop.paint{background:none;-webkit-backdrop-filter:none;backdrop-filter:none;align-items:stretch;justify-content:flex-start;pointer-events:none}
  #shop.paint .card{display:none}
  #shop.paint #paintPanel{display:flex;flex-direction:column;pointer-events:auto;width:min(380px,100%);margin:12px;padding:16px;background:rgba(14,18,28,.9);border:1px solid rgba(255,255,255,.14);border-radius:18px;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
  #ppHead{display:flex;justify-content:space-between;align-items:baseline}#ppHead h2{margin:0;font-size:22px;font-weight:600}
  #ppWal{color:#7dffb0;font-weight:600;font-variant-numeric:tabular-nums;font-size:14px}
  #ppList{flex:1;min-height:0;overflow:auto;margin:6px -6px 10px 0;padding-right:6px}
  #ppList h3{margin:14px 0 6px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.65;font-weight:600}
  .sws{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .sw{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);border-radius:12px;color:#fff;font:inherit;font-size:11px;padding:8px 4px 7px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px}
  .sw .dot{width:34px;height:34px;border-radius:50%;box-shadow:inset 0 -4px 8px rgba(0,0,0,.35),0 0 0 1px rgba(255,255,255,.25)}
  .sw .nm{line-height:1.15;min-height:2.3em;display:flex;align-items:center;text-align:center}
  .sw .pr{opacity:.7;font-variant-numeric:tabular-nums}.sw.own .pr{color:#7dffb0;opacity:1}
  .sw.eq{border-color:#7dffb0}.sw.pv{outline:2px solid #fff;outline-offset:1px}
  #ppFoot{border-top:1px solid rgba(255,255,255,.12);padding-top:10px}
  #ppName{font-weight:600;margin-bottom:6px}#ppNote{font-size:12px;color:#ff9b8f;margin:-2px 0 6px;min-height:0}
  #ppCustom{display:flex;gap:8px;align-items:center;margin-bottom:8px}#ppCustom[hidden]{display:none}
  #ppCustom input[type=color]{width:46px;height:34px;border:0;background:none;padding:0;cursor:pointer}
  #ppCustom select{background:#1a2030;color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:8px;font:inherit;padding:6px 8px}
  #ppBtns{display:flex;gap:8px}
  #ppBuy,#ppBack{border-radius:999px;font:inherit;font-weight:600;padding:9px 20px;cursor:pointer;border:1px solid rgba(255,255,255,.25);background:none;color:#fff}
  #ppBuy{background:#e8edf7;color:#0b0f16;border:0;flex:1}#ppBuy:disabled{opacity:.45;cursor:default}
  #garage{position:fixed;inset:0;display:none;align-items:stretch;justify-content:flex-start;pointer-events:none;z-index:8}
  #garage.show{display:flex}
  #garage .gp{display:flex;flex-direction:column;pointer-events:auto;width:min(380px,100%);margin:12px;padding:16px;background:rgba(14,18,28,.9);border:1px solid rgba(255,255,255,.14);border-radius:18px;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
  #gHead{display:flex;justify-content:space-between;align-items:baseline}#gHead h2{margin:0;font-size:22px;font-weight:600}
  #gCount{color:#7dffb0;font-weight:600;font-size:14px}
  #gList{flex:1;min-height:0;overflow:auto;margin:10px 0 12px;display:flex;flex-direction:column;gap:8px}
  .gcar{display:block;width:100%;text-align:left;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);border-radius:12px;color:#fff;font:inherit;padding:12px 14px;cursor:pointer}
  .gcar:hover{background:rgba(255,255,255,.1)}.gcar.eq{border-color:#7dffb0}
  .gcar .gn{display:block;font-weight:600;font-size:16px}.gcar .gd{display:block;opacity:.7;font-size:13px;margin-top:2px}
  .gcar .gs{display:block;font-size:12px;margin-top:8px;opacity:.7}.gcar.eq .gs{color:#7dffb0;opacity:1;font-weight:600}
  #gBack{border-radius:999px;font:inherit;font-weight:600;padding:9px 20px;cursor:pointer;border:1px solid rgba(255,255,255,.25);background:none;color:#fff}
  @media (max-width:640px){#garage{align-items:flex-end}#garage .gp{width:100%;max-height:50vh;margin:0;border-radius:18px 18px 0 0}}

  .tipjar-card{grid-column:1/-1;display:grid;grid-template-columns:148px 1fr;gap:14px;align-items:center;text-align:left;padding:14px;background:linear-gradient(145deg,rgba(255,215,106,.11),rgba(255,255,255,.025));border:1px solid rgba(255,215,106,.45);border-radius:14px;color:#fff}
  .tipjar-art{width:100%;max-width:148px;filter:drop-shadow(0 5px 8px rgba(0,0,0,.35))}
  .tipjar-copy strong{display:block;font-size:16px;margin-bottom:5px}.tipjar-copy .tipjar-next{display:block;color:#ffdc83;font-weight:700;font-size:14px;margin:4px 0}
  .tipjar-copy small{display:block;opacity:.76;font-size:12px;line-height:1.45}
  .tipjar-track{height:7px;border-radius:99px;background:rgba(255,255,255,.13);overflow:hidden;margin:9px 0 3px}
  .tipjar-track span{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#c88727,#ffe39a);transition:width .35s ease}
  .tipjar-donate{grid-column:1/-1;width:100%;border:1px solid rgba(255,224,150,.7);border-radius:9px;padding:9px 12px;background:linear-gradient(180deg,#f5cf75,#b87b27);color:#271704;font:inherit;font-weight:800;cursor:pointer;text-shadow:0 1px rgba(255,255,255,.25)}
  .tipjar-donate:hover{filter:brightness(1.08)}.tipjar-donate:active{transform:translateY(1px)}
  @media(max-width:420px){.tipjar-card{grid-template-columns:112px 1fr;gap:9px;padding:10px}.tipjar-copy strong{font-size:14px}.tipjar-art{max-width:112px}}
  .bmi .bmbuy{grid-column:1/-1;display:block;text-align:center;background:rgba(255,215,106,.06);border:1px solid rgba(255,215,106,.5);border-radius:12px;padding:12px 8px;color:#fff;font:inherit;font-size:14px;cursor:pointer}
  .bmi .bmbuy:hover{background:rgba(255,215,106,.14)}.bmi .bmbuy.own{border-color:rgba(125,255,176,.5);cursor:default;background:none}
  .bmi .bmbuy.own b{color:#7dffb0}.bmi .bmbuy small{display:block;opacity:.7;font-size:12px;margin-top:3px}
  body.pv #game,body.pv #hud,body.pv #gauge,body.pv #ui,body.pv #touch,body.pv #title,body.pv #ov,body.pv #pops{display:none}
  @media (max-width:640px){#shop.paint{align-items:flex-end}#shop.paint #paintPanel{width:100%;max-height:58vh;margin:0;border-radius:18px 18px 0 0}.sws{grid-template-columns:repeat(4,1fr)}}
  #lbName,#lb{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,9,15,.78);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);z-index:11}
  #lbName.show,#lb.show{display:flex}
  #lbName input{width:100%;box-sizing:border-box;background:#1a2030;color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:10px;font:inherit;font-size:18px;padding:10px 12px;margin:10px 0 6px;text-align:center}
  #lbErr{min-height:1.3em;font-size:12px;color:#ff9b8f}
  .lbtabs{display:flex;gap:6px;justify-content:center;margin:10px 0}
  .lbtabs button{background:none;color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:999px;font:inherit;font-size:12px;font-weight:600;padding:6px 12px;cursor:pointer;opacity:.7}
  .lbtabs button.on{background:#e8edf7;color:#0b0f16;opacity:1}
  #lbRows{text-align:left;font-variant-numeric:tabular-nums;max-height:46vh;overflow:auto;margin:4px 0 10px}
  #lbRows div{display:flex;gap:10px;padding:5px 8px;border-radius:8px;font-size:14px}
  #lbRows div b{width:28px;opacity:.55;font-weight:600}#lbRows div span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#lbRows div i{font-style:normal;color:#7dffb0;font-weight:600}
  #lbRows div.me{background:rgba(125,255,176,.12)}
  #lbNote{font-size:12px;opacity:.65;margin:2px 0 8px}
  #tutorial{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:18px;box-sizing:border-box;background:rgba(5,8,14,.86);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);z-index:14}
  #tutorial.show{display:flex}
  #tutorial .card{max-width:620px;max-height:min(86vh,760px);overflow:auto;text-align:left;padding:24px}
  #tutorial h1{text-align:center;margin-bottom:4px}
  #tutorial .intro{text-align:center;opacity:.72;font-size:13px;margin:0 0 16px}
  #tutorial .tutgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  #tutorial .tutitem{padding:12px;border:1px solid rgba(255,255,255,.13);border-radius:12px;background:rgba(255,255,255,.035)}
  #tutorial .tutitem b{display:block;color:#ffd76a;font-size:13px;margin-bottom:4px}
  #tutorial .tutitem p{font-size:12px;line-height:1.5;opacity:.78;margin:0}
  #tutorial .tutfoot{display:flex;justify-content:center;margin-top:16px}
  #tutorial button{background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;padding:10px 24px;font:inherit;font-weight:700;cursor:pointer}
  @media(max-width:560px){#tutorial .card{padding:18px 16px}#tutorial .tutgrid{grid-template-columns:1fr;gap:8px}}
  #gfx{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,9,15,.7);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);z-index:9}
  #gfx.show{display:flex}#gfx .card{max-width:460px;max-height:92vh;overflow-y:auto}
  .sec{margin:16px 0 6px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;font-weight:700;text-align:left;border-top:1px solid rgba(255,255,255,.12);padding-top:12px}
  #gfx .gchk{text-align:left}
  .gTabs{display:flex;gap:8px;margin:12px 0}.gTabs .on{border-color:#7dffb0;background:rgba(125,255,176,.12)}
  .bmLayout{display:flex;gap:16px;align-items:flex-start}.bmLayout .bmi{flex:1;min-width:0}.scoutBox{width:150px;flex:0 0 150px;text-align:center;position:sticky;top:8px}.scoutImg{width:130px;height:170px;object-fit:contain;animation:scoutSpin 7s linear infinite;transform-style:preserve-3d}.scoutLine{position:relative;background:#fff8dc;color:#171717;border:2px solid #171717;border-radius:13px;padding:11px 12px;font-size:12px;font-weight:700;line-height:1.45;margin-top:17px;min-height:48px;text-align:left;box-shadow:3px 3px 0 rgba(0,0,0,.35);font-family:ui-monospace,monospace}.scoutLine:before{content:"";position:absolute;top:-13px;left:calc(50% - 10px);border-left:10px solid transparent;border-right:10px solid transparent;border-bottom:13px solid #171717}.scoutLine:after{content:"";position:absolute;top:-9px;left:calc(50% - 8px);border-left:8px solid transparent;border-right:8px solid transparent;border-bottom:10px solid #fff8dc}.scoutLine.typing:after{content:"▌";position:static;border:0;display:inline;color:#171717;animation:scoutCursor .65s steps(2) infinite}@keyframes scoutCursor{50%{opacity:0}}@keyframes scoutSpin{from{transform:rotateY(0)}to{transform:rotateY(360deg)}}@media(max-width:600px){.bmLayout{flex-direction:column-reverse}.scoutBox{width:100%;flex-basis:auto;position:static}.scoutImg{height:110px}}
  .sbtn{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:999px;font:inherit;font-size:13px;font-weight:600;padding:8px 16px;cursor:pointer}
  .sbtn:hover:not(:disabled){background:rgba(255,255,255,.2)}.sbtn:disabled{opacity:.35;cursor:default}
  .sbtn.danger{border-color:rgba(255,107,94,.6);color:#ff9b8f}
  #gfx .sbtn{display:block;margin:8px 0 0}
  .rstmsg{font-size:12px;line-height:1.5;text-align:left;margin:10px 0 8px;color:#ffb3a8}
  #rstIn{width:100%;box-sizing:border-box;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.25);border-radius:8px;color:#fff;font:inherit;padding:8px 10px;letter-spacing:.2em}
  .rstrow{display:flex;gap:8px;margin-top:8px}.rstrow .sbtn{margin:0!important}
  #ui .panel:not(#views){display:none}
  #gOpts{display:flex;flex-direction:column;gap:8px;margin:12px 0;text-align:left}
  .gopt{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.18);border-radius:12px;color:#fff;font:inherit;padding:10px 14px;cursor:pointer;text-align:left}
  .gopt b{display:block;font-size:14px}.gopt span{display:block;font-size:12px;opacity:.65;margin-top:2px}
  .gopt.on{border-color:#7dffb0;background:rgba(125,255,176,.1)}
  .gchk{display:block;font-size:13px;margin:6px 0}#gNote{font-size:12px;color:#ffd76a;min-height:16px;margin-bottom:6px}
  #fps{position:fixed;top:6px;right:10px;font:11px/1.2 ui-monospace,monospace;color:#9f9;background:rgba(0,0,0,.55);padding:3px 6px;border-radius:6px;pointer-events:none;display:none;z-index:6}
  #gfxBtn{background:none;border:0;color:#fff;font:inherit;cursor:pointer;padding:0}
  #adm{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,9,15,.75);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);z-index:10}
  #adm.show{display:flex}#adm .card{max-width:380px}
  #admBtn{position:fixed;right:10px;top:34px;z-index:11;background:#b30d0d;color:#fff;border:0;border-radius:999px;font:700 11px system-ui;letter-spacing:.1em;padding:6px 12px;cursor:pointer}#admBtn[hidden]{display:none}
  #admRow{display:flex;gap:8px;justify-content:center;margin:10px 0}
  #admIn{width:130px;background:#1a2030;color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:8px;font:inherit;padding:8px 10px;text-align:right}
  .admb{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:999px;font:inherit;font-size:13px;font-weight:600;padding:7px 14px;cursor:pointer}
  #title{position:fixed;inset:0;z-index:7;background:#d9d4c8 url(title.png) center/cover no-repeat;display:flex;align-items:flex-end}
  #title.hide{display:none}
  #tmenu{display:flex;flex-direction:column;gap:clamp(7px,1.5vh,12px);margin:0 0 7vh 5vw;align-items:flex-start}
  .tb{--sk:-14deg;position:relative;border:0;cursor:pointer;font:italic 800 clamp(15px,2.1vw,26px)/1 'Arial Black','Helvetica Neue',Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;padding:.75em 2.2em .75em 1.4em;min-width:min(15.5em,60vw);text-align:left;
    transform:skewX(var(--sk));color:#fff;background:linear-gradient(180deg,#6c6f74 0%,#3a3c40 48%,#1d1e21 52%,#3b3d41 100%);box-shadow:0 6px 18px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.35);transition:transform .15s,filter .15s}
  .tb>span{display:block;transform:skewX(calc(var(--sk) * -1))}
  .tb::after{content:'';position:absolute;left:0;right:0;bottom:0;height:.2em;background:linear-gradient(90deg,#b30d0d,#ff2a2a 60%,#b30d0d)}
  .tb.alt{color:#2b2c2f;background:linear-gradient(180deg,#f3efe6,#cfcabf);box-shadow:0 6px 18px rgba(0,0,0,.25),inset 0 0 0 1px rgba(0,0,0,.25)}
  .tb:hover,.tb:focus-visible{transform:skewX(var(--sk)) translateX(10px);filter:brightness(1.12);outline:none}
  .tb small{display:inline-block;margin-left:.8em;font-size:.6em;color:#ff4a4a;letter-spacing:.04em}
  .tb.alt small{color:#b30d0d}
  #cine{position:fixed;inset:0;pointer-events:none;z-index:4;opacity:0;transition:opacity .6s;background:radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.55))}
  #cine.on{opacity:1}
  #cine .bar{position:absolute;left:0;right:0;height:0;background:#000;transition:height .9s cubic-bezier(.3,.7,.3,1)}
  #cine.on .bar{height:12vh}
  #cine .top{top:0}#cine .bot{bottom:0}
  #cine .cap{position:absolute;left:0;right:0;bottom:15vh;text-align:center;font-weight:700;letter-spacing:.3em;font-size:clamp(14px,2.4vw,22px);text-transform:uppercase;opacity:0;transform:translateY(10px);transition:opacity .8s,transform .8s;text-shadow:0 2px 12px rgba(0,0,0,.8)}
  #cine .cap.in{opacity:1;transform:none}
  #cine .cap em{display:block;font-style:normal;letter-spacing:.05em;font-size:1.9em;color:#7dffb0;margin-top:4px;font-variant-numeric:tabular-nums}
</style>
</head>
<body>
<div id="msg">Loading model…</div>
<div id="hud"><b id="kmh">0</b><span>mph</span><div id="eng">G3 · 900 rpm</div><div id="clk"></div><div id="np"></div></div>
<div id="gauge"><svg viewBox="0 0 300 300" aria-label="Speed and revs">
  <circle cx="150" cy="150" r="146" fill="rgba(8,11,18,.38)"/>
  <g id="gTicks"></g>
  <path id="gGrey" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="10"/>
  <path id="gRed" fill="none" stroke="#f2481c" stroke-width="10"/>
  <path id="gWhite" fill="none" stroke="#fff" stroke-width="10"/>
  <line id="gMark" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/>
  <text x="150" y="118" text-anchor="middle" font-size="12.5" letter-spacing="4" fill="rgba(255,255,255,.7)">MPH</text>
  <rect x="80" y="139" width="34" height="40" rx="4.5" fill="#f2df2a"/>
  <text id="gGear" x="97" y="170" text-anchor="middle" font-size="32" fill="#16171a">1</text>
  <text id="gSpd" x="217" y="178" text-anchor="end" font-size="53" fill="#fff">0</text>
</svg></div>
<div id="game"><small>SCORE</small><b id="gScore">0</b><i id="gMult">x1</i><em id="gRain"></em>
  <div class="g2"><div><small>MILES</small><b id="gMiles">0.00</b></div><div><small>TIME</small><b id="gTime">3:00</b></div></div>
  <div class="best">Clean streak <span id="nextB">0</span></div>
  <div class="ex">EXIT in <span id="gExit">10.00</span> mi · cash out <span id="gCash">$0.00</span></div>
  <div class="best">Best <span id="bestP">0</span> pts · <span id="bestM">0.0</span> mi</div></div>
<div id="title"><div id="tmenu"><button class="tb" id="tStart"><span>Start run</span></button><button class="tb alt" id="tShop"><span>Shop<small id="tWal">$0.00</small></span></button><button class="tb alt" id="tGarage"><span>Garage</span></button><button class="tb alt" id="tGfx"><span>Settings<small id="tGfxV"></small></span></button><button class="tb alt" id="tLb"><span>Leaderboards<small id="tLbV"></small></span></button><button class="tb alt" id="tHelp"><span>Scores &amp; help</span></button></div></div>
<div id="cine"><div class="bar top"></div><div class="bar bot"></div><div class="cap" id="cineCap"></div></div>
<button id="admBtn" hidden>ADMIN</button>
<div id="adm"><div class="card"><h1>Admin</h1><p>Edit wallet · nothing is saved while admin mode is on</p><div id="admW" class="nb"></div>
  <div id="admRow"><span style="align-self:center">$</span><input id="admIn" type="number" min="0" step="0.01" inputmode="decimal"><button class="admb" id="admSet">Set</button></div>
  <div id="admRow2" style="display:flex;gap:8px;justify-content:center;margin-bottom:12px"><button class="admb" data-add="1000">+$10</button><button class="admb" data-add="10000">+$100</button><button class="admb" data-add="100000">+$1,000</button><button class="admb" data-add="-1">$0</button></div>
  <button id="admClose" style="background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:9px 24px;cursor:pointer">Close</button></div></div>
<div id="fps"></div>
<div id="lbName"><div class="card"><h1>Create your profile</h1><p>Pick a username for your save. It appears on the leaderboards.</p>
  <input id="lbIn" maxlength="16" autocomplete="off" spellcheck="false" placeholder="username"><div id="lbErr"></div>
  <button id="lbGo" style="background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:10px 26px;cursor:pointer">Create save</button>
  <div class="how">3-16 letters, numbers or _ · your total cash, best score and miles are shared with the boards</div></div></div>
<div id="tutorial" role="dialog" aria-modal="true" aria-labelledby="tutorialTitle"><div class="card"><h1 id="tutorialTitle">Highway Run · Quick Start</h1><p class="intro">Your profile is ready. Here's what you need to know before your first run.</p>
  <div class="tutgrid">
    <div class="tutitem"><b>1 · Speed = points</b><p>Drive fast and pass through the open gaps in traffic. Your speed increases the points earned from successful passes. Keep a clean streak going to build your multiplier.</p></div>
    <div class="tutitem"><b>2 · Miles &amp; distance</b><p>The MILES counter shows how far you've travelled during this run. Your run starts with 3:00 on the clock. Earn time bonuses by reaching each 100,000-point milestone.</p></div>
    <div class="tutitem"><b>3 · Exits &amp; cash</b><p>An exit appears every 10 miles. Move to the far-right exit lane and take the ramp to end your run early and bank your points as cash. Every 100,000 banked points is worth $5.</p></div>
    <div class="tutitem"><b>4 · The objective</b><p>Build the highest score you can, travel as far as possible, and choose when to cash out. If the timer reaches zero or you press Esc, the run ends and unbanked points are forfeited.</p></div>
    <div class="tutitem"><b>5 · Traffic &amp; crashes</b><p>Thread through gaps and weave between lanes to build WEAVE combos. Hitting traffic breaks your streak and costs time; hitting the shoulder or barrier also slows you down. Brake when all lanes are blocked.</p></div>
    <div class="tutitem"><b>6 · Controls</b><p><b>W / ↑</b> accelerate · <b>S / ↓</b> brake · <b>A / D</b> or <b>← / →</b> steer · <b>Space</b> handbrake · <b>E</b> activate equipped Nitrous or Ghost Chassis · <b>C</b> change camera · <b>Esc</b> abandon the run.</p></div>
    <div class="tutitem"><b>7 · Power-ups</b><p>Buy single-use power-ups in the Shop and equip them before a run. Insurance protects against the first crash's time and point penalties; Nitrous gives a 5-second boost; x2 Points doubles point multipliers; Ghost Chassis gives 30 seconds of invulnerability. Ghost Chassis and Nitrous cannot be equipped together. The RPG Power-up, unlocked from Scout’s surprise, replaces all other power-ups and fires a traffic-clearing rocket with a 90-second reload.</p></div>
    <div class="tutitem"><b>8 · Your car matters</b><p>There will be many cars with different driving styles and maybe even bonuses</p></div>
  </div>
  <div class="tutfoot"><button id="tutorialDone" type="button">Got it — let's drive</button></div>
</div></div>
<div id="lb"><div class="card"><h1>Leaderboards</h1><div id="lbWho" class="nb" style="font-size:13px"></div>
  <div class="lbtabs"><button data-b="cash" class="on">Cash earned</button><button data-b="score">Best score</button><button data-b="miles">Miles driven</button></div>
  <div id="lbRows"></div><div id="lbNote"></div>
  <button id="lbClose" style="background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:9px 24px;cursor:pointer">Back</button></div></div>
<div id="gfx"><div class="card"><h1>Settings</h1><p>Set everything here, before the run. Camera is the only thing you change while driving.</p>
  <div class="gTabs"><button type="button" class="sbtn on" id="gBasicTab">Basic</button><button type="button" class="sbtn" id="gAdvancedTab">Advanced</button></div><div id="gBasic"><div class="sec">Graphics</div><div id="gOpts"></div></div><div id="gAdvanced" hidden><div class="sec">Advanced graphics</div><label class="gchk"><input type="checkbox" id="advShadows"> Real-time shadows</label><label class="gchk"><input type="checkbox" id="advLights"> Car lights</label><label class="gchk"><input type="checkbox" id="advRim"> Rim lighting</label><label class="gchk">Render resolution <input type="range" id="advScale" min="50" max="100" step="5" value="100"><span id="advScaleVal">100%</span></label><label class="gchk">Tree density <input type="range" id="advTrees" min="0" max="200" step="10" value="170"><span id="advTreesVal">170</span></label><p class="how">Advanced overrides are saved separately from your graphics preset.</p></div>
  <label class="gchk"><input type="checkbox" id="gFps"> Show FPS</label><div id="gNote"></div>
  <div class="sec">Audio</div>
  <label class="gchk"><input type="checkbox" id="sEng"> Engine sound</label>
  <label class="gchk"><input type="checkbox" id="sRad"> Radio during runs</label>
  <button type="button" class="sbtn" id="sAdd">+ Add your own songs</button>
  <div class="sec">Save data</div>
  <button type="button" class="sbtn danger" id="rstOpen">Reset save data…</button>
  <div id="rstBox" hidden><div class="rstmsg">This erases your cash, paints, scores, stats and your username on this device, then restarts the game. Settings are kept. Your old leaderboard entry stays on the server. Type <b>RESET</b> to confirm.</div>
    <input id="rstIn" autocomplete="off" spellcheck="false" placeholder="RESET"><div class="rstrow"><button type="button" class="sbtn" id="rstNo">Cancel</button><button type="button" class="sbtn danger" id="rstGo" disabled>Erase everything</button></div></div>
  <button id="gClose" style="background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:9px 24px;cursor:pointer;margin-top:12px">Back</button>
  <div class="how">* Anti-aliasing is chosen at launch, so it changes next time you open the game.<br>Resolution also adapts automatically if the frame rate drops.</div></div></div>
<div id="bm"><div class="card"><h1>Black Market</h1><p>Cash only · stock is limited</p><div id="wal3" class="nb" style="font-size:18px"></div>
  <div class="bmLayout"><div class="bmi" id="bmItems"></div><aside class="scoutBox"><img src="scout.png" alt="Scout" class="scoutImg"><div id="scoutLine" class="scoutLine"></div></aside></div>
  <button id="bmClose" type="button" style="background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:9px 24px;cursor:pointer">Back</button></div></div>
<div id="shop"><div class="card"><button id="smile" type="button" aria-label="secret"><svg viewBox="0 0 8 8"><path fill="#ffd23f" d="M2 0h4v1H2zM1 1h6v1H1zM0 2h8v4H0zM1 6h6v1H1zM2 7h4v1H2z"/><path fill="#1a1a1a" d="M2 2h1v2H2zM5 2h1v2H5zM1 5h1v1H1zM6 5h1v1H6zM2 6h4v1H2z"/></svg></button><h1>Shop</h1><p>Spend your cash on upgrades</p><div id="wal2" class="nb" style="font-size:18px"></div>
  <div class="items"><button class="item on" id="itemPaint" type="button"><i>&#127912;</i>Paint<b id="paintSub">Seal Grey</b></button><button class="item on" id="itemPower" type="button"><i>⚡</i>Power Ups<b>Single-use items</b></button><button class="item on" id="itemCars" type="button"><i>🚘</i>Cars<b>Buy cars</b></button></div><div id="powerPanel"><div id="powerWallet" class="nb"></div><div id="powerRows"></div></div><div id="carsPanel"><div id="carShopRows"></div></div>
  <button id="shopClose" style="background:#e8edf7;color:#0b0f16;border:0;border-radius:999px;font:inherit;font-weight:600;padding:9px 24px;cursor:pointer">Back</button></div>
  <div id="paintPanel"><div id="ppHead"><h2>Paint</h2><div id="ppWal"></div></div><div id="ppList"></div>
    <div id="ppFoot"><div id="ppName"></div><div id="ppNote"></div>
      <div id="ppCustom" hidden><input type="color" id="ppCol" aria-label="Custom colour"><select id="ppFin" aria-label="Finish"><option value="metal">Metallic</option><option value="gloss">Gloss</option><option value="matte">Matte</option><option value="chrome">Mirror</option></select><div id="dualControls" hidden style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><label>Other side <input type="color" id="ppCol2" aria-label="Other side colour"></label><select id="ppFin2" aria-label="Other side finish"><option value="metal">Metallic</option><option value="gloss">Gloss</option><option value="matte">Matte</option><option value="chrome">Mirror</option></select></div></div>
      <div id="ppBtns"><button id="ppBuy" type="button">Buy</button><button id="ppBack" type="button">Back</button></div></div></div></div>
<div id="loadout"><div class="card"><h1>Run Loadout</h1><p>Equip any power-ups you own. Each equipped item is consumed when the run starts.</p><div id="loadRows"></div><div id="loadoutBtns"><button id="loadCancel" type="button">Back</button><button id="loadStart" type="button">Start run</button></div><div class="how" style="text-align:center">Press E during a run to activate Nitrous Oxide or Ghost Chassis. They cannot be equipped together. Insurance and x2 Points activate automatically.</div></div></div>
<div id="powerHud"></div>
<div id="garage"><div class="gp"><div id="gHead"><h2>Garage</h2><div id="gCount"></div></div><div id="gList"></div><div><button id="gBack" type="button">Back</button></div></div></div>
<div id="pops"></div><div id="flash"></div>
<div id="touch"><div><button data-k="l">◀</button><button data-k="r">▶</button></div><div><button data-k="b">BRAKE</button><button data-k="g">GAS</button></div></div>
<div id="ov" class="hide"><div class="card"><h1 id="ovt">Carrera GT</h1><p>Highway Run · 3:00</p><div id="ovb"></div>
  <div class="cols"><div><h3>Top points</h3><ol id="hsP"></ol></div><div><h3>Top miles</h3><ol id="hsM"></ol></div></div>
  <div id="wal"><small>WALLET</small><span id="walV">$0.00</span></div>
  <div class="btns"><button id="goBtn">Start run</button><button id="shopBtn">Shop</button><button id="garageBtn">Garage</button><button id="menuBtn">Main menu</button></div>
  <div class="how">W/↑ gas · S/↓ brake · A D / ←→ steer · Space handbrake<br>Speed earns points · thread the open gaps in each row of traffic<br>Zig-zag between gaps to build WEAVE combos · crashes and shoulders cost you<br>Curves push you outward: counter-steer · now and then traffic blocks every lane: brake and let it string out · every 100,000 pts = +10 s<br>Exits every 10 miles: take one from the right lane to end the run early and bank your points (100,000 pts = $5). Time-out or Esc forfeits them<br>E activate equipped power-up (RPG fires rocket) · C camera · M engine · R radio · N next · Esc ends run</div></div></div>
<div id="ui">
  <div class="panel"><button id="snd" aria-pressed="false" title="Engine sound (M)"><svg viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path class="w" d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/><path class="x" d="M17 9l5 6M22 9l-5 6"/></svg><span id="sndl">Engine off</span></button></div>
  <div class="panel"><button id="rad" aria-pressed="false" title="Radio (R)"><svg viewBox="0 0 24 24"><path d="M9 18V6l10-2v12"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="16" r="2"/><path class="x" d="M3 3l18 18"/></svg><span id="radl">Radio off</span></button><button id="nxt" title="Next track (N)">⏭</button><button id="addm" title="Add your own songs">＋</button><input type="file" id="addf" accept="audio/*" multiple hidden></div>
  <div class="panel"><button id="gfxBtn" title="Graphics mode (G)">Gfx</button></div>
  <div class="panel seg" id="views">
    <button data-v="chase" class="on">Chase</button><button data-v="side">Side</button><button data-v="front">Front</button>
  </div>
</div>

<!--
  Files in one folder:
    highway.html, seal_grey_metallic.png, POR_CarreraGT_03_lite.glb
  Local test:  python3 -m http.server 8000  ->  http://localhost:8000/highway.html
-->

<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/loaders/GLTFLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/controls/OrbitControls.js"></script>
<script type="text/plain" id="v10-worklet">
/* V10 engine: even-fire (5 firings / crank rev) combustion pulses -> two exhaust-bank pipe resonators
   (quarter-wave, negative feedback, damped) + pulsing intake noise + road/wind noise. */
class V10Proc extends AudioWorkletProcessor{
  static get parameterDescriptors(){
    return [['rpm',900],['thr',0],['gain',1],['wind',0]].map(([name,defaultValue])=>({name,defaultValue,automationRate:'k-rate'}));
  }
  constructor(){
    super();
    this.fire=0; this.cyl=0; this.pe=[0,0]; this.burst=0;
    this.cylAmp=Array.from({length:10},()=>.88+Math.random()*.24);     // cylinder-to-cylinder imbalance = the "lope"
    this.N=Math.ceil(sampleRate*.02); this.buf=[new Float32Array(this.N),new Float32Array(this.N)];
    this.wi=0; this.D=[Math.round(sampleRate*.0047),Math.round(sampleRate*.0053)]; this.lp=[0,0];
    this.rpm=900; this.thr=0; this.w=0; this.n1=0; this.n2=0; this.w1=0; this.w2=0; this.dcx=0; this.dcy=0;
    this.port.onmessage=e=>{ if(e.data&&e.data.pop) this.burst=e.data.pop*2; };
  }
  process(_,outs,p){
    const out=outs[0][0], n=out.length, sr=sampleRate, N=this.N;
    const rT=p.rpm[0], tT=p.thr[0], gain=p.gain[0], wT=p.wind[0];
    const kr=1-Math.exp(-1/(sr*.025)), kt=1-Math.exp(-1/(sr*.04)), bdec=Math.exp(-1/(sr*.012));
    let wi=this.wi;
    for(let i=0;i<n;i++){
      this.rpm+=(rT-this.rpm)*kr; this.thr+=(tT-this.thr)*kt; this.w+=(wT-this.w)*kt*.2;
      const f=this.rpm/60, rn=Math.min(1,Math.max(0,(this.rpm-900)/7500));
      this.fire+=5*f/sr;
      if(this.fire>=1){
        this.fire-=1; this.cyl=(this.cyl+1)%10;
        this.pe[this.cyl&1]=this.cylAmp[this.cyl]*(.5+.7*this.thr)*(.94+Math.random()*.12);
      }
      const dec=Math.exp(-1/(sr*Math.min(.003,Math.max(.00035,.3/(5*f+1)))));
      const bn=(Math.random()*2-1)*this.burst; this.burst*=bdec;
      let y=0;
      for(let b=0;b<2;b++){
        const buf=this.buf[b]; let r=wi-this.D[b]; if(r<0) r+=N;
        this.lp[b]+=.45*(buf[r]-this.lp[b]);
        const v=this.pe[b]+bn*.5-.62*this.lp[b];
        buf[wi]=v; y+=v; this.pe[b]*=dec;
      }
      if(++wi>=N) wi=0;
      const wn=Math.random()*2-1;
      this.n1+=.25*(wn-this.n1); this.n2+=.25*(this.n1-this.n2);
      const intake=this.n2*3*this.thr*(.1+.9*rn*rn)*(.65+.35*Math.sin(6.2832*this.fire));
      this.w1+=.08*(wn-this.w1); this.w2+=.08*(this.w1-this.w2);
      const wind=this.w2*2.5*Math.pow(Math.min(1.3,this.w/90),1.7);
      const x=Math.tanh(1.2*(y*.5+intake)*gain)*.55;
      const yo=x-this.dcx+.995*this.dcy; this.dcx=x; this.dcy=yo;
      out[i]=yo+wind*.5;
    }
    this.wi=wi;
    return true;
  }
}
registerProcessor('v10-engine',V10Proc);
</script>
<script>
const GLB_URL = 'POR_CarreraGT_03_lite.glb';
const TEX_URL = 'seal_grey_metallic.png';

/* admin mode (nothing is written to storage while it is on): hold C + G + T together within the first 15 s after launch. Session only; not saved. */
let ADMIN=false, _bootDone=false; const _bk=new Set(), _bt0=performance.now();
function _bootEnd(){ _bootDone=true; removeEventListener('keydown',_bootKey); removeEventListener('keyup',_bootUp); }
function _bootKey(e){
  if(performance.now()-_bt0>15000){ _bootEnd(); return; }
  _bk.add(e.code);
  if(_bk.has('KeyC')&&_bk.has('KeyG')&&_bk.has('KeyT')){ ADMIN=true; _bootEnd(); $('admBtn').hidden=false; $('admBtn').textContent='ADMIN · NOT SAVING'; }
}
function _bootUp(e){ _bk.delete(e.code); }
/* only solid parts cast shadows: the light beams, glow quads and see-through discs would otherwise leave dark cone/quad shapes on the road */
const castsShadow=m=>!!(m.isMesh&&m.material&&!m.material.transparent&&!m.material.userData.glow&&!(typeof carLights!=='undefined'&&carLights.beams.includes(m)));
const store={set(k,v){ if(ADMIN) return; try{ localStorage.setItem(k,v); }catch(e){} }};   // all saves go through here
const bootCombo=()=>!_bootDone&&_bk.size>=2;      // C/G are game keys; ignore them while the combo is being held
addEventListener('keydown',_bootKey); addEventListener('keyup',_bootUp);

/* ------------------------------------------------------------------ renderer / scene */
/* graphics modes: Low (school laptops / integrated GPUs), Medium (balanced), High (soft shadows + rim lighting). */
const GFX_KEY='cgt_gfx';
const QS={
  low:   {label:'Low',   aa:false,pr:1,  scale:.75,minScale:.5, shadow:false,coat:false,flake:false,lights:false,rim:false,trees:60, aniso:1, rainFx:false, drops:false},
  medium:{label:'Medium',aa:true, pr:1.5,scale:1,  minScale:.6, shadow:false,coat:true, flake:true, lights:true, rim:false,trees:170,aniso:4, rainFx:true, drops:false},
  high:  {label:'High',  aa:true, pr:2,  scale:1,  minScale:.8, shadow:true, coat:true, flake:true, lights:true, rim:true, trees:170,aniso:16, rainFx:true, drops:true}};
function detectGfx(){
  let gpu=''; try{ const c=document.createElement('canvas'), g=c.getContext('webgl')||c.getContext('experimental-webgl'), x=g&&g.getExtension('WEBGL_debug_renderer_info');
    gpu=x?String(g.getParameter(x.UNMASKED_RENDERER_WEBGL)):''; const l=g&&g.getExtension('WEBGL_lose_context'); if(l) l.loseContext(); }catch(e){}
  const cores=navigator.hardwareConcurrency||4, mem=navigator.deviceMemory||8;
  if(cores<=4||mem<=4||/SwiftShader|llvmpipe|Mali|PowerVR|Adreno|Microsoft Basic|Intel.*(HD|UHD) Graphics/i.test(gpu)) return 'low';
  return (cores>=8&&/NVIDIA|GeForce|RTX|GTX|Radeon (RX|Pro)|Apple M\d|Arc/i.test(gpu))?'high':'medium';
}
// High is the out-of-box default. Preserve explicit Low/Medium/High choices;
// migrate older saved Auto preferences to High so capable devices aren't silently downgraded.
let gfxPref='high'; try{ const v=localStorage.getItem(GFX_KEY); if(v==='low'||v==='medium'||v==='high') gfxPref=v; }catch(e){}
const gfxAuto=detectGfx(); let gfxMode=gfxPref==='auto'?gfxAuto:gfxPref, Q=QS[gfxMode], curScale=Q.scale, treeN=Q.trees;
// Touch-first devices keep the selected quality's full render scale. Desktop still
// retains adaptive resolution as a safety valve for slower hardware.
const MOBILE_GRAPHICS=/Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent)||!!(navigator.userAgentData&&navigator.userAgentData.mobile);
const AA_AT_LAUNCH=Q.aa;
const renderer = new THREE.WebGLRenderer({antialias:AA_AT_LAUNCH,stencil:false,powerPreference:'high-performance'});
const setRes=()=>{ renderer.setPixelRatio(Math.min(devicePixelRatio,Q.pr)*curScale); renderer.setSize(innerWidth,innerHeight); };
setRes();
const ANISO=Math.min(renderer.capabilities.getMaxAnisotropy(),Q.aniso);
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.0;
document.body.appendChild(renderer.domElement);

const scene  = new THREE.Scene();
scene.fog = new THREE.Fog(0xffffff, 60, 450);
const camera = new THREE.PerspectiveCamera(38, innerWidth/innerHeight, 0.1, 2500);
const controls = {target:new THREE.Vector3(),update(){}};

const VIEWS = {
  chase: {pos:[-3.9,1.55,-6.6], tgt:[0,0.62,0.9]},
  side:  {pos:[-6.2,0.85,0.9],  tgt:[0,0.55,0.2]},
  front: {pos:[3.4,1.1,7.4],    tgt:[0,0.6,0.4]}
};
camera.position.set(...VIEWS.chase.pos); controls.target.set(...VIEWS.chase.tgt);

const gauss = (x,a,b)=>Math.min(1,Math.max(0,(x-a)/(b-a)));
const smooth = (a,b,x)=>{const t=gauss(x,a,b);return t*t*(3-2*t)};
const lerpHex = (a,b,t)=>new THREE.Color(a).lerp(new THREE.Color(b),t);

/* ------------------------------------------------------------------ studio environment (car reflections) */
(function buildEnv(){
  const env = new THREE.Scene();
  const g = new THREE.SphereGeometry(50, 32, 16);
  const pos = g.attributes.position, cols = [];
  const sky = new THREE.Color(0x61759c), hor = new THREE.Color(0xb9c2cf), gnd = new THREE.Color(0x1a1c20), c = new THREE.Color();
  for (let i=0;i<pos.count;i++){
    const t = pos.getY(i)/50;
    if (t>0) c.copy(hor).lerp(sky, Math.min(1,t*1.4)); else c.copy(hor).lerp(gnd, Math.min(1,-t*2.2));
    cols.push(c.r,c.g,c.b);
  }
  g.setAttribute('color', new THREE.Float32BufferAttribute(cols,3));
  env.add(new THREE.Mesh(g, new THREE.MeshBasicMaterial({vertexColors:true, side:THREE.BackSide})));
  const box = (w,h,x,y,z,i)=>{ const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h), new THREE.MeshBasicMaterial({color:new THREE.Color(i,i,i), side:THREE.DoubleSide})); m.position.set(x,y,z); m.lookAt(0,0,0); env.add(m); };
  box(26,9, 0,30,4, 4.0); box(3,24,-34,8,-6, 3.4); box(3,24, 34,8,6, 3.4); box(18,2.2, 0,12,-38, 2.6); box(10,3, 0,5,40, 1.6);   // overhead softbox, long side strips, low front/rear strips
  scene.environment = new THREE.PMREMGenerator(renderer).fromScene(env, 0.02).texture;
})();

const hemi = new THREE.HemisphereLight(0xffffff, 0x777788, 0.3); scene.add(hemi);
const sun  = new THREE.DirectionalLight(0xffffff, 0.6); sun.position.set(-4,8,6); scene.add(sun); scene.add(sun.target);
const sunO = new THREE.Vector3(-4,8,6);
{ sun.shadow.mapSize.set(2048,2048); const c=sun.shadow.camera; c.left=-14; c.right=14; c.top=30; c.bottom=-12; c.near=1; c.far=90; c.updateProjectionMatrix();
  sun.shadow.bias=-.0005; sun.shadow.normalBias=.03; }
const rimL = new THREE.DirectionalLight(0xbcd0ff,0); rimL.position.set(6,6,-9); scene.add(rimL);   // High mode: edge highlights on the car

/* ------------------------------------------------------------------ helpers: canvas textures */
function canvasTex(w,h,draw,{repeat=false,srgb=true}={}){
  const c=document.createElement('canvas'); c.width=w; c.height=h; draw(c.getContext('2d'),w,h);
  const t=new THREE.CanvasTexture(c);
  if(srgb) t.encoding=THREE.sRGBEncoding;
  if(repeat) t.wrapS=t.wrapT=THREE.RepeatWrapping;
  t.anisotropy=ANISO;
  return t;
}
function noiseFill(g,w,h,amp){
  const id=g.getImageData(0,0,w,h),d=id.data;
  for(let i=0;i<d.length;i+=4){const n=(Math.random()-.5)*amp;d[i]+=n;d[i+1]+=n;d[i+2]+=n}
  g.putImageData(id,0,0);
}
/* Light glows: camera-facing quads with a tiny self-contained shader (analytic falloff, no texture, no tone mapping, no fog,
   NaN-safe). Replaces THREE.Sprite, which blew out to full white on some desktop GPUs at night. The sprite-like API is kept:
   .scale = size in metres, .material.opacity = brightness. The road-bend table is wired up at the bottom of the file. */
const GLOW_MATS=[], glowGeo=new THREE.PlaneGeometry(1,1);
function makeGlow(color){
  const u={uCol:{value:new THREE.Color(color)},uOpacity:{value:0},uOff:{value:new Float32Array(31)},uOffY:{value:new Float32Array(31)}};
  const m=new THREE.ShaderMaterial({uniforms:u,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,fog:false,
    vertexShader:`uniform float uOff[31]; uniform float uOffY[31]; varying vec2 vUv;
float bendX(float z){ float t=clamp((z+48.)/16.,0.,29.999); int i=int(t); return mix(uOff[i],uOff[i+1],t-float(i)); }
float bendY(float z){ float t=clamp((z+48.)/16.,0.,29.999); int i=int(t); return mix(uOffY[i],uOffY[i+1],t-float(i)); }
void main(){ vUv=position.xy+.5; vec4 w=modelMatrix*vec4(0.,0.,0.,1.); w.x+=bendX(w.z); w.y+=bendY(w.z); vec4 mv=viewMatrix*w;
  mv.xy+=position.xy*vec2(length(modelMatrix[0].xyz),length(modelMatrix[1].xyz)); gl_Position=projectionMatrix*mv; }`,
    fragmentShader:`uniform vec3 uCol; uniform float uOpacity; varying vec2 vUv;
void main(){ float r=length(vUv-.5)*2.;
  float a=r<.18?mix(1.,.55,r/.18):r<.5?mix(.55,.12,(r-.18)/.32):mix(.12,0.,clamp((r-.5)/.5,0.,1.));
  a*=uOpacity; if(!(a>.002)||r>=1.) discard; gl_FragColor=vec4(uCol,clamp(a,0.,1.)); }`});
  m.userData.glow=true;
  Object.defineProperty(m,'opacity',{get(){return u.uOpacity.value},set(v){u.uOpacity.value=(v>0&&isFinite(v))?Math.min(v,1):0},configurable:true});
  GLOW_MATS.push(m);
  const mesh=new THREE.Mesh(glowGeo,m); mesh.frustumCulled=false; return mesh;
}
const glowTex = canvasTex(128,128,(g,w,h)=>{
  const r=g.createRadialGradient(64,64,0,64,64,64);
  r.addColorStop(0,'rgba(255,255,255,1)');r.addColorStop(.18,'rgba(255,255,255,.55)');r.addColorStop(.5,'rgba(255,255,255,.12)');r.addColorStop(1,'rgba(255,255,255,0)');
  g.fillStyle=r;g.fillRect(0,0,w,h);
});
const poolTex = canvasTex(256,256,(g,w,h)=>{
  const r=g.createRadialGradient(128,128,0,128,128,128);
  r.addColorStop(0,'rgba(255,214,150,.95)');r.addColorStop(.35,'rgba(255,190,110,.4)');r.addColorStop(1,'rgba(255,170,90,0)');
  g.fillStyle=r;g.fillRect(0,0,w,h);
});

/* road texture: width in metres, tile length in metres, lines = [{x, color, dash}] (x = metres from road centre) */
function roadTexture(widthM, tileM, lines){
  const W=1024,H=1024, pxm=W/widthM, pym=H/tileM;
  return canvasTex(W,H,(g)=>{
    g.fillStyle='#3b3d42'; g.fillRect(0,0,W,H);
    for(let i=0;i<260;i++){            // soft blotches, wrapped vertically so the tile repeats seamlessly
      const x=Math.random()*W,y=Math.random()*H,r=20+Math.random()*90,v=Math.random()<.5?52:70;
      for(const oy of [-H,0,H]){const gr=g.createRadialGradient(x,y+oy,0,x,y+oy,r);gr.addColorStop(0,`rgba(${v},${v+1},${v+4},.16)`);gr.addColorStop(1,'rgba(0,0,0,0)');g.fillStyle=gr;g.fillRect(x-r,y+oy-r,r*2,r*2)}
    }
    noiseFill(g,W,H,40);
    for(const l of lines){
      const cx=(l.x+widthM/2)*pxm, lw=(l.w||0.16)*pxm;
      g.fillStyle=l.color;
      if(l.dash){ g.fillRect(cx-lw/2, 0, lw, l.dash*pym); }
      else g.fillRect(cx-lw/2,0,lw,H);
    }
  },{repeat:true});
}

/* ------------------------------------------------------------------ sky */
const skyU = {uNight:{value:0}, uSunDir:{value:new THREE.Vector3(-.5,.42,.75)}, uMoonDir:{value:new THREE.Vector3(.45,.5,.7)},
  uZen:{value:new THREE.Color(.30,.52,.84)}, uHor:{value:new THREE.Color(.80,.87,.95)}, uSunCol:{value:new THREE.Color(1,.88,.65)}, uGlow:{value:1}, uWarm:{value:0}};
const sky = new THREE.Mesh(new THREE.SphereGeometry(1000,32,16), new THREE.ShaderMaterial({
  uniforms:skyU, side:THREE.BackSide, depthWrite:false, fog:false,
  vertexShader:`varying vec3 vDir; void main(){ vDir=normalize(position); gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.); }`,
  fragmentShader:`
    uniform float uNight; uniform vec3 uSunDir; uniform vec3 uMoonDir; uniform vec3 uZen; uniform vec3 uHor; uniform vec3 uSunCol; uniform float uGlow; uniform float uWarm; varying vec3 vDir;
    float hash(vec3 p){ p=fract(p*0.3183099+.1); p*=17.0; return fract(p.x*p.y*p.z*(p.x+p.y+p.z)); }
    void main(){
      vec3 d=normalize(vDir); float h=clamp(d.y,0.,1.);
      vec3 day=mix(uHor, uZen, pow(h,.5));
      vec3 ni =mix(vec3(.060,.080,.150), vec3(.010,.018,.050), pow(h,.45));
      float s=max(dot(d,normalize(uSunDir)),0.);
      day+=uSunCol*(smoothstep(.9992,.9997,s)*3.*uGlow+pow(s,24.)*.28*uGlow+pow(s,5.)*.5*uWarm);   // disc + tight glow + broad warm sunrise/sunset glow
      float m=max(dot(d,normalize(uMoonDir)),0.);
      ni+=vec3(.78,.84,1.)*(smoothstep(.99965,.99975,m)*1.6+pow(m,90.)*.16);
      vec3 q=floor(d*300.); float st=step(.9975,hash(q))*smoothstep(.03,.3,d.y);
      ni+=vec3(clamp(st,0.,1.))*(.45+.55*hash(q+3.7));
      gl_FragColor=vec4(clamp(mix(day,ni,clamp(uNight,0.,1.)),0.,4.),1.);
    }`
}));
sky.renderOrder=-10; scene.add(sky);

/* distant mountains (integer frequencies so the ring closes seamlessly) */
function mountains(R,H,seed){
  const seg=240,pos=[],idx=[];
  for(let i=0;i<=seg;i++){
    const a=i/seg*Math.PI*2;
    const h=(.40*Math.abs(Math.sin(2*a+seed))+.28*Math.abs(Math.sin(5*a+2*seed))+.20*Math.abs(Math.sin(11*a+3*seed))+.12*Math.abs(Math.sin(23*a+seed*5)))*H+H*.12;
    pos.push(Math.cos(a)*R,-6,Math.sin(a)*R, Math.cos(a)*R,h,Math.sin(a)*R);
    if(i<seg){const k=i*2;idx.push(k,k+1,k+2,k+1,k+3,k+2)}
  }
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setIndex(idx);
  return new THREE.Mesh(g,new THREE.MeshBasicMaterial({fog:false,side:THREE.DoubleSide}));
}
const mtnFar=mountains(780,170,1.3), mtnNear=mountains(560,70,4.1);
scene.add(mtnFar,mtnNear);

/* ------------------------------------------------------------------ ground & highway */
const grassTex = canvasTex(512,512,(g,w,h)=>{
  g.fillStyle='#5d6b44';g.fillRect(0,0,w,h);
  for(let i=0;i<700;i++){const x=Math.random()*w,y=Math.random()*h,r=6+Math.random()*34,c=Math.random()<.5?'rgba(40,62,30,.13)':'rgba(120,115,70,.12)';
    for(const oy of [-h,0,h])for(const ox of [-w,0,w]){g.fillStyle=c;g.beginPath();g.arc(x+ox,y+oy,r,0,7);g.fill()}}
  noiseFill(g,w,h,26);
},{repeat:true});
const GRASS_TILE=24;
/* ------------------------------------------------------------------ biomes + elevation
   A run is cut into zones of BZ metres. Zone 0 is the open highway; every later zone is a different biome (random per run).
   Between two zones the road swings through a long sweeper and over a crest (a "pass", BP metres either side of the border).
   Thick mist hangs over the crest and the scenery swaps inside it. Elevation is a height table (like the sideways bend table):
   every scene material is lifted in the vertex shader by bendY(z), so hills need no extra geometry. */
const BIOMES=['Open Highway','Coastal Cliffs','Snowy Forest','Metro City','Coastal City','Desert'], BIOME_W=[2,3,1,2,2,2];   // how often each biome is picked (coast most common, snow rarest, the two cities medium)
const BZ=4200, BP=450, BKP=.0012;
let biomeBase=0, biomeSeed=.37, _bc=[0], _lastBi=0, gzNow=1e9, fogN0=60, fogF0=450, E0=10;
const bHash=k=>{ const x=Math.sin((k+biomeSeed*977)*91.3+17.7)*43758.5453; return x-Math.floor(x); };
const biomeOf=k=>{ if(k<=0) return 0; while(_bc.length<=k){ const i=_bc.length, pv=_bc[i-1], c=[0,1,2,3,4,5].filter(b=>b!==pv), tw=c.reduce((a,b)=>a+BIOME_W[b],0); let r=bHash(i)*tw, pick=c[c.length-1]; for(const b of c){ r-=BIOME_W[b]; if(r<0){ pick=b; break; } } _bc.push(pick); } return _bc[k]; };
const BW={w:[1,0,0,0,0,0],dom:0,pw:0};
const _tunnelBlack=new THREE.Color(0x000000);
function biomeWeights(x,half,o){ const k=Math.round(x/BZ), t=smooth(-half,half,x-k*BZ); for(let i=0;i<6;i++) o[i]=0; o[biomeOf(k-1)]+=1-t; o[biomeOf(k)]+=t; return o; }
function passW(x){ const k=Math.round(x/BZ); if(k<1) return 0; const u=(x-k*BZ)/BP; if(u<=-1||u>=1) return 0; const c=Math.cos(u*Math.PI/2); return c*c; }
const passK=x=>{ const k=Math.round(x/BZ); return k<1?0:passW(x)*(bHash(k+50)<.5?-1:1)*BKP; };
const BASE_H=[10,24,46,5,7,16], ROLL_A=[3,7,9,1.5,3,2.2], _ew=[0,0,0,0,0,0];     // metres above sea level / rolling-hill amplitude per biome
function elevAt(d){ const x=d-biomeBase; biomeWeights(x,BP,_ew); let h=0,a=0; for(let i=0;i<6;i++){ h+=_ew[i]*BASE_H[i]; a+=_ew[i]*ROLL_A[i]; }
  return h+a*(.6*Math.sin(x/420+1.3)+.4*Math.sin(x/190+.4))+14*passW(x); }
const bendOffY=new Float32Array(31);
const yAt=z=>{ const u=Math.min(29.999,Math.max(0,(z+48)/16)), i=u|0; return bendOffY[i]+(bendOffY[i+1]-bendOffY[i])*(u-i); };
// Local road grade (positive when the road rises toward +Z); used to keep rigid vehicle bodies aligned to the hill.
const roadSlopeAt=z=>(yAt(z+2)-yAt(z-2))*.25;
const riseAt=x=>smooth(23,34,x)*15+Math.min(Math.max(x-34,0)*.2,6);      // coastal rock slope beside the oncoming lanes (matches the ground shader)

const scrubTex = canvasTex(512,512,(g,w,h)=>{
  g.fillStyle='#b4a57c';g.fillRect(0,0,w,h);
  for(let i=0;i<900;i++){const x=Math.random()*w,y=Math.random()*h,r=5+Math.random()*28,c=Math.random()<.5?'rgba(120,104,70,.14)':'rgba(222,208,168,.16)';
    for(const oy of [-h,0,h])for(const ox of [-w,0,w]){g.fillStyle=c;g.beginPath();g.arc(x+ox,y+oy,r,0,7);g.fill()}}
  for(let i=0;i<220;i++){const x=Math.random()*w,y=Math.random()*h,r=2+Math.random()*6; for(const oy of [-h,0,h])for(const ox of [-w,0,w]){g.fillStyle='rgba(78,96,54,.4)';g.beginPath();g.arc(x+ox,y+oy,r,0,7);g.fill()}}
  noiseFill(g,w,h,22);
},{repeat:true});
const desertTex = canvasTex(512,512,(g,w,h)=>{
  g.fillStyle='#b88e58';g.fillRect(0,0,w,h);
  for(let i=0;i<1100;i++){const x=Math.random()*w,y=Math.random()*h,r=2+Math.random()*19,c=Math.random()<.55?'rgba(92,60,34,.10)':'rgba(239,205,145,.18)';
    g.fillStyle=c;g.beginPath();g.ellipse(x,y,r,r*(.25+Math.random()*.45),Math.random()*.5,0,Math.PI*2);g.fill();}
  for(let i=0;i<180;i++){g.fillStyle='rgba(86,67,48,.22)';g.fillRect(Math.random()*w,Math.random()*h,1+Math.random()*3,1+Math.random()*2);}
  noiseFill(g,w,h,18);
},{repeat:true});
const snowTex = canvasTex(512,512,(g,w,h)=>{
  g.fillStyle='#e9eff6';g.fillRect(0,0,w,h);
  for(let i=0;i<700;i++){const x=Math.random()*w,y=Math.random()*h,r=6+Math.random()*34,c=Math.random()<.5?'rgba(160,182,212,.16)':'rgba(255,255,255,.35)';
    for(const oy of [-h,0,h])for(const ox of [-w,0,w]){g.fillStyle=c;g.beginPath();g.arc(x+ox,y+oy,r,0,7);g.fill()}}
  noiseFill(g,w,h,14);
},{repeat:true});

const cityTex = canvasTex(512,512,(g,w,h)=>{
  g.fillStyle='#8a8c8f';g.fillRect(0,0,w,h);
  for(let i=0;i<500;i++){const x=Math.random()*w,y=Math.random()*h,r=6+Math.random()*26,c=Math.random()<.5?'rgba(60,62,66,.12)':'rgba(190,190,185,.14)';
    for(const oy of [-h,0,h])for(const ox of [-w,0,w]){g.fillStyle=c;g.beginPath();g.arc(x+ox,y+oy,r,0,7);g.fill()}}
  g.strokeStyle='rgba(55,57,62,.35)'; g.lineWidth=2; for(let i=0;i<=w;i+=64){ g.beginPath();g.moveTo(i,0);g.lineTo(i,h);g.stroke(); g.beginPath();g.moveTo(0,i);g.lineTo(w,i);g.stroke(); }
  noiseFill(g,w,h,16);
},{repeat:true});
/* the ground is a grid (not one big quad) so its vertex shader can lift it with the road and cut the coastal cliff / rock slope.
   Columns are road-local x, so the cliff edge follows the bend. */
const GU={uCb:{value:0},uBt:{value:0},uPr:{value:0},uE0:{value:0},uGz:{value:1e9},uOffY:{value:bendOffY}};
const GXS=[-1500,-500,-200,-100,-60,-52,-46,-40,-35,-30,-26,-22,-18,-17.5,-16.5,-15.5,-14.7,-14,-9,0,8,16,21,23,26,29,32,34,64,134,300,1500];
const GZS=[-1500,-1200,-900,-600,-300]; for(let z=-290;z<=600;z+=10) GZS.push(z); GZS.push(900,1500);
const ground=(()=>{
  const nx=GXS.length, nz=GZS.length, pos=new Float32Array(nx*nz*3), nor=new Float32Array(nx*nz*3), uv=new Float32Array(nx*nz*2), idx=[];
  for(let i=0;i<nz;i++) for(let j=0;j<nx;j++){ const k=i*nx+j; pos[k*3]=GXS[j]; pos[k*3+2]=GZS[i]; nor[k*3+1]=1; uv[k*2]=GXS[j]/GRASS_TILE; uv[k*2+1]=GZS[i]/GRASS_TILE; }
  for(let i=0;i<nz-1;i++) for(let j=0;j<nx-1;j++){ const a=i*nx+j, b=a+1, c=a+nx, d=c+1; idx.push(a,c,b,b,c,d); }
  const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.BufferAttribute(pos,3)); g.setAttribute('normal',new THREE.BufferAttribute(nor,3)); g.setAttribute('uv',new THREE.BufferAttribute(uv,2)); g.setIndex(idx);
  const m=new THREE.Mesh(g,new THREE.MeshStandardMaterial({map:grassTex,roughness:1,metalness:0,envMapIntensity:0.1}));
  m.material.onBeforeCompile=sh=>{
    sh.uniforms.uOff={value:bendOff}; sh.uniforms.uOffY=GU.uOffY; sh.uniforms.uCb=GU.uCb; sh.uniforms.uE0=GU.uE0; sh.uniforms.uGz=GU.uGz; sh.uniforms.uBt=GU.uBt; sh.uniforms.uPr=GU.uPr;
    sh.vertexShader=BEND_GLSL+'uniform float uCb; uniform float uBt; uniform float uPr; uniform float uE0; uniform float uGz; varying float vCl; varying float vSand; varying float vPeb;\n'+sh.vertexShader.replace('#include <begin_vertex>',`
      vec3 transformed=vec3(position);
      float byg=bendY(position.z);
      float mR=smoothstep(-210.,-150.,position.z-uGz)*(1.-smoothstep(300.,360.,position.z-uGz));   // no drop-off along an exit ramp
      float cbR=uCb*(1.-mR);
      float sR=1.-smoothstep(-17.5,-14.,position.x);                                               // seaward cliff
      float sL=smoothstep(23.,34.,position.x);                                                     // landward rock slope
      float rise=sL*15.+min(max(position.x-34.,0.)*.2,6.);
      transformed.x+=bendX(position.z);
      float tM=smoothstep(14.,50.,-position.x), tC=smoothstep(24.,52.,-position.x);                // metro: beach slope from the verge · coastal city: wide promenade, then pebbles
      float bM=uBt*(1.-mR)*tM, bC=uPr*(1.-mR)*tC;
      transformed.y=byg-.1-(cbR*sR+bM+bC)*(byg+uE0+1.5)+uCb*rise;
      vSand=bM; vPeb=bC;
      vCl=max(cbR*sR,uCb*sL*(1.-smoothstep(33.,40.,position.x)));`);
    sh.fragmentShader='varying float vCl; varying float vSand; varying float vPeb;\n'+sh.fragmentShader.replace('#include <map_fragment>',`#include <map_fragment>
      float lmG=dot(diffuseColor.rgb,vec3(.3,.59,.11));
      diffuseColor.rgb=mix(diffuseColor.rgb,vec3(.85,.78,.66)*(lmG*.85+.03),clamp(vCl*1.4,0.,1.)*.9);
      float dlv=dot(diffuse,vec3(.3,.59,.11));
      diffuseColor.rgb=mix(diffuseColor.rgb,vec3(.92,.8,.55)*dlv*.9,clamp(vSand*6.,0.,1.)*.95);       // sand
      diffuseColor.rgb=mix(diffuseColor.rgb,vec3(.62,.58,.52)*dlv*.9,clamp(vPeb*6.,0.,1.)*.95);`);   // pebbles
  };
  scene.add(m); return m; })();

/* sea (coastal biome): one flat plane at sea level, never bent */
const seaTex = canvasTex(256,256,(g,w,h)=>{
  g.fillStyle='#fff';g.fillRect(0,0,w,h);
  for(let i=0;i<420;i++){const x=Math.random()*w,y=Math.random()*h,l=6+Math.random()*26; g.strokeStyle='rgba(150,190,215,'+(.12+Math.random()*.18)+')'; g.lineWidth=1+Math.random()*1.5;
    for(const ox of [-w,0,w]){ g.beginPath(); g.moveTo(x+ox,y); g.lineTo(x+ox+l,y+(Math.random()-.5)*3); g.stroke(); }}
  noiseFill(g,w,h,8);
},{repeat:true});
seaTex.repeat.set(100,100);
const sea = new THREE.Mesh(new THREE.PlaneGeometry(4000,4000), new THREE.MeshStandardMaterial({map:seaTex,color:0x2a86b0,roughness:.22,metalness:.15,envMapIntensity:.6}));
sea.rotation.x=-Math.PI/2; sea.visible=false; scene.add(sea);

/* snow (snowy biome): drifting flakes in a box around the camera */
const SNOW_N=1800, snowU={uCam:{value:new THREE.Vector3()},uD:{value:0},uT:{value:0},uAmt:{value:0},uPx:{value:1}};
const snowGeo=new THREE.BufferGeometry(); { const sp=new Float32Array(SNOW_N*3); for(let i=0;i<sp.length;i++) sp[i]=Math.random(); snowGeo.setAttribute('position',new THREE.BufferAttribute(sp,3)); }
const snowPts=new THREE.Points(snowGeo,new THREE.ShaderMaterial({uniforms:snowU,transparent:true,depthWrite:false,fog:false,
  vertexShader:`uniform vec3 uCam; uniform float uD; uniform float uT; uniform float uAmt; uniform float uPx; varying float vA;
  void main(){ vec3 box=vec3(44.,24.,90.); vec3 p=position;
    p.y=fract(p.y-uT*1.6/box.y); p.z=fract(p.z-uD/box.z); p.x=p.x+sin(uT*.6+position.y*37.)*.5/box.x;
    vec3 w=vec3(uCam.x+(p.x-.5)*box.x, p.y*box.y-3., uCam.z+p.z*box.z-12.);
    float dd=distance(w,uCam); float keep=step(fract(position.x*91.7+position.z*37.3),uAmt);
    vA=keep*(1.-smoothstep(35.,95.,dd))*smoothstep(.8,3.,dd);
    vec4 cp=projectionMatrix*viewMatrix*vec4(w,1.); gl_Position=cp; gl_PointSize=clamp(70./max(cp.w,1.),1.4,6.)*uPx; }`,
  fragmentShader:`varying float vA; void main(){ float d=length(gl_PointCoord-.5); float a=vA*(1.-smoothstep(.12,.5,d))*.85; if(a<.01) discard; gl_FragColor=vec4(.96,.98,1.,a); }`}));
snowPts.material.userData.glow=true; snowPts.frustumCulled=false; snowPts.visible=false; snowPts.renderOrder=6; scene.add(snowPts);

/* called from updateBend() every frame: biome weights, elevation table, ground / sea / mountain / fog state */
function biomeFrame(){
  const x=dist-biomeBase, w=BW.w; biomeWeights(x,150,w); BW.pw=passW(x);
  let bi=0; for(let q=1;q<6;q++) if(w[q]>w[bi]) bi=q; BW.dom=bi;
  E0=elevAt(dist); for(let j=0;j<31;j++) bendOffY[j]=elevAt(dist+j*16-48)-E0;
  GU.uCb.value=w[1]; GU.uBt.value=w[3]; GU.uPr.value=w[4]; GU.uE0.value=E0; GU.uGz.value=gzNow;
  const seaW=Math.min(1,w[1]+w[3]+w[4]); sea.visible=seaW>.02; sea.position.y=-E0;
  mtnFar.position.y=-E0*(.12+.88*seaW); mtnNear.position.y=-E0*(.2+.8*seaW);
  snowPts.visible=w[2]>.02; snowU.uAmt.value=w[2];
  const gm=bi===1?scrubTex:bi===2?snowTex:bi===5?desertTex:bi>=3?cityTex:grassTex; if(ground.material.map!==gm) ground.material.map=gm;
  if(bi!==_lastBi){ _lastBi=bi; tintTrees(bi); if(state==='run') popup(BIOMES[bi].toUpperCase(),'good'); }
  // Biome scenery/materials crossfade through biomeWeights(). Keep atmospheric
  // fog continuous here; do not flash the entire world to black at a biome seam.
  scene.fog.color.copy(SK.fog).convertSRGBToLinear();
  scene.fog.near=fogN0;
  scene.fog.far=fogF0;
}

/* ------------------------------------------------------------------ highway tunnels
   A short tunnel crosses each biome boundary, beginning before the seam and ending shortly after it. Tunnel vertices are explicitly
   sampled into world/bent coordinates in updateTunnel(); they MUST be excluded from
   the global bend shader or they will be bent twice and float away from the road. */
const TUNNEL_PRE=85, TUNNEL_POST=35, TUNNEL_LEN=TUNNEL_PRE+TUNNEL_POST;
const tunnelGroup=new THREE.Group(); scene.add(tunnelGroup);
const tunnelConcreteTex=canvasTex(512,512,(g,w,h)=>{
  g.fillStyle='#777a7b';g.fillRect(0,0,w,h);
  for(let i=0;i<18000;i++){const x=Math.random()*w,y=Math.random()*h,v=75+Math.random()*85;g.fillStyle=`rgba(${v|0},${v|0},${v|0},${.035+Math.random()*.11})`;g.fillRect(x,y,1+Math.random()*3,1+Math.random()*3);}
  g.strokeStyle='rgba(25,28,30,.20)';g.lineWidth=2;g.beginPath();g.moveTo(0,255);g.lineTo(w,255);g.stroke();
  g.strokeStyle='rgba(230,230,225,.12)';g.lineWidth=1;g.beginPath();g.moveTo(0,259);g.lineTo(w,259);g.stroke();
},{repeat:true});
tunnelConcreteTex.repeat.set(1,8);
const tunnelConcrete=new THREE.MeshStandardMaterial({color:0xb4b5b4,map:tunnelConcreteTex,roughness:.96,metalness:0,side:THREE.DoubleSide});
const tunnelRibMat=new THREE.MeshStandardMaterial({color:0x55595b,roughness:.9,metalness:0,side:THREE.DoubleSide});
const tunnelDarkMat=new THREE.MeshStandardMaterial({color:0x080a0d,roughness:1,metalness:0,side:THREE.DoubleSide});
const TUNNEL_LEFT=-13.5, TUNNEL_RIGHT=23, TUNNEL_TOP=25, TUNNEL_W=TUNNEL_RIGHT-TUNNEL_LEFT;
// Cross-section: full-height side walls and a broad curved crown. The opening
// comfortably covers both carriageways and their shoulders.
const tunnelSection=[];
tunnelSection.push([TUNNEL_LEFT,0],[TUNNEL_LEFT,13]);
for(let i=0;i<=24;i++){
  const u=-1+2*i/24;
  tunnelSection.push([(TUNNEL_LEFT+TUNNEL_RIGHT)/2+u*TUNNEL_W/2,13+12*Math.sqrt(Math.max(0,1-u*u))]);
}
tunnelSection.push([TUNNEL_RIGHT,0]);
const TUNNEL_STEPS=60;
function makeTunnelSurface(z0,z1,section,mat){
  const verts=[], inds=[], uvs=[];
  for(let j=0;j<=TUNNEL_STEPS;j++){
    const z=z0+(z1-z0)*j/TUNNEL_STEPS;
    for(let i=0;i<section.length;i++){const [x,y]=section[i];verts.push(x,y,z);uvs.push(i/(section.length-1),j/TUNNEL_STEPS*8);}
  }
  const n=section.length;
  for(let j=0;j<TUNNEL_STEPS;j++) for(let i=0;i<n-1;i++){
    const a=j*n+i,b=a+1,c=(j+1)*n+i,d=c+1;
    inds.push(a,c,b,b,c,d);
  }
  const g=new THREE.BufferGeometry();
  g.setAttribute('position',new THREE.Float32BufferAttribute(verts,3)); g.setAttribute('uv',new THREE.Float32BufferAttribute(uvs,2)); g.setIndex(inds); g.computeVertexNormals();
  const m=new THREE.Mesh(g,mat); m.frustumCulled=false; m.userData.tunnelWorldBent=true; tunnelGroup.add(m); return m;
}
const tunnelShell=makeTunnelSurface(-TUNNEL_LEN/2,TUNNEL_LEN/2,tunnelSection,tunnelConcrete);
// Dark inner crown gives the tunnel a deep, enclosed appearance even before fog fades in.
const innerSection=tunnelSection.slice(1,-1).map(([x,y])=>[x,y-.12]);
const tunnelInner=makeTunnelSurface(-TUNNEL_LEN/2,TUNNEL_LEN/2,innerSection,tunnelDarkMat);
// Repeated structural ribs and portal frames: narrow bands following the arch profile.
const tunnelRibs=[];
function addTunnelRib(z){
  const sec=tunnelSection.slice(1,-1).map(([x,y])=>[x,y]);
  const band=[]; for(const [x,y] of sec) band.push([x,y]);
  const g=new THREE.BufferGeometry(), v=[];
  for(const [x,y] of band) v.push(x,y,z-0.65,x,y,z+0.65);
  const ix=[]; for(let i=0;i<band.length-1;i++){const a=i*2,b=a+1,c=a+2,d=a+3;ix.push(a,c,b,b,c,d);}
  g.setAttribute('position',new THREE.Float32BufferAttribute(v,3)); g.setIndex(ix); g.computeVertexNormals();
  const m=new THREE.Mesh(g,tunnelRibMat); m.frustumCulled=false; m.userData.tunnelWorldBent=true; tunnelGroup.add(m); tunnelRibs.push(m);
}
addTunnelRib(-TUNNEL_LEN/2+2);
for(let z=-TUNNEL_LEN/2+24;z<TUNNEL_LEN/2-12;z+=24) addTunnelRib(z);
addTunnelRib(TUNNEL_LEN/2-2);
for(const child of tunnelGroup.children) child.geometry.userData.basePosition=child.geometry.attributes.position.array.slice();
function bendXAt(z){const u=Math.min(29.999,Math.max(0,(z+48)/16)),i=u|0;return bendOff[i]+(bendOff[i+1]-bendOff[i])*(u-i);}
function tunnelRoadX(z){return bendXAt(z);}
function tunnelAtDistance(d){
  const rel=d-biomeBase;
  const k=Math.max(1,Math.round(rel/BZ));
  const boundary=biomeBase+k*BZ;
  const start=boundary-TUNNEL_PRE;
  return d>=start&&d<start+TUNNEL_LEN;
}
let tunnelActive=false, tunnelFade=0;
function updateTunnel(){
  const rel=dist-biomeBase;
  const k=Math.max(1,Math.round(rel/BZ));
  const boundary=biomeBase+k*BZ;
  const start=boundary-TUNNEL_PRE;
  const q=dist-start;
  const inside=q>=0&&q<TUNNEL_LEN;
  // The tunnel is physically short; the visual darkness eases in before its
  // entrance and eases out just beyond its exit.
  const fade=smooth(3,30,q)*(1-smooth(TUNNEL_LEN-30,TUNNEL_LEN-3,q));   // interior darkness: only once the car is actually in the tunnel
  tunnelActive=inside; tunnelFade=fade;
  tunnelGroup.visible=q>-440&&q<TUNNEL_LEN+60;                           // the structure itself shows from the horizon (scene fog fades it in)
  if(!tunnelGroup.visible) return;
  const centerZ=boundary-dist-TUNNEL_PRE+TUNNEL_LEN*.5;
  // Update every vertex against the live road bend and elevation tables. This is
  // essential: a straight, rigid tunnel drifts off the road on curves and crests.
  for(const child of tunnelGroup.children){
    const a=child.geometry.attributes.position, base=child.geometry.userData.basePosition;
    for(let i=0;i<a.count;i++){
      const z=centerZ+base[i*3+2];
      a.setX(i,base[i*3]+bendXAt(z));
      a.setY(i,base[i*3+1]+yAt(z));
      a.setZ(i,z);
    }
    a.needsUpdate=true; child.geometry.computeVertexNormals();
  }
  // Geometry is already in world coordinates, so no second group transform.
  tunnelGroup.position.set(0,0,0);
}

const ROAD_LEN=500, ROAD_TILE=12;
// our carriageway: x -11 .. 7 (centre -2); lanes at x = -3.6, 0, +3.6
const road1Tex = roadTexture(18,ROAD_TILE,[
  {x:-5.4+2,color:'#e9e9e4'},{x:-1.8+2,color:'#e9e9e4',dash:3},{x:1.8+2,color:'#e9e9e4',dash:3},{x:5.4+2,color:'#e0b82e'}]);
road1Tex.repeat.set(1,ROAD_LEN/ROAD_TILE);
const road1 = new THREE.Mesh(new THREE.PlaneGeometry(18,ROAD_LEN,1,125), new THREE.MeshStandardMaterial({map:road1Tex,roughness:.88,metalness:0,envMapIntensity:.15}));
road1.rotation.x=-Math.PI/2; road1.position.set(-2,0,ROAD_LEN/2-100); scene.add(road1);
// oncoming carriageway: x 8.2 .. 20.5 (centre 14.35); lanes at x = 11.6 / 15.2
const road2Tex = roadTexture(12.3,ROAD_TILE,[
  {x:9.8-14.35,color:'#e0b82e'},{x:13.4-14.35,color:'#e9e9e4',dash:3},{x:17.0-14.35,color:'#e9e9e4'}]);
road2Tex.repeat.set(1,ROAD_LEN/ROAD_TILE);
const road2 = new THREE.Mesh(new THREE.PlaneGeometry(12.3,ROAD_LEN,1,125), new THREE.MeshStandardMaterial({map:road2Tex,roughness:.88,metalness:0,envMapIntensity:.15}));
road2.rotation.x=-Math.PI/2; road2.position.set(14.35,0,ROAD_LEN/2-100); scene.add(road2);

// median barrier (continuous) + scrolling joints
const concrete = new THREE.MeshStandardMaterial({color:0x8d8e90,roughness:.95,envMapIntensity:.1});
const barrier = new THREE.Mesh(new THREE.BoxGeometry(.6,.85,ROAD_LEN,1,1,125), concrete); barrier.position.set(7.7,.425,ROAD_LEN/2-100); scene.add(barrier);
function periodic(geom,mat,spacing,count,place){   // InstancedMesh group that scrolls by (dist mod spacing)
  const im=new THREE.InstancedMesh(geom,mat,count),o=new THREE.Object3D();
  for(let i=0;i<count;i++){o.position.set(0,0,0);o.rotation.set(0,0,0);o.scale.set(1,1,1);place(o,i);o.updateMatrix();im.setMatrixAt(i,o.matrix)}
  im.frustumCulled=false;
  const grp=new THREE.Group();grp.add(im);grp.userData.spacing=spacing;scene.add(grp);return grp;
}
const periodics=[];
periodics.push(periodic(new THREE.BoxGeometry(.04,.84,.62),new THREE.MeshStandardMaterial({color:0x2f3033,roughness:1}),5,110,(o,i)=>o.position.set(7.41,.43,i*5-100)));
// right-hand guardrail
/* guardrail + posts are instanced and scrolled by hand so the stretch next to an exit ramp can be switched off */
const EXIT_MI=10, EX=EXIT_MI*1609.34;           // exits every 10 miles (distance since the start of the run)
const RAIL_N=26, POST_N=130;
const railIM=new THREE.InstancedMesh(new THREE.BoxGeometry(.05,.32,19.8),new THREE.MeshStandardMaterial({color:0xb7bcc2,metalness:.8,roughness:.4,envMapIntensity:.4}),RAIL_N);
const postIM=new THREE.InstancedMesh(new THREE.BoxGeometry(.1,.7,.1),new THREE.MeshStandardMaterial({color:0x8e9298,metalness:.5,roughness:.6}),POST_N);
railIM.frustumCulled=postIM.frustumCulled=false; scene.add(railIM,postIM);
const _go=new THREE.Object3D();
function updateGuard(dist,gz){                    // gz = z (relative to the car) of the nearest exit gore
  const lo=gz-170, hi=gz+70, a=dist%20, b=dist%4, gx=BW.dom===1?-11.9:-8.7;
  for(let i=0;i<RAIL_N;i++){ const z=-100+i*20+10-a; _go.position.set(gx,.62,z); _go.scale.setScalar(z>lo-10&&z<hi+10?0.0001:1); _go.updateMatrix(); railIM.setMatrixAt(i,_go.matrix); }
  for(let i=0;i<POST_N;i++){ const z=i*4-100-b; _go.position.set(gx-.08,.35,z); _go.scale.setScalar(z>lo&&z<hi?0.0001:1); _go.updateMatrix(); postIM.setMatrixAt(i,_go.matrix); }
  railIM.instanceMatrix.needsUpdate=postIM.instanceMatrix.needsUpdate=true;
}
/* coastal biome: a second guardrail along the landward edge of the oncoming carriageway */
const railL=new THREE.InstancedMesh(railIM.geometry,railIM.material,RAIL_N), postL=new THREE.InstancedMesh(postIM.geometry,postIM.material,POST_N);
railL.frustumCulled=postL.frustumCulled=false; railL.visible=postL.visible=false; scene.add(railL,postL);
function updateGuardL(dist){
  const on=BW.dom===1; railL.visible=postL.visible=on; if(!on) return; const a=dist%20, b=dist%4;
  for(let i=0;i<RAIL_N;i++){ _go.position.set(21.5,.62,-100+i*20+10-a); _go.scale.setScalar(1); _go.updateMatrix(); railL.setMatrixAt(i,_go.matrix); }
  for(let i=0;i<POST_N;i++){ _go.position.set(21.58,.35,i*4-100-b); _go.scale.setScalar(1); _go.updateMatrix(); postL.setMatrixAt(i,_go.matrix); }
  railL.instanceMatrix.needsUpdate=postL.instanceMatrix.needsUpdate=true;
}
// reflective roadside posts (white, scrolling)
periodics.push(periodic(new THREE.BoxGeometry(.08,.9,.08),new THREE.MeshStandardMaterial({color:0xf0f0f0,roughness:.6,emissive:0x222222}),50,12,(o,i)=>o.position.set(-11.4,.45,i*50-100)));

/* street lamps on the median (double arm) */
const lampGroup=new THREE.Group();scene.add(lampGroup);
const lampSprites=[],lampPools=[];
{
  const poleMat=new THREE.MeshStandardMaterial({color:0x6c7076,metalness:.6,roughness:.5});
  const headMat=new THREE.MeshStandardMaterial({color:0x333333,emissive:0xffc88a,emissiveIntensity:0});
  window.__lampHeadMat=headMat;
  const SP=36,N=12;
  for(let i=-2;i<N-2;i++){
    const gp=new THREE.Group();gp.position.z=i*SP;
    const pole=new THREE.Mesh(new THREE.CylinderGeometry(.09,.13,10,10),poleMat);pole.position.set(7.7,5,0);gp.add(pole);
    for(const dir of [-1,1]){
      const arm=new THREE.Mesh(new THREE.BoxGeometry(3.5,.1,.1),poleMat);arm.position.set(7.7+dir*1.75,9.9,0);gp.add(arm);
      const head=new THREE.Mesh(new THREE.BoxGeometry(.95,.14,.38),headMat);head.position.set(7.7+dir*3.6,9.75,0);gp.add(head);
      const sp=makeGlow(0xffc684);
      sp.scale.set(3.2,3.2,1);sp.position.set(7.7+dir*3.6,9.6,0);gp.add(sp);lampSprites.push(sp);
      const pool=new THREE.Mesh(new THREE.PlaneGeometry(16,16),new THREE.MeshBasicMaterial({map:poolTex,blending:THREE.AdditiveBlending,transparent:true,depthWrite:false,opacity:0,fog:false}));
      pool.rotation.x=-Math.PI/2;pool.position.set(7.7+dir*3.6,.035,0);gp.add(pool);lampPools.push(pool);
    }
    lampGroup.add(gp);
  }
  lampGroup.userData.spacing=SP;
}

/* road signs + exit ramp. Positions are measured in metres since the start of the run (runDist):
   - "EXIT IN 10 MILES" at the start and at every 10-mile mark
   - "EXIT 1/2 MILE" half a mile before each exit, "EXIT / CASH OUT" at the ramp itself */
let runDist=0, exitAt=0, exitT=0;
const SIGN_START=90, HALF_MI=805;
function signMaker(draw){
  const tex=canvasTex(512,256,()=>{}); tex.userData={k:null};
  const gp=new THREE.Group(); gp.visible=false;
  const pm=new THREE.MeshStandardMaterial({color:0x777b80,metalness:.6,roughness:.5});
  for(const dx of [-1.6,1.6]){const p=new THREE.Mesh(new THREE.CylinderGeometry(.06,.06,4.4,8),pm);p.position.set(-11.6+dx,2.2,0);gp.add(p)}
  const panel=new THREE.Mesh(new THREE.PlaneGeometry(4.6,2.3),new THREE.MeshStandardMaterial({map:tex,roughness:.5,emissive:0xffffff,emissiveMap:tex,emissiveIntensity:.05}));
  panel.rotation.y=Math.PI;panel.position.set(-11.6,3.7,-.08);gp.add(panel);
  scene.add(gp);
  return {gp,set(k){ if(tex.userData.k===k) return; tex.userData.k=k; const g=tex.image.getContext('2d');
    g.fillStyle='#0d6b43';g.fillRect(0,0,512,256);g.strokeStyle='#fff';g.lineWidth=8;g.strokeRect(10,10,492,236);g.fillStyle='#fff';g.textAlign='center';
    draw(g,k); tex.needsUpdate=true; }};
}
const signAdv=signMaker((g,k)=>{ g.font='bold 54px sans-serif';g.fillText('EXIT IN',256,96);
  g.font='bold 92px sans-serif';g.fillText(EXIT_MI+' MILES',256,186); });
const signHalf=signMaker((g,k)=>{ g.font='bold 40px sans-serif';g.fillText('EXIT '+k,256,70);
  g.font='bold 78px sans-serif';g.fillText('1/2 MILE',256,152);
  g.font='bold 34px sans-serif';g.fillText('CASH OUT  •  RIGHT LANE',256,214); });
const signExit=signMaker((g,k)=>{ g.font='bold 44px sans-serif';g.fillText('EXIT '+k,256,66);
  g.font='bold 84px sans-serif';g.fillText('CASH OUT',256,160);
  g.fillStyle='#fff';g.beginPath();g.moveTo(330,186);g.lineTo(400,186);g.lineTo(400,170);g.lineTo(440,200);g.lineTo(400,230);g.lineTo(400,214);g.lineTo(330,214);g.closePath();g.fill(); /* arrow to the right */
  g.font='bold 34px sans-serif';g.textAlign='left';g.fillText('100,000 pts = $5',70,214); });

/* the ramp: a ribbon in the ramp's own coordinates (local z = metres past the gore point). Before the gore the shoulder
   lane widens out of the carriageway; after it the ramp curves away to the right and straightens out. */
const RAMP_A=-160, RAMP_B=320;
const rampX=lz=>{ if(lz<=0){ const t=smooth(0,1,(lz-RAMP_A)/-RAMP_A); return -5.4-1.8*t; } const q=Math.min(lz,60); return -7.2-.0016*q*q-(lz>60?.192*(lz-60):0); };
const rampSlope=lz=>lz<=0?0:lz<60?.0032*lz:.192;
const rampGroup=new THREE.Group(); rampGroup.visible=false; scene.add(rampGroup);
{
  const pos=[],uv=[],idx=[],N=64;
  for(let i=0;i<=N;i++){
    const lz=RAMP_A+(RAMP_B-RAMP_A)*i/N; let a,b;
    if(lz<=0){ const t=smooth(0,1,(lz-RAMP_A)/-RAMP_A); a=-5.4; b=-5.4-3.6*t-.001; }   // inner edge stays on the road edge line, outer edge opens up
    else{ const c=rampX(lz); a=c+1.8; b=c-1.8; }
    pos.push(a,0,lz, b,0,lz); uv.push(0,lz/12, 1,lz/12);
    if(i<N){ const k=i*2; idx.push(k,k+2,k+1,k+1,k+2,k+3); }
  }
  const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3)); g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2)); g.setIndex(idx); g.computeVertexNormals();
  const tex=roadTexture(3.6,12,[{x:-1.7,color:'#e9e9e4',w:.18},{x:1.7,color:'#e9e9e4',w:.18}]);
  const m=new THREE.Mesh(g,new THREE.MeshStandardMaterial({map:tex,roughness:.88,metalness:0,envMapIntensity:.15,side:THREE.DoubleSide,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2}));
  m.position.y=.02; rampGroup.add(m);
  // gore: white hatched wedge painted on the road where the lane splits off
  const gc=canvasTex(128,256,(g,w,h)=>{ g.clearRect(0,0,w,h); g.fillStyle='rgba(233,233,228,.9)'; for(let y=0;y<h;y+=32){ g.beginPath(); g.moveTo(0,y); g.lineTo(w,y+16); g.lineTo(w,y+30); g.lineTo(0,y+14); g.fill(); } });
  const gm=new THREE.Mesh(new THREE.PlaneGeometry(1.8,48),new THREE.MeshBasicMaterial({map:gc,transparent:true,depthWrite:false,fog:true,polygonOffset:true,polygonOffsetFactor:-4,polygonOffsetUnits:-4}));
  gm.rotation.x=-Math.PI/2; gm.position.set(-8.1,.03,-26); rampGroup.add(gm);
}
function exitK(){ return Math.max(1,Math.round(runDist/EX)); }
function updateSigns(){
  const kA=Math.max(0,Math.round((runDist-SIGN_START)/EX)), zA=kA*EX+SIGN_START-runDist;
  signAdv.set(0); signAdv.gp.visible=zA>-60&&zA<520; signAdv.gp.position.z=zA;
  const kE=exitK(), gz=kE*EX-runDist;
  signHalf.set(kE); signHalf.gp.visible=gz-HALF_MI>-60&&gz-HALF_MI<520; signHalf.gp.position.z=gz-HALF_MI;
  signExit.set(kE); signExit.gp.visible=gz-45>-60&&gz-45<520; signExit.gp.position.z=gz-45;
  rampGroup.visible=gz>-RAMP_B&&gz<520; rampGroup.position.z=gz;
  return gz;
}

/* trees (instanced, individually wrapped). Shape, colour, density and position follow the biome:
   open highway = the usual cones · coastal cliffs = cypress + umbrella pines on the hillside only · snowy forest = ~2.5x as many, closer to the road, snow-capped · Metro City = no trees · Coastal City = blue trees with shadows */
const TREES=430,TREE_L=360,treeData=[];
for(let i=0;i<TREES;i++) treeData.push({u:Math.random(),right:Math.random()<.55,z:Math.random()*TREE_L,s:.7+Math.random()*.9,r:Math.random()*6.28,k:Math.random()});
const trunkIM=new THREE.InstancedMesh(new THREE.CylinderGeometry(.18,.26,2.4,6),new THREE.MeshStandardMaterial({color:0x4a3a2a,roughness:1}),TREES);
const crownIM=new THREE.InstancedMesh(new THREE.ConeGeometry(1.7,5.2,7),new THREE.MeshStandardMaterial({color:0xffffff,roughness:1,envMapIntensity:.2}),TREES);
const snowIM=new THREE.InstancedMesh(new THREE.ConeGeometry(1.2,3.1,7),new THREE.MeshStandardMaterial({color:0xf0f5fa,roughness:.95,envMapIntensity:.25}),TREES);
trunkIM.frustumCulled=crownIM.frustumCulled=snowIM.frustumCulled=false; snowIM.visible=false; scene.add(trunkIM,crownIM,snowIM);
const _o=new THREE.Object3D(), _tc=new THREE.Color();
function tintTrees(bi){
  for(let i=0;i<TREES;i++){ const t=treeData[i];
    if(bi===1) _tc.set(t.k<.55?0x1f3a26:0x4a6a30); else if(bi===2) _tc.set(0x1f3d33); else if(bi===4) _tc.set(0x287fce); else if(bi===5) _tc.set(0x8b754b); else _tc.set(0x2d4a2a);
    crownIM.setColorAt(i,_tc.multiplyScalar(.85+t.u*.3)); }
  crownIM.instanceColor.needsUpdate=true;
}
tintTrees(0);
const CITYL=364;
function updateTrees(dist,gz){          // gz: z of the nearest exit gore; trees are cleared from the ramp corridor
  const bi=BW.dom, city=bi===3||bi===4, n=(bi===3||bi===5)?0:bi===4?Math.min(TREES,58):Math.min(TREES,Math.round(treeN*(bi===2?2.5:bi===1?.8:1)));
  trunkIM.count=crownIM.count=snowIM.count=n; snowIM.visible=bi===2;
  // Only Coastal City trees cast shadows; Metro City has no umbrella/palm trees.
  trunkIM.castShadow=crownIM.castShadow=(bi===4);
  for(let i=0;i<n;i++){
    const t=treeData[i]; let z=((t.z-dist)%TREE_L+TREE_L)%TREE_L-60, x,y=0,kx=1,ky=1,ty=1,tx=1,s=t.s;
    if(city){ const j=i>>1; x=(i&1)?22.8+((j&1)?2.6:0):-(14.6+((j&1)?2.6:0)); z=((j*13-dist)%CITYL+CITYL)%CITYL-60; s=.85+t.u*.25; tx=.5; ty=2.6; kx=1.5; ky=.32; }   // palms along both verges
    else if(bi===1){ x=24+t.u*t.u*(t.right?56:70); y=riseAt(x); if(t.k<.55){ kx=.42; ky=1.7; } else { kx=1.45; ky=.42; ty=1.7; } }   // cypress / umbrella pine
    else if(bi===2){ x=t.right?-(12+t.u*46):23+t.u*56; s*=1.12; }
    else if(bi===5){ x=t.right?-(28+t.u*92):30+t.u*105; s*=.78; }
    else x=t.right?-(14+t.u*70):24+t.u*80;
    const lz=z-gz, sc=(lz>-170&&lz<RAMP_B&&Math.abs(x-rampX(Math.max(lz,-1)))<7)?.0001:s;
    _o.rotation.set(0,t.r,0);
    _o.position.set(x,y+1.2*sc*ty,z);_o.scale.set(sc*tx,sc*ty,sc*tx);_o.updateMatrix();trunkIM.setMatrixAt(i,_o.matrix);
    const cb=y+2.4*sc*ty;
    _o.position.set(x,cb+2.6*ky*sc,z);_o.scale.set(sc*kx,sc*ky,sc*kx);_o.updateMatrix();crownIM.setMatrixAt(i,_o.matrix);
    if(bi===2){ _o.position.set(x,cb+3.65*sc,z);_o.scale.set(sc,sc,sc);_o.updateMatrix();snowIM.setMatrixAt(i,_o.matrix); }
  }
  trunkIM.instanceMatrix.needsUpdate=crownIM.instanceMatrix.needsUpdate=snowIM.instanceMatrix.needsUpdate=true;
}


/* desert biome: instanced saguaro cacti plus a few distant roadside gas stations.
   All props are scenery only, kept well outside the drivable corridor and wrapped like the trees. */
const CACTUS_N=92, CACTUS_L=520, cactusData=[];
for(let i=0;i<CACTUS_N;i++) cactusData.push({u:Math.random(),right:Math.random()<.5,z:Math.random()*CACTUS_L,s:.65+Math.random()*1.05,r:(Math.random()-.5)*.35});
const cactusMat=new THREE.MeshStandardMaterial({color:0x477044,roughness:.94});
const cactusBody=new THREE.InstancedMesh(new THREE.CylinderGeometry(.28,.38,3.8,7),cactusMat,CACTUS_N);
const cactusArmH=new THREE.InstancedMesh(new THREE.CylinderGeometry(.19,.22,1.15,7),cactusMat,CACTUS_N*2);
const cactusArmV=new THREE.InstancedMesh(new THREE.CylinderGeometry(.19,.22,1.35,7),cactusMat,CACTUS_N*2);
for(const im of [cactusBody,cactusArmH,cactusArmV]){im.frustumCulled=false;im.visible=false;scene.add(im);}
function updateDesertProps(dist){
  const on=BW.dom===5;
  cactusBody.visible=cactusArmH.visible=cactusArmV.visible=on;
  desertStations.forEach(st=>{st.group.visible=on;});
  if(!on)return;
  let nh=0,nv=0;
  for(let i=0;i<CACTUS_N;i++){
    const c=cactusData[i], z=((c.z-dist)%CACTUS_L+CACTUS_L)%CACTUS_L-75;
    const x=c.right?-(27+c.u*92):(29+c.u*100), sc=c.s;
    _o.rotation.set(0,c.r,0);_o.position.set(x,1.9*sc,z);_o.scale.set(sc,sc,sc);_o.updateMatrix();cactusBody.setMatrixAt(i,_o.matrix);
    for(const side of [-1,1]){
      _o.rotation.set(0,c.r,side*Math.PI/2);_o.position.set(x+side*.47*sc,1.95*sc,z);_o.scale.set(sc,sc,sc);_o.updateMatrix();cactusArmH.setMatrixAt(nh++,_o.matrix);
      _o.rotation.set(0,c.r,0);_o.position.set(x+side*.92*sc,2.55*sc,z);_o.scale.set(sc,sc,sc);_o.updateMatrix();cactusArmV.setMatrixAt(nv++,_o.matrix);
    }
  }
  cactusBody.instanceMatrix.needsUpdate=cactusArmH.instanceMatrix.needsUpdate=cactusArmV.instanceMatrix.needsUpdate=true;
  for(const st of desertStations){
    const z=((st.z-dist)%st.period+st.period)%st.period-90;
    st.group.position.set(st.x,0,z);
  }
}

const desertStations=[];
function makeDesertStation(x,z,variant){
  const group=new THREE.Group();
  const wall=new THREE.MeshStandardMaterial({color:variant?0xd6c4a0:0xc7b18a,roughness:.9});
  const roof=new THREE.MeshStandardMaterial({color:variant?0x9d3d2b:0x31546a,roughness:.72});
  const dark=new THREE.MeshStandardMaterial({color:0x292b2b,roughness:.8});
  const signMat=new THREE.MeshStandardMaterial({color:variant?0xf0c65b:0xe7e5d8,emissive:variant?0x4a2608:0x151515,emissiveIntensity:.35});
  const building=new THREE.Mesh(new THREE.BoxGeometry(13,5.5,9),wall);building.position.set(0,2.75,0);group.add(building);
  const canopy=new THREE.Mesh(new THREE.BoxGeometry(18,.65,12),roof);canopy.position.set(0,5.7,8);group.add(canopy);
  for(const sx of [-7.3,7.3])for(const sz of [3,13]){const post=new THREE.Mesh(new THREE.BoxGeometry(.35,5,.35),dark);post.position.set(sx,2.8,sz);group.add(post);}
  const pumpMat=new THREE.MeshStandardMaterial({color:0xe8e8e2,roughness:.55,metalness:.15});
  for(const sx of [-4,0,4]){const pump=new THREE.Mesh(new THREE.BoxGeometry(1.05,2,.8),pumpMat);pump.position.set(sx,1.05,8);group.add(pump);}
  const pole=new THREE.Mesh(new THREE.BoxGeometry(.35,12,.35),dark);pole.position.set(-10,6, -3);group.add(pole);
  const sign=new THREE.Mesh(new THREE.BoxGeometry(7,3.4,.45),signMat);sign.position.set(-10,11.5,-3);group.add(sign);
  const stripe=new THREE.Mesh(new THREE.BoxGeometry(6.2,.28,.48),roof);stripe.position.set(-10,11.5,-2.72);group.add(stripe);
  scene.add(group);desertStations.push({group,x,z,period:1120});
}
makeDesertStation(108,250,0);makeDesertStation(-118,700,1);makeDesertStation(132,980,0);

/* Mediterranean hillside village (coastal biome): cream / ochre blocks with terracotta hip roofs on the rock slope */
const HOUSES=32, HOUSE_L=560, houseData=[];
for(let c=0;c<8;c++){ const cz=Math.random()*HOUSE_L, cx=36+Math.random()*14; for(let j=0;j<4;j++) houseData.push({x:cx+Math.random()*18,z:cz+(j-1.5)*14+Math.random()*4,w:5.5+Math.random()*3,h:3.4+Math.random()*2.6,d:5.5+Math.random()*3,r:(Math.random()-.5)*.5}); }
const houseWallIM=new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),new THREE.MeshStandardMaterial({color:0xffffff,roughness:.95,envMapIntensity:.15}),HOUSES);
const houseRoofIM=new THREE.InstancedMesh(new THREE.ConeGeometry(.8,1,4).rotateY(Math.PI/4),new THREE.MeshStandardMaterial({color:0xffffff,roughness:.85,envMapIntensity:.15}),HOUSES);
{ const W=[0xf0e4cc,0xe4c595,0xe9d2c2,0xd8b88a,0xf4efe6], R=[0xb4553a,0xa6452d,0xc0623f], hc=new THREE.Color();
  for(let i=0;i<HOUSES;i++){ houseWallIM.setColorAt(i,hc.set(W[(Math.random()*W.length)|0])); houseRoofIM.setColorAt(i,hc.set(R[(Math.random()*R.length)|0])); } }
houseWallIM.frustumCulled=houseRoofIM.frustumCulled=false; houseWallIM.visible=houseRoofIM.visible=false; scene.add(houseWallIM,houseRoofIM);
function updateHouses(dist){
  const on=BW.dom===1; houseWallIM.visible=houseRoofIM.visible=on; if(!on) return;
  for(let i=0;i<HOUSES;i++){ const h=houseData[i], z=((h.z-dist)%HOUSE_L+HOUSE_L)%HOUSE_L-60, y=riseAt(h.x)-.8;
    _o.rotation.set(0,h.r,0); _o.position.set(h.x,y+h.h/2,z); _o.scale.set(h.w,h.h,h.d); _o.updateMatrix(); houseWallIM.setMatrixAt(i,_o.matrix);
    _o.position.set(h.x,y+h.h+.8,z); _o.scale.set(h.w,1.6,h.d); _o.updateMatrix(); houseRoofIM.setMatrixAt(i,_o.matrix); }
  houseWallIM.instanceMatrix.needsUpdate=houseRoofIM.instanceMatrix.needsUpdate=true;
}

/* ------------------------------------------------------------------ city biomes
   Metro City (Surfers-Paradise-like): glass high-rises in three rows on the left, sand beach sloping into the sea on the right.
   Coastal City (Nice-like): continuous Mediterranean apartment frontage with zinc roofs, a palm promenade, pebble beach and sea.
   Facades are repeating window tiles (UVs are scaled per building so windows keep their size); a matching emissive tile lights them at night. */
let _rs=1; const rnd=()=>{ _rs=(_rs*16807)%2147483647; return (_rs-1)/2147483646; };   // seeded so the colour tile and the lit-window tile agree
function facadeTex(kind,lit){
  _rs=kind==='tower'?12345:6789;
  return canvasTex(256,256,(g,w,h)=>{
    g.fillStyle=lit?'#000':(kind==='tower'?'#8da3b5':'#e9dbbd'); g.fillRect(0,0,w,h);
    if(kind==='tower'){
      for(let r=0;r<4;r++) for(let c=0;c<4;c++){ const on=rnd()<.42, warm=rnd()<.8, x=c*64, y=r*64;
        if(!lit){ g.fillStyle='#35475a'; g.fillRect(x+5,y+6,54,50); g.fillStyle='rgba(255,255,255,.14)'; g.beginPath(); g.moveTo(x+5,y+56); g.lineTo(x+34,y+6); g.lineTo(x+59,y+6); g.lineTo(x+30,y+56); g.fill(); }
        else if(on){ g.fillStyle=warm?'#ffd89a':'#bfe2ff'; g.fillRect(x+7,y+8,50,46); } }
    } else {
      for(let r=0;r<2;r++) for(let c=0;c<3;c++){ const on=rnd()<.5, x=c*85, y=r*128;
        if(!lit){ g.fillStyle='#d2c3a2'; g.fillRect(x,y+118,85,10); g.fillStyle='#2f3a46'; g.fillRect(x+22,y+26,41,78); g.fillStyle=(r+c)%2?'#6f9484':'#7b8fa8'; g.fillRect(x+8,y+26,12,78); g.fillRect(x+65,y+26,12,78); g.fillStyle='#2a2d31'; g.fillRect(x+14,y+92,57,3); }
        else if(on){ g.fillStyle='#ffcf8a'; g.fillRect(x+23,y+27,39,76); } }
    }
  },{repeat:true});
}
function bldGeo(w,h,d,tw,th){      // box whose window tile repeats a whole number of times per face
  const g=new THREE.BoxGeometry(w,h,d), uv=g.attributes.uv;
  for(let v=0;v<uv.count;v++){ const f=(v/4)|0;
    if(f===2||f===3) uv.setXY(v,0,0);
    else uv.setXY(v,uv.getX(v)*Math.max(1,Math.round((f<2?d:w)/tw)),uv.getY(v)*Math.max(1,Math.round(h/th))); }
  return g;
}
const towerMat=new THREE.MeshStandardMaterial({map:facadeTex('tower',false),emissiveMap:facadeTex('tower',true),emissive:0xffffff,emissiveIntensity:0,roughness:.35,metalness:.3,envMapIntensity:.6});
const frontMat=new THREE.MeshStandardMaterial({map:facadeTex('front',false),emissiveMap:facadeTex('front',true),emissive:0xffffff,emissiveIntensity:0,roughness:.85,metalness:0,envMapIntensity:.15});
const CITY_L=560;
const BT=[ [20,70,20],[22,110,18],[24,150,24],[22,200,22],[26,250,26],             // metro high-rises (x size, height, z size)
           [16,22,28],[16,25,32],[16,28,26],[16,31,30],[18,38,30],[18,46,34] ];    // coastal-city blocks
const cityBlds=[], cityTypeN=BT.map(()=>0);
function addBld(mode,type,x,z){ const [w,h,d]=BT[type]; cityBlds.push({mode,type,x,z,w,h,d,k:cityTypeN[type]++,ri:0}); }
for(let r=0;r<3;r++) for(let k=0;k<12;k++) addBld('metro',Math.min(4,((Math.random()*3)|0)+r),[34,76,118][r]+(Math.random()-.5)*10,k*(CITY_L/12)+Math.random()*10);
for(const [row,types,x0] of [[0,[5,6,7,8],27],[1,[9,10],27+16+6]]){ let z=Math.random()*10; while(true){ const ty=types[(Math.random()*types.length)|0], [w,h,d]=BT[ty]; if(z+d>CITY_L) break; addBld('front',ty,x0+w/2,z+d/2); z+=d+4; } }
{ const ri={metro:0,front:0}; cityBlds.forEach(b=>b.ri=ri[b.mode]++); }
const cityIM=BT.map((t,i)=>{ const im=new THREE.InstancedMesh(bldGeo(t[0],t[1],t[2],i<5?14.4:10.2,i<5?14.4:7.2),i<5?towerMat:frontMat,Math.max(1,cityTypeN[i])); im.frustumCulled=false; im.visible=false; scene.add(im); return im; });
const cityRoofIM=new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),new THREE.MeshStandardMaterial({color:0xffffff,roughness:.7,metalness:.2,envMapIntensity:.2}),Math.max(cityBlds.filter(b=>b.mode==='metro').length,cityBlds.filter(b=>b.mode==='front').length));
cityRoofIM.frustumCulled=false; cityRoofIM.visible=false; scene.add(cityRoofIM);
{ const TW=[0xffffff,0xd5e8f0,0xcfd8e6,0xe9e2d0], FW=[0xffffff,0xf5e6c8,0xf0cfa6,0xe8d2c2], RC=[0x56606b,0x6b7580,0x4a535c], c=new THREE.Color();
  cityBlds.forEach(b=>{ const pal=b.mode==='metro'?TW:FW; cityIM[b.type].setColorAt(b.k,c.set(pal[(Math.random()*pal.length)|0])); cityRoofIM.setColorAt(b.ri,c.set(RC[(Math.random()*RC.length)|0])); }); }
function updateCity(dist){
  const bi=BW.dom, on=bi===3||bi===4, mode=bi===3?'metro':'front';
  cityRoofIM.visible=on; for(let i=0;i<cityIM.length;i++) cityIM[i].visible=on&&(i<5)===(mode==='metro');
  if(!on) return;
  towerMat.emissiveIntensity=frontMat.emissiveIntensity=1.5*L;
  let nr=0;
  for(const b of cityBlds){ if(b.mode!==mode) continue;
    const z=((b.z-dist)%CITY_L+CITY_L)%CITY_L-60;
    _o.rotation.set(0,0,0); _o.scale.set(1,1,1); _o.position.set(b.x,b.h/2-1.2,z); _o.updateMatrix(); cityIM[b.type].setMatrixAt(b.k,_o.matrix);
    _o.position.set(b.x,b.h-.1,z); _o.scale.set(b.w*.92,2.4,b.d*.92); _o.updateMatrix(); cityRoofIM.setMatrixAt(b.ri,_o.matrix); nr++; }
  cityRoofIM.count=nr;
  for(let i=0;i<cityIM.length;i++) if(cityIM[i].visible) cityIM[i].instanceMatrix.needsUpdate=true;
  cityRoofIM.instanceMatrix.needsUpdate=true;
}

/* ------------------------------------------------------------------ traffic (simple boxy cars; lights show at night)
   NOTE FOR OTHER AGENTS / FUTURE EDITS: this boxy traffic car is the "BETA CAR". Traffic will eventually be replaced with
   proper models, but DO NOT DELETE this model. Keep its builder (makeTraffic: body/cab/under/tails boxes, 1.85 x ~1.9 x 4.5 m,
   +Z front, wheels not modelled) or move it into its own function. It is reserved for the Black Market "Beta Car" entry (see BM_ITEMS),
   which is now a PLAYABLE car (see buildBeta in the car section: same boxes + wheels, lights, paint). Traffic still uses this builder. */
const trafficGlass=new THREE.MeshStandardMaterial({color:0x10151c,metalness:.5,roughness:.15});
const trafficDark =new THREE.MeshStandardMaterial({color:0x0c0c0e,roughness:.9});
const trafficCars=[];
const redTail=new THREE.MeshStandardMaterial({color:0x550000,emissive:0xff1010,emissiveIntensity:.15});
function spriteLamp(color,size){
  const s=makeGlow(color);
  s.scale.set(size,size,1);return s;
}
function makeTraffic(oncoming){
  const cols=[0xb02a2a,0x2a4fa8,0xd7d7d7,0x1b1b1d,0x9a9ea5,0xe0c34a,0x2f7a4a];
  const g=new THREE.Group();
  const fade=!oncoming, bodyM=new THREE.MeshStandardMaterial({color:cols[(Math.random()*cols.length)|0],metalness:.5,roughness:.35,envMapIntensity:.4});
  const glM=fade?trafficGlass.clone():trafficGlass, dkM=fade?trafficDark.clone():trafficDark, tlM=fade?redTail.clone():redTail;   // row traffic gets its own materials so it can fade out near exits
  const mats=fade?[bodyM,glM,dkM,tlM]:null; if(fade) mats.forEach(m=>{ m.transparent=true; });
  const body=new THREE.Mesh(new THREE.BoxGeometry(1.85,.62,4.5),bodyM);body.position.y=.7;
  const cab=new THREE.Mesh(new THREE.BoxGeometry(1.6,.55,2.4),glM);cab.position.set(0,1.27,-.25);
  const under=new THREE.Mesh(new THREE.BoxGeometry(1.7,.4,4.1),dkM);under.position.y=.3;
  const tails=new THREE.Mesh(new THREE.BoxGeometry(1.5,.12,.04),tlM);tails.position.set(0,.85,-2.26);
  g.add(body,cab,under,tails);
  const lamps=[];
  for(const sx of [-.65,.65]){
    const h=spriteLamp(0xdfeaff,1.6);h.position.set(sx,.72,2.35);g.add(h);lamps.push({s:h,k:.9,on:'head'});
    const t=spriteLamp(0xff2a18,1.3);t.position.set(sx,.85,-2.35);g.add(t);lamps.push({s:t,k:.85,on:'tail'});
  }
  if(oncoming) g.rotation.y=Math.PI;
  scene.add(g);
  return {g,lamps,oncoming,x:0,z:0,v:0,mats,tl:tlM,alpha:1,fa:1};
}
const LANES=[-3.6,0,3.6];
function respawn(t,first){
  if(t.oncoming){t.x=[11.6,15.2][(Math.random()*2)|0];t.v=24+Math.random()*10;t.z=first?Math.random()*420-40:380+Math.random()*120}
  else for(let k=0;k<8;k++){
    const li=(Math.random()*3)|0; t.x=LANES[li]; t.v=[19+Math.random()*5,25+Math.random()*6,31+Math.random()*7][li];
    t.z=first?30+Math.random()*340:(speed>t.v?330+Math.random()*80:-70-Math.random()*40);
    if(!trafficCars.some(o=>o!==t&&!o.oncoming&&o.x===t.x&&Math.abs(o.z-t.z)<50)) break;
  }
  t.crashT=0; t.g.rotation.y=t.oncoming?Math.PI:0; t.pz=t.z; t.g.position.set(t.x,0,t.z);
}
for(let i=0;i<4;i++){const t=makeTraffic(true);respawn(t,true);trafficCars.push(t)}
/* traffic in rows: each row blocks two of the three lanes and leaves one clearly open gap; the open lane
   shifts left/right from row to row, so threading the gaps means real lane changes. */
/* adaptive difficulty: DIFF goes 0 -> 1 over the first DIFF_MILES of a run (updated every frame from `miles`).
   Early on most rows are empty or a single car; by DIFF=1 every row is two cars + a gap and walls appear at full rate. */
let DIFF=0, brkAssist=0; const DIFF_MILES=4;
const wallChance=()=>.16*Math.min(1,Math.max(0,(DIFF-.2)/.6))*(1+1.2*HARD);   // walls get ~2x as common by mile 20
let VT=22, HARD=0; const ROW_GAP=90, NROWS=5, rows=[];
function nextGap(g){ if(Math.random()<.25) return g; const o=g===1?[0,2]:[1]; return o[(Math.random()*o.length)|0]; }
/* wall rows (occasional): all three lanes blocked. Each car has its own speed (+-2.5 m/s) and they only start to
   spread out once the row is near you, so braking behind a wall makes the cars string out and open a lane. */
function layoutRow(r,chain,wall){
  r.chain=chain; r.wall=!!wall; r.gap=wall?-1:chain; r.hit=false; r.done=false;
  let lanes=wall?[0,1,2]:[0,1,2].filter(l=>l!==chain);
  if(!wall){
    if(Math.random()>.45+.55*DIFF) lanes=[];                                    // quiet stretch: nobody in this row
    else if(Math.random()<.7*(1-DIFF)) lanes=[lanes[(Math.random()*lanes.length)|0]];   // a lone car
    if(lanes.length<2) r.done=true;                                              // only a real two-car row with a gap scores
  }
  const sp=wall?[-3.5,0,3.5].sort(()=>Math.random()-.5):[0,0,0];
  const stg=wall?[-12,0,12].sort(()=>Math.random()-.5):[0,0,0];                  // walls are staggered front-to-back so there is room to cut through
  r.cars.forEach((c,i)=>{
    const on=i<lanes.length; c.gone=!on; c.g.visible=on; c.crashT=0; c.off=on?stg[i]:0; c.g.rotation.y=0; c.z=c.pz=r.z+c.off;
    if(on){
      c.x=wall?[-4.6,0,4.6][lanes[i]]:LANES[lanes[i]]; c.v=VT+sp[i]; c.g.position.set(c.x,0,r.z+c.off);
      // Each newly spawned active traffic car has a 1-in-150 chance of being a reckless driver.
      c.reckless=Math.random()<1/150; c.recklessLanes=wall?[-4.6,0,4.6]:LANES;
      c.recklessTimer=1; c.recklessFrom=c.x; c.recklessTarget=c.x; c.recklessBlend=1;
    } else { c.reckless=false; }
  });
}
for(let i=0;i<NROWS;i++){ const r={z:0,pz:0,gap:1,chain:1,wall:false,hit:false,done:false,cars:[]};
  for(let j=0;j<3;j++){ const c=makeTraffic(false); trafficCars.push(c); r.cars.push(c); } rows.push(r); }
function resetRows(){ DIFF=0; let g=1; rows.forEach((r,i)=>{ g=nextGap(g); r.z=r.pz=50+i*ROW_GAP; layoutRow(r,g,false); }); }
resetRows();

/* ------------------------------------------------------------------ car */
/* Seal Grey Metallic: a smooth mid-grey base (the look comes from the clearcoat + reflections) with a fine metallic flake.
   The flake is a procedural micro-normal map, so it glints under the clearcoat instead of painting clouds on the body. */
const flake = (()=>{
  const N=256, c=document.createElement('canvas'); c.width=c.height=N; const g=c.getContext('2d'), im=g.createImageData(N,N), d=im.data;
  for(let i=0;i<N*N;i++){ const nx=(Math.random()-.5)*2, ny=(Math.random()-.5)*2, nz=1, l=Math.hypot(nx,ny,nz);
    d[4*i]=(nx/l*.5+.5)*255; d[4*i+1]=(ny/l*.5+.5)*255; d[4*i+2]=(nz/l*.5+.5)*255; d[4*i+3]=255; }
  g.putImageData(im,0,0);
  const t=new THREE.CanvasTexture(c); t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(26,26); t.anisotropy=ANISO; return t;
})();

// Porsche crest (front hood badge)
const crestTex = new THREE.TextureLoader().load('porsche_crest.png');
crestTex.encoding = THREE.sRGBEncoding;
crestTex.anisotropy = ANISO;

const M = {
  paint:  new THREE.MeshPhysicalMaterial({color:0x848a93, normalMap:flake, normalScale:new THREE.Vector2(.22,.22), metalness:0.9, roughness:0.3, clearcoat:1.0, clearcoatRoughness:0.025, envMapIntensity:0.6}),
  glass:  new THREE.MeshPhysicalMaterial({color:0x080c11, metalness:0.2, roughness:0.04, envMapIntensity:1.2}),
  lampglass: new THREE.MeshPhysicalMaterial({color:0xdfe6ee, metalness:0, roughness:0.05, transparent:true, opacity:0.35}),
  tire:   new THREE.MeshStandardMaterial({color:0x111113, roughness:0.9}),
  rim:    new THREE.MeshStandardMaterial({color:0xb8bcc4, metalness:1, roughness:0.25}),
  wheel:  new THREE.MeshStandardMaterial({color:0x4a4c52, metalness:0.7, roughness:0.5}),
  exhaust:new THREE.MeshStandardMaterial({color:0x8a8782, metalness:1, roughness:0.35}),
  lamp:   new THREE.MeshPhysicalMaterial({color:0xdfe3e8, metalness:0.6, roughness:0.15, emissive:0xcfe0ff, emissiveIntensity:0}),
  tail:   new THREE.MeshPhysicalMaterial({color:0x8e1414, roughness:0.2, clearcoat:1, emissive:0xff1a12, emissiveIntensity:0.05}),
  dark:   new THREE.MeshStandardMaterial({color:0x5a5c62, roughness:0.75, metalness:0}),
  badge:  new THREE.MeshStandardMaterial({color:0xc2a964, metalness:1, roughness:0.3}),
  crest:  new THREE.MeshPhysicalMaterial({map:crestTex, color:0xffffff, metalness:0.3, roughness:0.35, clearcoat:0.8, clearcoatRoughness:0.08})   // front hood crest, UV-mapped
};
Object.values(M).forEach(m=>{ if(m.envMapIntensity!==undefined) m.userData.e0=m.envMapIntensity; });
const pick = n => M[n] || M.paint;

/* ---- tire tread: procedural, on the contact surface only (sidewalls stay smooth) ----
   The tyre mesh is a surface of revolution, so it doesn't need to turn at all: only the pattern does, driven by uniforms.
   - cross lugs with irregular pitch + circumferential grooves + a V chevron, bump-mapped; lug detail fades as the wheel speeds up
     (it would strobe at 60 fps), like real motion blur
   - a coarse pattern of worn / dusty rubber patches turns at the true speed up to TREAD.wc rad/s, then eases off, so the
     rotation stays readable from the chase camera instead of strobing */
const TREAD={N:54, wc:14};     // N: lugs per revolution · wc: fastest the wear pattern turns on screen (rad/s)
const TAU=Math.PI*2;
const TU={uPh:{value:new THREE.Vector4()},uOm:{value:0}};
M.tire.onBeforeCompile=sh=>{
  sh.uniforms.uPh=TU.uPh; sh.uniforms.uOm=TU.uOm;
  sh.vertexShader=sh.vertexShader
    .replace('#include <common>','#include <common>\nvarying vec3 vTP; varying vec3 vTN;')
    .replace('#include <begin_vertex>','#include <begin_vertex>\nvTP=position; vTN=normal;');
  const decl=`
uniform vec4 uPh; uniform float uOm; varying vec3 vTP; varying vec3 vTN;
float tH(float n){ return fract(sin(n*12.9898)*43758.5453); }
float tPN(float x,float M,float s){ float i=floor(x),f=fract(x); f=f*f*(3.-2.*f); return mix(tH(mod(i,M)+s),tH(mod(i+1.,M)+s),f); }
vec3 tPert(vec3 sp,vec3 sn,vec2 dH,float fd){
  vec3 sx=dFdx(sp), sy=dFdy(sp), R1=cross(sy,sn), R2=cross(sn,sx);
  float det=dot(sx,R1)*fd; vec3 g=sign(det)*(dH.x*R1+dH.y*R2);
  return normalize(abs(det)*sn-g);
}`;
  const body=`#include <normal_fragment_maps>
{
  const float TN=${TREAD.N.toFixed(1)};
  float isF=step(0.,vTP.z);
  vec2 cc=mix(vec2(.355,-1.355),vec2(.335,1.355),isF);          // wheel centre (y,z) in car space
  float th=atan(vTP.y-cc.x,vTP.z-cc.y);
  float u=(abs(vTP.x)-mix(.7775,.8085,isF))/mix(.135,.105,isF);   // -1..1 across the tread
  float au=abs(u);
  float tm=1.-smoothstep(.3,.6,abs(vTN.x));                       // tread only: sidewalls have axial normals
  vec2 ph=vec2(mix(uPh.y,uPh.x,isF),mix(uPh.w,uPh.z,isF));        // x: true rotation, y: displayed rotation of the wear pattern
  float pt=th+ph.x;
  float cyc=(pt+.075*sin(2.*pt+1.3)+.04*sin(5.*pt+.4))*TN/6.2831853-au*.5;   // irregular pitch + chevron
  float fc=fract(cyc);
  float cross_=smoothstep(0.,.2,abs(fc-.5)*2.);                   // 0 inside a cross groove
  float sipe=smoothstep(0.,.08,abs(fract(cyc*2.)-.5)*2.);
  float blk=mix(mix(1.,sipe,.55),cross_,smoothstep(.33,.40,au));
  float cg=smoothstep(0.,.09,abs(au-.31))*smoothstep(0.,.08,abs(au-.70));   // circumferential grooves
  float fwc=length(fwidth(vec2(cos(th),sin(th))))*TN/6.2831853*1.5;
  float lug=(1./(1.+pow(uOm*TN*.00265*1.3,2.)))*(1.-smoothstep(.2,.5,fwc));     // lug detail fades with blur / distance
  float cgA=1.-smoothstep(.06,.2,fwidth(u));
  float bl=mix(1.,blk,lug), cgv=mix(1.,cg,cgA);
  float h=-((1.-bl)*.008+(1.-cgv)*.007)*tm;
  float gv=1.-.5*(1.-bl)-.5*(1.-cgv);
  float wx=(th+ph.y)/6.2831853;
  float wear=smoothstep(.35,.85,tPN(wx*7.+u*1.6,7.,3.)*.65+tPN(wx*13.-u*2.3,13.,9.)*.35);   // dusty / worn patches
  float stk=(tH(floor((u+1.)*22.)+17.)-.5)*.012*smoothstep(8.,60.,uOm);                   // faint circumferential streaks at speed
  diffuseColor.rgb*=mix(1.,.5+.5*gv,tm);
  diffuseColor.rgb+=tm*((.05*wear)*(.5+.5*gv)+stk);
  roughnessFactor=mix(roughnessFactor,clamp(.9-.18*wear+.08*(1.-gv),.5,1.),tm);
  normal=tPert(-vViewPosition,normal,vec2(dFdx(h),dFdy(h)),faceDirection);
}`;
  sh.fragmentShader=sh.fragmentShader.replace('#include <common>','#include <common>'+decl).replace('#include <normal_fragment_maps>',body);
};
M.tire.customProgramCacheKey=()=>'tread1';

const car = new THREE.Group(); scene.add(car);
const wheels = [];           // {pivot, r, angle}
const carLights = {glow:[], spots:[], tails:[], beams:[]};

// blurred-spoke disc shown over the rims at speed (hides the wagon-wheel strobing)
const blurTex = canvasTex(256,256,(g,w,h)=>{
  g.clearRect(0,0,w,h);
  const gr=g.createRadialGradient(128,128,22,128,128,128);
  gr.addColorStop(0,'rgba(120,124,132,0)');gr.addColorStop(.30,'rgba(150,154,162,.55)');gr.addColorStop(.85,'rgba(190,194,202,.5)');gr.addColorStop(1,'rgba(150,154,162,0)');
  g.fillStyle=gr;g.fillRect(0,0,w,h);
});
const blurMat = new THREE.MeshStandardMaterial({map:blurTex,transparent:true,opacity:0,depthWrite:false,metalness:.8,roughness:.45,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2});

function splitWheels(root){
  const defs = [ {y:.335,z: 1.355,r:.335,sx: 1}, {y:.335,z: 1.355,r:.335,sx:-1},
                 {y:.355,z:-1.355,r:.355,sx: 1}, {y:.355,z:-1.355,r:.355,sx:-1} ];
  const ws = defs.map(d=>{ const p=new THREE.Group(); p.position.set(0,d.y,d.z); root.add(p); const tp=new THREE.Group(); tp.position.set(0,d.y,d.z); root.add(tp); return {...d,pivot:p,tp,angle:0,pd:0}; });   // tp: steers but never spins (the tread pattern turns in the shader)
  const targets=[]; root.traverse(m=>{ if(m.isMesh && ['tire','rim','wheel'].includes(m.name)) targets.push(m); });
  for(const m of targets){
    const g=m.geometry, P=g.attributes.position, I=g.index.array, buckets=[[],[],[],[]];
    for(let i=0;i<I.length;i+=3){
      const a=I[i],b=I[i+1],c=I[i+2];
      const cx=(P.getX(a)+P.getX(b)+P.getX(c))/3, cz=(P.getZ(a)+P.getZ(b)+P.getZ(c))/3;
      buckets[(cz>0?0:2)+(cx>0?0:1)].push(a,b,c);
    }
    buckets.forEach((idx,k)=>{
      if(!idx.length) return;
      const ng=new THREE.BufferGeometry();
      for(const n in g.attributes) ng.setAttribute(n,g.attributes[n]);
      ng.setIndex(idx);
      const mm=new THREE.Mesh(ng,m.material); mm.name=m.name; mm.frustumCulled=false;
      mm.position.set(0,-ws[k].y,-ws[k].z);
      (m.name==='tire'?ws[k].tp:ws[k].pivot).add(mm);
    });
    m.parent.remove(m);
  }
  // blur discs (don't spin; opacity driven by wheel speed)
  ws.forEach(w=>{
    const d=new THREE.Mesh(new THREE.CircleGeometry(w.r<.34?.225:.24,40),blurMat);
    d.geometry.rotateY(w.sx>0?Math.PI/2:-Math.PI/2);
    d.position.set(w.sx*.914,w.y,w.z); d.renderOrder=3; root.add(d);
  });
  return ws;
}

function addCarLights(root,cfg){
  const C=cfg||{h:[[.711,.658,1.93,.95],[.607,.628,1.99,.85]],t:[[.68,.76,-2.13,.85,.95],[.63,.78,-2.06,.55,.8],[.537,.47,-2.18,.6,.9]],sp:[.66,.65,1.95],bm:[.66,.64,1.97],pl:[.7,.62,-2.9]};
  const mkGlow=(x,y,z,color,size,k,type)=>{
    const s=spriteLamp(color,size);s.position.set(x,y,z);root.add(s);carLights.glow.push({s,k,type});
  };
  for(const sx of [-1,1]){
    for(const h of C.h) mkGlow(sx*h[0],h[1],h[2],0xe4eeff,h[3],1.0,'head');
    for(const t of C.t) mkGlow(sx*t[0],t[1],t[2],0xff2418,t[3],t[4],'tail');
    // headlight beam (pool on the road)
    const sp=new THREE.SpotLight(0xe6efff,0,60,.46,.75,1.0);
    sp.position.set(sx*C.sp[0],C.sp[1],C.sp[2]); sp.target.position.set(sx*.35,0,26);
    root.add(sp,sp.target); carLights.spots.push(sp);
    // volumetric-looking beam
    const bg=new THREE.CylinderGeometry(3.6,.03,32,28,1,true);bg.rotateX(Math.PI/2);bg.translate(0,0,16);
    const bm=new THREE.Mesh(bg,new THREE.ShaderMaterial({
      transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,side:THREE.DoubleSide,
      uniforms:{uOn:{value:0},uCol:{value:new THREE.Color(0xcfe0ff)}},
      vertexShader:`varying vec2 vUv;varying vec3 vN;varying vec3 vV;void main(){vUv=uv;vec4 mv=modelViewMatrix*vec4(position,1.);vN=normalize(normalMatrix*normal);vV=normalize(-mv.xyz);gl_Position=projectionMatrix*mv;}`,
      fragmentShader:`uniform float uOn;uniform vec3 uCol;varying vec2 vUv;varying vec3 vN;varying vec3 vV;
        void main(){float e=pow(clamp(abs(dot(normalize(vN),normalize(vV))),.0001,1.),1.8);float a=clamp(pow(clamp(1.-vUv.y,.0001,1.),1.6)*e*.20*uOn,0.,.2);gl_FragColor=vec4(uCol*a,a);}`}));
    bm.position.set(sx*C.bm[0],C.bm[1],C.bm[2]); bm.rotation.x=.045; bm.frustumCulled=false; bm.renderOrder=4;
    root.add(bm); carLights.beams.push(bm);
    const pl=new THREE.PointLight(0xff2a18,0,4.5,1.6); pl.position.set(sx*C.pl[0],C.pl[1],C.pl[2]); root.add(pl); carLights.tails.push(pl);
  }
}

/* ---- cars: each has its own root group under `car`; only the selected one is visible ---- */
const gtRoot=new THREE.Group(); car.add(gtRoot);
const betaRoot=new THREE.Group(); car.add(betaRoot); const betaWheels=[];
/* BETA CAR: playable version of the old boxy traffic car (same body/cab/under/tail boxes as makeTraffic, 1.85 x ~1.9 x 4.5 m, +Z front),
   now with wheels, head/brake lights and the shared paint material, so the paint shop works on it. */
(function buildBeta(){
  const add=(geo,mat,x,y,z)=>{ const m=new THREE.Mesh(geo,mat); m.position.set(x,y,z); betaRoot.add(m); return m; };
  add(new THREE.BoxGeometry(1.85,.62,4.5),M.paint,0,.7,0);
  add(new THREE.BoxGeometry(1.6,.55,2.4),M.glass,0,1.27,-.25);
  add(new THREE.BoxGeometry(1.56,.06,2.2),M.paint,0,1.575,-.25);
  add(new THREE.BoxGeometry(1.7,.4,4.1),trafficDark,0,.3,0);
  add(new THREE.BoxGeometry(1.5,.12,.04),M.tail,0,.85,-2.26);
  for(const sx of [-1,1]) add(new THREE.BoxGeometry(.42,.16,.04),M.lamp,sx*.65,.75,2.26);
  const tireM=new THREE.MeshStandardMaterial({color:0x111113,roughness:.9});
  for(const [fz,front] of [[1.45,true],[-1.45,false]]) for(const sx of [-1,1]){
    const steer=new THREE.Group(); steer.position.set(sx*.86,.33,fz); betaRoot.add(steer);
    const spin=new THREE.Group(); steer.add(spin);
    const tg=new THREE.CylinderGeometry(.33,.33,.24,28); tg.rotateZ(Math.PI/2); spin.add(new THREE.Mesh(tg,tireM));
    const rg=new THREE.CylinderGeometry(.21,.21,.25,20); rg.rotateZ(Math.PI/2); spin.add(new THREE.Mesh(rg,M.wheel));
    for(let i=0;i<3;i++){ const sg=new THREE.BoxGeometry(.26,.05,.4); sg.rotateX(i*Math.PI/3); spin.add(new THREE.Mesh(sg,M.rim)); }
    const d=new THREE.Mesh(new THREE.CircleGeometry(.23,32),blurMat); d.geometry.rotateY(sx>0?Math.PI/2:-Math.PI/2); d.position.x=sx*.13; d.renderOrder=3; steer.add(d);   // spoke blur at speed
    betaWheels.push({steer,spin,front,angle:0});
  }
  addCarLights(betaRoot,{h:[[.65,.74,2.3,1.0]],t:[[.62,.85,-2.32,.9,.95]],sp:[.65,.72,2.28],bm:[.65,.72,2.3],pl:[.7,.7,-3.0]});
  betaRoot.traverse(m=>{ m.castShadow=castsShadow(m); });
})();
const CARS=[{id:'gt',name:'Porsche Carrera GT',desc:'The Star of this show.',root:gtRoot},{id:'beta',name:'Beta Car',desc:'Old traffic cars from testing builds!',root:betaRoot}];
let CS={owned:['gt'],sel:'gt'};      // owned: car ids (the Carrera GT is always owned; the Beta Car is bought on the Black Market)
try{ const j=JSON.parse(localStorage.getItem('cgt_cars')||'null');
  if(j&&Array.isArray(j.owned)){ CS.owned=['gt',...j.owned.filter(x=>x==='beta')]; if(CS.owned.includes(j.sel)) CS.sel=j.sel; } }catch(e){}
// Independent handling/performance profiles. The Carrera GT profile remains the original simulation.
const CAR_STATS={
  gt:{topSpeedMph:205,zeroTo60:3.9,points:true,leaderboard:true},
  beta:{topSpeedMph:310,zeroTo60:1.0,points:false,leaderboard:false,impactImmunity:true}
};
// Future dealership entries have real-world reference specifications but deliberately have no model/root yet.
// They stay unavailable until their 3D models are added; these values are not active game handling profiles.
const FUTURE_CAR_SPECS={
  enzo:{name:'Ferrari Enzo',year:2003,engine:'6.0L naturally aspirated V12',powerHp:650,topSpeedMph:209,zeroTo60:3.3,available:false},
  charger:{name:'Dodge Charger SRT8',year:2007,engine:'6.1L HEMI V8',powerHp:425,topSpeedMph:175,zeroTo60:4.8,available:false},
  zondar:{name:'Pagani Zonda R',year:2009,engine:'6.0L AMG V12',powerHp:750,topSpeedMph:233,zeroTo60:2.7,available:false},
  daytona:{name:'Shelby Cobra Daytona',year:1965,engine:'289 cu in Ford V8',powerHp:385,topSpeedMph:198,zeroTo60:4.01,available:false},
  aero:{name:'SSC Ultimate Aero',year:2006,engine:'6.3L supercharged V8',powerHp:1046,topSpeedMph:257,zeroTo60:2.8,available:false},
  viper:{name:'2013 SRT Viper GTS',year:2013,engine:'8.4L naturally aspirated V10',powerHp:640,topSpeedMph:206,zeroTo60:3.5,available:false}
};
const isBetaCar=()=>CS.sel==='beta';
function renderCarShop(){
  const catalog=[
    {id:'gt',name:'Porsche Carrera GT',detail:'5.7L naturally aspirated V10 · 612 hp · 205 mph · 0–60 in 3.9 s',owned:true},
    ...Object.entries(FUTURE_CAR_SPECS).map(([id,c])=>({id,name:c.name,detail:[c.year,c.engine,c.powerHp?c.powerHp+' hp':null,c.topSpeedMph+' mph',c.zeroTo60+' s 0–60'].filter(Boolean).join(' · '),soon:true}))
  ];
  $('carShopRows').innerHTML=catalog.map(c=>c.owned
    ?'<div class="carshop-row owned"><div class="carshop-info"><strong>'+c.name+'</strong><small>'+c.detail+'</small></div><button type="button" disabled>Owned</button></div>'
    :'<div class="carshop-row soon"><div class="carshop-info"><strong>'+c.name+'</strong><small>'+c.detail+'</small></div><button type="button" disabled>Coming Soon</button></div>'
  ).join('');
}

function saveCars(){ try{store.set('cgt_cars',JSON.stringify(CS))}catch(e){} }
function applyCar(){ CARS.forEach(c=>{ c.root.visible=c.id===CS.sel; }); }
applyCar();

const loadMsg=document.getElementById('msg');
new THREE.GLTFLoader().load(GLB_URL, gltf => {
  gltf.scene.traverse(m => { if (m.isMesh){ m.material = pick(m.name); m.frustumCulled = false; if (m.material===M.lampglass) m.renderOrder = 2; } });
  gtRoot.add(gltf.scene);             // Y-up, +Z front, 1 unit = 1 m, tires at y=0

  // The GLB has a real, separate rear wordmark mesh named 'badge'.
  // Keep its original dedicated metallic material; do not replace it with a
  // screen-facing decal or a depth-write-disabled overlay.
  const rearWordmark = gltf.scene.getObjectByName('badge');
  if (rearWordmark && rearWordmark.isMesh) {
    rearWordmark.material = M.badge;
    rearWordmark.renderOrder = 0;
    rearWordmark.frustumCulled = false;
  }

  wheels.push(...splitWheels(gltf.scene));
  addCarLights(gtRoot); car.traverse(m=>{ m.castShadow=castsShadow(m); }); applyQuality();
  loadMsg.textContent='W/↑ gas · S/↓ brake · A D steer · Space handbrake · C camera';
  setTimeout(()=>{loadMsg.style.opacity=0;loadMsg.style.transition='opacity 1.5s'},4000);
}, undefined, err => {
  loadMsg.textContent='Could not load ' + GLB_URL + ' (check file name / run from a web server).';
  console.error(err);
});

// soft contact shadow
const blob = new THREE.Mesh(new THREE.PlaneGeometry(3.0,6.2), new THREE.MeshBasicMaterial({transparent:true,depthWrite:false,opacity:.55,fog:false,
  map:canvasTex(128,256,(g,w,h)=>{const r=g.createRadialGradient(64,128,4,64,128,128);r.addColorStop(0,'rgba(0,0,0,.9)');r.addColorStop(.55,'rgba(0,0,0,.5)');r.addColorStop(1,'rgba(0,0,0,0)');g.save();g.translate(64,128);g.scale(.55,1);g.translate(-64,-128);g.fillStyle=r;g.fillRect(0,0,w,h);g.restore()},{srgb:false})}));
blob.rotation.x=-Math.PI/2; blob.position.y=.012; scene.add(blob);

/* ------------------------------------------------------------------ day / night */
let night=0, nightTarget=0, L=0;         // night: 0..1 darkness (from the clock), L: lights 0..1
const envMats=[];   // filled once the scene is built (see bottom)

/* ---------------- time of day: a full 24 h clock (DAY_LEN real seconds per day), sunrise 6:00, sunset 18:30.
   Lighting is interpolated between keyframes so there are real early/late stages: pre-dawn, sunrise, golden hour, sunset, dusk... */
const SUNRISE=6, SUNSET=18.5, TOD_START=7;
let tod=TOD_START, rainK=0, dropK=0;      // tod: hour of day 0..24 · rainK: rain intensity 0..1 · dropK: how wet the car still is
const KNAMES=['zen','hor','fog','hemiS','hemiG','sun','mf','mn','gr'];
//   hour  dark  zenith    horizon   fog       hemiSky   hemiGnd   sun       sunI  farMtn    nearMtn   grass
const KEYS=[
 [0,    1,   0x070d20, 0x101a36, 0x0b1224, 0x5b6fa8, 0x151826, 0x7f93d6, .15, 0x0b1220, 0x070c16, 0x3a4260],
 [4,    1,   0x070d20, 0x101a36, 0x0b1224, 0x5b6fa8, 0x151826, 0x7f93d6, .15, 0x0b1220, 0x070c16, 0x3a4260],
 [5,    .85, 0x0c1838, 0x3a2f55, 0x1b2036, 0x5b6fa8, 0x1c1d33, 0x8a8fd0, .16, 0x1a2038, 0x0d1222, 0x4a4e72],   // pre-dawn
 [5.75, .45, 0x2c4378, 0xff9a5a, 0x7b6f84, 0x9a8fb8, 0x3a3040, 0xff9a55, .28, 0x6d6280, 0x3c3a56, 0xb89a8c],   // first light
 [6.5,  .12, 0x4a7ab8, 0xffd4a4, 0xe3c9a9, 0xffe0c8, 0x7a6a66, 0xffcf9a, .45, 0xb9a79a, 0x8d8a96, 0xffe6cc],   // sunrise
 [8,    0,   0x3f7cc8, 0xcfe0f2, 0xc4d6ea, 0xffffff, 0x777788, 0xfff2dc, .6,  0x9fb3c9, 0x7d93ab, 0xffffff],   // morning
 [12.5, 0,   0x2f66c0, 0xc9dcf0, 0xbed0e4, 0xffffff, 0x777788, 0xfff2dc, .6,  0x9fb3c9, 0x7d93ab, 0xffffff],   // midday
 [16.5, 0,   0x3a6fb8, 0xd6e0ea, 0xc6d4e2, 0xffffff, 0x777788, 0xffe9c8, .58, 0xa0b0c0, 0x7f90a4, 0xfff6e6],   // late afternoon
 [17.75,.06, 0x4a74b0, 0xffcf94, 0xe8c9a4, 0xffeed8, 0x7a6e68, 0xffbf80, .5,  0xb8a898, 0x8a8a98, 0xffe3c4],   // golden hour
 [18.5, .32, 0x34508f, 0xff7a4a, 0xa8706a, 0xd8a090, 0x4a3d4a, 0xff7a40, .32, 0x7a5a66, 0x4a4660, 0xe0b090],   // sunset
 [19.25,.65, 0x1b2a58, 0x6a4672, 0x3f3552, 0x7a76b0, 0x2a2638, 0x7f7fc8, .2,  0x3a3552, 0x1e2036, 0x8a7a9a],   // dusk
 [20.25,.9,  0x0d1633, 0x2a2a52, 0x151b33, 0x5b6fa8, 0x1a1c2c, 0x7f93d6, .16, 0x151c30, 0x0b1020, 0x4a5078],   // late dusk
 [21.5, 1,   0x070d20, 0x101a36, 0x0b1224, 0x5b6fa8, 0x151826, 0x7f93d6, .15, 0x0b1220, 0x070c16, 0x3a4260],
 [24,   1,   0x070d20, 0x101a36, 0x0b1224, 0x5b6fa8, 0x151826, 0x7f93d6, .15, 0x0b1220, 0x070c16, 0x3a4260]
].map(k=>({h:k[0],n:k[1],sunI:k[8],c:[k[2],k[3],k[4],k[5],k[6],k[7],k[9],k[10],k[11]].map(x=>new THREE.Color(x))}));
const SK={n:0,sunI:.6}; KNAMES.forEach(k=>SK[k]=new THREE.Color());
function sampleSky(h){
  let i=0; while(i<KEYS.length-2&&h>=KEYS[i+1].h) i++;
  const a=KEYS[i], b=KEYS[i+1], t=smooth(a.h,b.h,h);
  for(let j=0;j<KNAMES.length;j++) SK[KNAMES[j]].copy(a.c[j]).lerp(b.c[j],t);
  SK.n=a.n+(b.n-a.n)*t; SK.sunI=a.sunI+(b.sunI-a.sunI)*t;
}
const _sd=new THREE.Vector3(), _md=new THREE.Vector3(), _gc=new THREE.Color();
function sunDirAt(h,o){ const a=(h-SUNRISE)/(SUNSET-SUNRISE)*Math.PI; return o.set(Math.cos(a)*.8,Math.sin(a)*.85,.6).normalize(); }
function moonDirAt(h,o){ const a=((h-SUNSET+24)%24)/(24-(SUNSET-SUNRISE))*Math.PI; return o.set(Math.cos(a)*.8,Math.sin(a)*.8+.02,.6).normalize(); }
function overcast(c,w,dark){ const l=c.r*.3+c.g*.59+c.b*.11; c.lerp(_gc.setRGB(l*dark,l*dark,l*dark),w); }
const TOD_STAGES=[[4,'Late night'],[5.5,'Pre-dawn'],[6.75,'Sunrise'],[9,'Early morning'],[11.5,'Late morning'],[13.5,'Midday'],[15.5,'Early afternoon'],[17.5,'Late afternoon'],[18.25,'Golden hour'],[19.25,'Sunset'],[20.5,'Dusk'],[22,'Late evening'],[24,'Early night']];
function todStage(h){ for(const [t,n] of TOD_STAGES) if(h<t) return n; return 'Early night'; }
function todText(h){ const hh=Math.floor(h), mm=Math.floor((h-hh)*60), h12=hh%12||12; return h12+':'+String(mm).padStart(2,'0')+(hh<12?' AM':' PM'); }

/* ---------------- weather: rain comes and goes (clear 90-240 s, rain 50-120 s, eased in and out over ~8 s) */
let rainT=0, rainOn=false, rainNext=40+Math.random()*200;
/* weather is rolled fresh for every run so it can't be learned: ~30% dry runs, ~25% already wet at the start,
   otherwise the first shower lands anywhere from 25 s to ~3.5 min in; showers vary in length and strength */
function rainPlan(){
  const r=Math.random(); rainOn=false; rainT=0;
  if(r<.3) rainNext=240+Math.random()*180;                                   // dry (a shower may still turn up very late)
  else if(r<.55){ rainOn=true; rainT=.3+Math.random()*.7; rainNext=25+Math.random()*110; }   // starts out wet
  else rainNext=25+Math.random()*190;
  rainK=dropK=rainT;
}
function rainTick(dt){
  if(window.__rainLock!==undefined) rainT=window.__rainLock;
  else{ rainNext-=dt; if(rainNext<=0){ rainOn=!rainOn; rainT=rainOn?.3+Math.random()*.7:0; rainNext=rainOn?20+Math.random()*110:50+Math.random()*250; } }
  const dry=1-BW.w[2]; rainK+=(rainT*dry-rainK)*(1-Math.exp(-dt/4)); rainK=Math.min(rainK,dry);      // never rains in the snowy forest (it snows instead)
  dropK+=(rainK-dropK)*(1-Math.exp(-dt/(rainK>dropK?3:25))); dropK=Math.min(dropK,dry);   // drops on the car arrive quickly and linger after the rain stops
}
const raining=()=>rainK>.45&&BW.w[2]<.05;                                  // rain that counts for the x1.5 points bonus

function applyNight(){
  const wet=rainK, ov=Math.max(wet,.55*BW.w[2])*(1-.6*BW.w[1]), cw=BW.w[1], sw=BW.w[2];   // ov: haze/overcast (snowy forest is grey, coast is clear)
  sampleSky(tod); night=SK.n; const n=night;
  const nL=Math.min(1,n+.28*ov);                             // storm clouds switch the lights on a little earlier
  overcast(SK.zen,.8*ov,1-.3*ov); overcast(SK.hor,.8*ov,1-.3*ov); overcast(SK.fog,.7*ov,1-.25*ov);
  overcast(SK.mf,.5*ov,1-.2*ov); overcast(SK.mn,.5*ov,1-.2*ov); overcast(SK.gr,.4*ov,1-.2*ov);
  { const lum=c=>c.r*.3+c.g*.59+c.b*.11;            // biome colour grading of mountains and fog
    if(sw>0){ for(const c of [SK.mf,SK.mn]){ const l=lum(c); c.lerp(_gc.setRGB(Math.min(1,l*1.5+.04),Math.min(1,l*1.55+.05),Math.min(1,l*1.7+.08)),.8*sw); }
      const l=lum(SK.fog); SK.fog.lerp(_gc.setRGB(Math.min(1,l*1.08+.02),Math.min(1,l*1.12+.03),Math.min(1,l*1.25+.05)),.7*sw); }
    if(cw>0){ for(const c of [SK.mf,SK.mn]) c.lerp(_gc.setRGB(c.r*1.15,c.g*.98,c.b*.78),.6*cw); SK.fog.lerp(_gc.setRGB(SK.fog.r*1.06,SK.fog.g*1.02,SK.fog.b*.9),.5*cw); }
    { const wc=BW.w[3]*.3+BW.w[4]*.6; if(wc>0) SK.fog.lerp(_gc.setRGB(SK.fog.r*1.06,SK.fog.g*1.02,SK.fog.b*.9),wc); }
    sea.material.color.set(0x2a86b0).lerp(_gc.set(0x06101f),Math.min(1,n*1.1)); overcast(sea.material.color,.5*wet,.9); }
  sunDirAt(tod,_sd); moonDirAt(tod,_md); const el=_sd.y;
  skyU.uNight.value=smooth(.7,1,n)*(1-.8*ov);               // stars/moon only when properly dark and clear
  skyU.uZen.value.copy(SK.zen); skyU.uHor.value.copy(SK.hor); skyU.uSunCol.value.copy(SK.sun);
  skyU.uSunDir.value.copy(_sd); skyU.uMoonDir.value.copy(_md);
  skyU.uGlow.value=1-.9*ov; skyU.uWarm.value=(1-gauss(el,0,.5))*smooth(-.3,.02,el)*(1-.85*ov);
  L=smooth(.3,.65,nL);
  scene.fog.color.copy(SK.fog).convertSRGBToLinear();
  fogN0=(60-30*n)*(1-.5*ov); fogF0=(450-170*n)*(1-.4*ov); scene.fog.near=fogN0; scene.fog.far=fogF0;
  hemi.color.copy(SK.hemiS); hemi.groundColor.copy(SK.hemiG); hemi.intensity=(.3-.17*n)*(1-.15*ov);
  sun.color.copy(SK.sun); sun.intensity=SK.sunI*(1-.6*ov);
  sunO.copy(_sd).lerp(_md,smooth(.35,.8,n)).normalize().multiplyScalar(10); sunO.y=Math.max(sunO.y,1.2);   // sun by day, moon at night; never lights from below
  if(!Q.shadow) sun.position.copy(sunO);
  mtnFar.material.color.copy(SK.mf).convertSRGBToLinear();
  mtnNear.material.color.copy(SK.mn).convertSRGBToLinear();
  ground.material.color.copy(SK.gr);
  renderer.toneMappingExposure=1.0-.1*n; rimL.intensity=Q.rim?.5*(1-.7*n)*(1-.5*wet):0;
  for(const r of [road1,road2]){ r.material.roughness=.88-.5*wet; r.material.userData.e0=.15+.5*wet; r.material.color.setScalar(1-.25*wet); }   // wet asphalt: darker and shinier
  const e=1-.82*n;
  for(const m of envMats) m.envMapIntensity=m.userData.e0*e;   // every lit material, not just the car, loses the daylight reflections at night
  // lights
  M.lamp.emissiveIntensity=1.3*L; M.tail.emissiveIntensity=.05+1.7*L;
  redTail.emissiveIntensity=.15+1.8*L; window.__lampHeadMat.emissiveIntensity=2.2*L;
  carLights.glow.forEach(o=>o.s.material.opacity=o.k*L);
  carLights.spots.forEach(s=>s.intensity=3.2*L);
  carLights.tails.forEach(p=>p.intensity=.45*L);
  carLights.beams.forEach(b=>b.material.uniforms.uOn.value=L);
  lampSprites.forEach(s=>s.material.opacity=.85*L); lampPools.forEach(p=>p.material.opacity=.5*L);
  trafficCars.forEach(t=>t.lamps.forEach(l=>{
    const on=(l.on==='head')===!!t.oncoming; l.s.material.opacity=on?l.k*L:0;
  }));
  blob.material.opacity=.55-.25*n;
}

/* ---------------- rain: falling streaks around the camera (Medium+) and beads of water on the paint and glass (High only) */
const RAIN_N=3200;
const rainU={uCam:{value:new THREE.Vector3()},uT:{value:0},uSpd:{value:0},uAmt:{value:0}};
const rainGeo=new THREE.BufferGeometry();
{ const p=new Float32Array(RAIN_N*6), e=new Float32Array(RAIN_N*2);
  for(let i=0;i<RAIN_N;i++){ const x=Math.random(),y=Math.random(),z=Math.random(); for(let k=0;k<2;k++){ p.set([x,y,z],i*6+k*3); e[i*2+k]=k; } }
  rainGeo.setAttribute('position',new THREE.BufferAttribute(p,3)); rainGeo.setAttribute('aEnd',new THREE.BufferAttribute(e,1)); }
const rainMat=new THREE.ShaderMaterial({uniforms:rainU,transparent:true,depthWrite:false,fog:false,
  vertexShader:`uniform vec3 uCam; uniform float uT; uniform float uSpd; uniform float uAmt; attribute float aEnd; varying float vA;
  void main(){
    vec3 box=vec3(34.,18.,70.); vec3 p=position;
    p.y=fract(p.y-uT*14./box.y); p.z=fract(p.z-uT*uSpd/box.z);
    vec3 w=vec3(uCam.x+(p.x-.5)*box.x, p.y*box.y, uCam.z+p.z*box.z-8.);
    vec3 v=vec3(0.,-14.,-uSpd);
    vec3 pos=w-v*.03*aEnd;
    float dd=distance(w,uCam);
    float keep=step(fract(position.x*91.7+position.z*37.3),uAmt);
    vA=keep*uAmt*(1.-aEnd*.75)*smoothstep(75.,22.,dd)*smoothstep(1.,4.,dd)*.4;
    gl_Position=projectionMatrix*viewMatrix*vec4(pos,1.);
  }`,
  fragmentShader:`varying float vA; void main(){ if(!(vA>.003)) discard; gl_FragColor=vec4(.78,.85,1.,clamp(vA,0.,1.)); }`});
rainMat.userData.glow=true;      // keep the road-bend patch off this shader
const rainMesh=new THREE.LineSegments(rainGeo,rainMat); rainMesh.frustumCulled=false; rainMesh.visible=false; rainMesh.renderOrder=6; scene.add(rainMesh);
function rainFxTick(){
  const on=Q.rainFx&&rainK>.04; rainMesh.visible=on; if(!on) return;
  rainU.uCam.value.copy(camera.position); rainU.uT.value=time%1000; rainU.uSpd.value=speed; rainU.uAmt.value=Math.min(1,rainK*1.15);
  rainGeo.setDrawRange(0,(Q.drops?RAIN_N:Math.floor(RAIN_N/2))*2);
}
let dropTex=null;
function getDropTex(){
  if(dropTex) return dropTex;
  const N=512, c=document.createElement('canvas'); c.width=c.height=N; const g=c.getContext('2d'), im=g.createImageData(N,N), d=im.data;
  for(let i=0;i<N*N;i++){ d[4*i]=128; d[4*i+1]=128; d[4*i+2]=255; d[4*i+3]=255; }
  for(let k=0;k<420;k++){
    const cx=Math.random()*N, cy=Math.random()*N, r=2+Math.pow(Math.random(),2.2)*10;
    for(let y=Math.max(0,Math.floor(cy-r));y<=Math.min(N-1,Math.ceil(cy+r));y++) for(let x=Math.max(0,Math.floor(cx-r));x<=Math.min(N-1,Math.ceil(cx+r));x++){
      const dx=(x-cx)/r, dy=(y-cy)/r, q=dx*dx+dy*dy; if(q>=1) continue;
      const nz=Math.sqrt(1-q), l=Math.hypot(dx*.95,dy*.95,nz), o=4*(y*N+x);
      d[o]=(dx*.95/l*.5+.5)*255; d[o+1]=(dy*.95/l*.5+.5)*255; d[o+2]=(nz/l*.5+.5)*255;
    }
  }
  g.putImageData(im,0,0);
  dropTex=new THREE.CanvasTexture(c); dropTex.wrapS=dropTex.wrapT=THREE.RepeatWrapping; dropTex.repeat.set(5,5);
  dropTex.anisotropy=Math.min(8,renderer.capabilities.getMaxAnisotropy()); return dropTex;
}
function applyDrops(){      // High only: attach the droplet normal map (once per quality change; its strength follows the rain)
  const t=Q.drops?getDropTex():null;
  if(M.paint.clearcoatNormalMap!==t){ M.paint.clearcoatNormalMap=t; M.paint.needsUpdate=true; }
  if(M.glass.normalMap!==t){ M.glass.normalMap=t; M.glass.needsUpdate=true; }
}
function dropsTick(){
  if(!Q.drops) return; const s=smooth(.1,.7,dropK);
  M.paint.clearcoatNormalScale.set(s*1.1,s*1.1); M.glass.normalScale.set(s*1.3,s*1.3);
}

/* ---------------- game state, input, scoring */
const VIEWS2={chase:{p:[0,1.9,-7.4],t:[0,.8,9]},side:{p:[-5.6,.85,.6],t:[0,.55,.8]},front:{p:[2.6,1.0,7.2],t:[0,.6,.2]}};
let view='chase', speedTarget=0, speed=20, dist=0, px=0, yaw=0, vl=0, steer=0, thrS=0, brkS=0, shake=0, inv=0, yr=0, ayS=0, accS=0, fwd=0;
let tStreak=0, weave=0, lastGap=-1, wasOff=false, nextBonus=100000, runT=0, bHeat=0, lastBT=-999, shopOpen=false, bmOpen=false, paintView=false, pvA=.6, titleOn=true, exZone=false, exitCash=0, camFrom=null;
let state='menu', score=0, miles=0, mult=1, clean=0, timeLeft=180, soundAsked=false;
const TIME_CAP=135, BONUS_WIN=20, RUN_T=180, MPH=2.23694, speedK=()=>Math.max(.5,Math.min(2,speed*MPH/80)),   // points scale with speed: x0.5 at 40 mph, x1 at 80, x2 at 160+
  $=id=>document.getElementById(id);
const kmhEl=$('kmh');
function goView(n){ if(!VIEWS2[n])return; view=n; document.querySelectorAll('#views button').forEach(b=>b.classList.toggle('on',b.dataset.v===n)); }
$('views').addEventListener('click',e=>{ if(e.target.dataset.v) goView(e.target.dataset.v); });
const keys={}, tch={l:0,r:0,g:0,b:0}, inRun=()=>state==='run'||state==='exit';   // audio / graphics hotkeys are off while driving: camera only
addEventListener('keydown',e=>{
  if(window.__lbModal){ if(e.code==='Escape'&&window.__lbModal==='lb') closeLB(); return; }
  keys[e.code]=true;
  if(shopOpen||gfxOpen||admOpen){ if(e.code==='Escape'){ if(garageOpen) setGarage(false); else if(bmOpen) setBM(false); else if(admOpen) setAdm(false); else if(gfxOpen) setGfxUI(false); else setShop(false); } return; }
  if(e.code==='Space'||e.code.startsWith('Arrow')) e.preventDefault();
  if(e.code==='KeyE'&&state==='run'){if(runPU.rocket&&rocketCooldown<=0&&!rocketMesh){fireRocket();e.preventDefault();}else if(runPU.nitrous&&!nitrousUsed&&nitrousLeft<=0&&ghostLeft<=0){nitrousUsed=true;nitrousLeft=5;popup('NITROUS · 5 SECONDS','good');e.preventDefault();}else if(runPU.ghost&&!ghostUsed&&ghostLeft<=0&&nitrousLeft<=0){ghostUsed=true;ghostLeft=30;ghostVisual(true);popup('GHOST CHASSIS · 30 SECONDS','good');e.preventDefault();}}
  else if((e.code==='Enter'||e.code==='Space')&&(state==='menu'||state==='over')) requestStartRun();
  else if(e.code==='Escape'&&state==='run') endRun('esc');
  else if(e.code==='KeyG'){ if(!bootCombo()&&!inRun()) cycleGfx(); }
  else if(e.code==='KeyR'){ if(!inRun()) toggleRadio(); }
  else if(e.code==='KeyN'){ if(!inRun()) skipTrack(); }
  else if(e.code==='KeyC'){ if(bootCombo()) return; const n=Object.keys(VIEWS2); goView(n[(n.indexOf(view)+1)%n.length]); }
});
addEventListener('keyup',e=>{keys[e.code]=false});
addEventListener('blur',()=>{for(const k in keys)keys[k]=false});
document.querySelectorAll('#touch button').forEach(b=>{
  const k=b.dataset.k, on=v=>e=>{e.preventDefault();tch[k]=v;b.classList.toggle('dn',!!v)};
  b.addEventListener('pointerdown',on(1)); ['pointerup','pointercancel','pointerleave'].forEach(n=>b.addEventListener(n,on(0)));
});
$('goBtn').addEventListener('click',()=>requestStartRun());

let HS={pts:[],mi:[]};
try{ HS=Object.assign(HS,JSON.parse(localStorage.getItem('cgt_hs')||'{}')); }catch(e){}
function renderHS(){
  const f=(a,fm)=>a.length?a.map(v=>'<li>'+fm(v)+'</li>').join(''):'<li class="e">—</li>';
  $('hsP').innerHTML=f(HS.pts,v=>v.toLocaleString()+' pts'); $('hsM').innerHTML=f(HS.mi,v=>v.toFixed(2)+' mi');
  $('bestP').textContent=(HS.pts[0]||0).toLocaleString(); $('bestM').textContent=(HS.mi[0]||0).toFixed(1);
}
renderHS();
/* wallet: stored in cents. 100,000 points = $5 (1,000 points = 5 cents), banked only by taking an exit. */
const CASH_ON_TIMEOUT=false, centsFor=sc=>Math.floor(sc/200), money=c=>'$'+(c/100).toFixed(2);
let wallet=0; try{ wallet=Math.max(0,Math.floor(+localStorage.getItem('cgt_cash')||0)); }catch(e){}
function renderWallet(){ if(typeof powerView!=='undefined'&&powerView&&document.getElementById('powerWallet')) renderPowerups(); { const e=document.getElementById('tWal'); if(e) e.textContent=money(wallet); } $('walV').textContent=money(wallet); $('wal2').textContent='Wallet '+money(wallet); { const e=document.getElementById('wal3'); if(e) e.textContent='Wallet '+money(wallet); } if(bmOpen) renderBM(); }
function addCash(c){ wallet+=c; try{store.set('cgt_cash',String(wallet))}catch(e){} renderWallet(); }
function setShop(on){ shopOpen=on; if(!on){ leavePaint(); if(bmOpen) setBM(false); } $('shop').classList.toggle('show',on); if(on){ /* Open the shop landing view; submenus appear only after their tab is clicked. */ if(paintView) leavePaint(); setPowerView(false); setCarsView(false); $('paintPanel').style.display='none'; $('powerPanel').style.display='none'; $('carsPanel').style.display='none'; renderPowerups(); } renderWallet(); syncMenuMusic(); }
// Power-ups are purchased individually and consumed at run start when equipped.
const POWERUPS=[
  {id:'insurance',name:'Insurance',icon:'🛡️',desc:'Protects your score and time from your first crash. You still lose speed.',mode:'Automatic'},
  {id:'nitrous',name:'Nitrous Oxide',icon:'💨',desc:'Press E for a 5-second speed burst. Traffic collisions cannot penalize you during the boost.',mode:'Press E'},
  {id:'double',name:'x2 Points',icon:'✖️',desc:'Doubles every points multiplier for the entire run.',mode:'Automatic'},
  {id:'ghost',name:'Ghost Chassis',icon:'👻',desc:'Press E to become translucent and invulnerable for 30 seconds, with a slight speed reduction.',mode:'Press E · 30 seconds'},
  {id:'rocket',name:'RPG Power-up',icon:'🚀',desc:'Fire a rocket with E to blast nearby traffic out of your way. Reloads in 1:30. Unlimited uses.',mode:'Press E · 1:30 reload'}
];
let PU={stock:{insurance:0,nitrous:0,double:0,ghost:0,rocket:0},equipped:{insurance:false,nitrous:false,double:false,ghost:false,rocket:false},ghostUnlocked:false,rocketUnlocked:false};
try{const q=JSON.parse(localStorage.getItem('cgt_powerups')||'null');if(q){PU.stock=Object.assign(PU.stock,q.stock||{});PU.equipped=Object.assign(PU.equipped,q.equipped||{});PU.ghostUnlocked=!!q.ghostUnlocked||((q.stock||{}).ghost||0)>0;PU.rocketUnlocked=!!q.rocketUnlocked;}}catch(e){}
function savePU(){try{store.set('cgt_powerups',JSON.stringify(PU));}catch(e){}}
let powerView=false,loadoutOpen=false,runPU={insurance:false,nitrous:false,double:false,ghost:false,rocket:false},insuranceSpent=false,nitrousLeft=0,nitrousUsed=false,ghostLeft=0,ghostUsed=false,rocketCooldown=0,rocketMesh=null,rocketExplosion=null;
function ghostVisual(active){
  const root=CS.sel==='beta'?betaRoot:gtRoot;
  root.traverse(o=>{ if(!o.isMesh)return;
    if(active){ if(!o.userData._ghostOriginal){ o.userData._ghostOriginal=o.material; const cloneMat=m=>{const c=m.clone();c.transparent=true;c.opacity=Math.min(c.opacity===undefined?1:c.opacity,.32);c.depthWrite=false;return c;}; o.material=Array.isArray(o.material)?o.material.map(cloneMat):cloneMat(o.material); } }
    else if(o.userData._ghostOriginal){ if(Array.isArray(o.material))o.material.forEach(m=>m.dispose&&m.dispose());else if(o.material.dispose)o.material.dispose();o.material=o.userData._ghostOriginal;delete o.userData._ghostOriginal; }
  });
}
function renderPowerups(){
  $('powerWallet').textContent='Wallet '+money(wallet)+' · $20.00 each';
  $('powerRows').innerHTML=POWERUPS.filter(p=>p.id!=='ghost'&&(p.id!=='rocket'||PU.rocketUnlocked)).map(p=>'<div class="pup"><span class="pi">'+p.icon+'</span><div class="pd"><b>'+p.name+'</b><small>'+p.desc+'</small><small>'+(p.id==='rocket'?'Unlimited stock · unlocked': 'In stock: '+(PU.stock[p.id]||0)+' · '+p.mode)+'</small></div>'+(p.id==='rocket'?'<span class="nb">UNLOCKED</span>':'<button type="button" data-buy-pu="'+p.id+'" '+(wallet<2000?'disabled':'')+'>Buy $20</button>')+'</div>').join('');
}
let carsView=false;
function setPowerView(on){powerView=on;if(on){carsView=false;$('carsPanel').style.display='none';$('paintPanel').style.display='none';} $('powerPanel').style.display=on?'block':'none';$('itemPaint').style.opacity='1';$('itemPower').style.opacity='1';$('itemCars').style.opacity='1';}
function setCarsView(on){carsView=on;if(on){powerView=false;$('powerPanel').style.display='none';$('paintPanel').style.display='none';renderCarShop();} $('carsPanel').style.display=on?'block':'none';$('itemPaint').style.opacity='1';$('itemPower').style.opacity='1';$('itemCars').style.opacity='1';}
$('itemPower').addEventListener('click',()=>{leavePaint();setCarsView(false);setPowerView(true);});
$('itemPaint').addEventListener('click',()=>{setCarsView(false);setPowerView(false);enterPaint();});
$('itemCars').addEventListener('click',()=>{leavePaint();setCarsView(true);});
$('powerRows').addEventListener('click',e=>{const b=e.target.closest('[data-buy-pu]');if(!b)return;const id=b.dataset.buyPu;if(!POWERUPS.some(p=>p.id===id)||!spend(2000))return;PU.stock[id]=(PU.stock[id]||0)+1;savePU();renderPowerups();popup('POWER-UP PURCHASED','good');});
function renderLoadout(){ $('loadRows').innerHTML=POWERUPS.filter(p=>(p.id!=='ghost'||PU.ghostUnlocked)&&(p.id!=='rocket'||PU.rocketUnlocked)).map(p=>{const n=PU.stock[p.id]||0,checked=p.id==='rocket'?!!PU.equipped.rocket:!!PU.equipped[p.id]&&n>0;return '<label class="loadrow"><span class="li">'+p.icon+'</span><span class="ld"><b>'+p.name+'</b><small>'+p.desc+' · '+(p.id==='rocket'?'Unlimited uses':('Owned: '+n+(p.id==='ghost'?' · Black Market good':'')))+'</small></span><input type="checkbox" data-equip-pu="'+p.id+'" '+(checked?'checked':'')+' '+(p.id==='rocket'?'':' '+(n<1?'disabled':''))+'></label>';}).join(''); }
$('loadRows').addEventListener('change',e=>{const id=e.target.dataset.equipPu;if(!id)return;if(e.target.checked&&id==='rocket'){for(const k of Object.keys(PU.equipped))PU.equipped[k]=false;PU.equipped.rocket=true;popup('RPG REPLACES ALL OTHER POWER-UPS','good');}else{if(e.target.checked&&PU.equipped.rocket){PU.equipped.rocket=false;popup('RPG UNEQUIPPED','good');}if(e.target.checked&&id==='ghost'&&PU.equipped.nitrous){PU.equipped.nitrous=false;popup('GHOST CHASSIS REPLACES NITROUS','good');}if(e.target.checked&&id==='nitrous'&&PU.equipped.ghost){PU.equipped.ghost=false;popup('NITROUS REPLACES GHOST CHASSIS','good');}PU.equipped[id]=!!e.target.checked;}savePU();renderLoadout();});
function requestStartRun(){ if(loadoutOpen||state==='run'||state==='exit')return; renderLoadout();loadoutOpen=true;$('loadout').classList.add('show'); }
$('loadCancel').addEventListener('click',()=>{loadoutOpen=false;$('loadout').classList.remove('show');});
$('loadStart').addEventListener('click',()=>{if(!loadoutOpen)return;loadoutOpen=false;$('loadout').classList.remove('show');startRun();});

/* secret: tiny pixel smiley in the shop corner -> "ask me:" -> answer "anything" -> black market (placeholder, prices in cents) */
/* "Beta Car" = playable version of the legacy boxy traffic car (see buildBeta). Purchasable here; once owned it shows up in the Garage.
   Entries are [name, price in cents, optional subtitle, optional car id (purchasable)]. */
const BM_ITEMS=[['Beta Car',1000000,'Old traffic cars from testing builds!','beta'],['Nitro Overdrive',500000],['Time Warp +60 s',750000],['Ghost Chassis',20000,'30 seconds of translucency and collision immunity. Cannot be equipped with Nitrous.','ghost'],['Dual Paint',200000,'Unlocks two independent custom colours: one for each side of your car.','dualpaint'],['Rocket Boosters',1500000],['Score x5 Forever',2500000],['Gold-Plated Everything',5000000]];
let tipTotal=0,tipNext=1,tipGoalReached=false;
try{const saved=JSON.parse(localStorage.getItem('cgt_scout_tipjar')||'null');if(saved){tipTotal=Math.max(0,Math.floor(saved.total||0));tipNext=Math.max(1,Math.floor(saved.next||1));tipGoalReached=!!saved.done||tipTotal>=1000000;}}catch(e){}
function saveTipJar(){if(ADMIN)return;try{localStorage.setItem('cgt_scout_tipjar',JSON.stringify({total:tipTotal,next:tipNext,done:tipGoalReached}));}catch(e){}}
if(tipGoalReached){PU.rocketUnlocked=true;savePU();}
function renderTipJar(){
  const progress=Math.min(1,tipTotal/1000000), coinCount=Math.floor(progress*35);
  const spots=[];const xs=[54,72,90,108,126],ys=[123,111,99,87,75,63,51];
  for(let r=0;r<ys.length;r++)for(let c=0;c<xs.length;c++)spots.push([xs[c]+(r%2?4:0),ys[r]]);
  const coins=spots.slice(0,coinCount).map(([x,y],i)=>'<g><circle cx="'+x+'" cy="'+y+'" r="7.2" fill="'+(i%3===0?'#f8d36f':'#d99b35')+'" stroke="#8b571b" stroke-width="1.4"/><circle cx="'+x+'" cy="'+y+'" r="4.4" fill="none" stroke="#ffebaa" stroke-width="1" opacity=".8"/></g>').join('');
  return '<section class="tipjar-card"><svg class="tipjar-art" viewBox="0 0 180 158" role="img" aria-label="Glass tip jar with '+coinCount+' coins inside"><defs><clipPath id="tipJarClip"><path d="M43 37 Q43 30 54 30 H126 Q137 30 137 42 V128 Q137 139 126 139 H54 Q43 139 43 128Z"/></clipPath><linearGradient id="tipGlass" x1="0" x2="1"><stop offset="0" stop-color="#bceaff" stop-opacity=".12"/><stop offset=".5" stop-color="#e6f8ff" stop-opacity=".34"/><stop offset="1" stop-color="#9edbff" stop-opacity=".1"/></linearGradient></defs><path d="M62 12 H118 V25 Q118 30 130 34 Q145 39 145 51 V128 Q145 147 126 147 H54 Q35 147 35 128 V51 Q35 39 50 34 Q62 30 62 25Z" fill="url(#tipGlass)" stroke="#c7e9f7" stroke-width="4"/><path d="M58 12 H122 V27 H58Z" fill="#9ac8da" fill-opacity=".35" stroke="#c7e9f7" stroke-width="3"/><g clip-path="url(#tipJarClip)">'+coins+'</g><path d="M47 47 V125 Q47 135 57 135" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="3" stroke-linecap="round"/><path d="M134 54 V119" fill="none" stroke="#fff" stroke-opacity=".22" stroke-width="2" stroke-linecap="round"/><path d="M68 20 H112" stroke="#e7f8ff" stroke-width="2" stroke-linecap="round" opacity=".8"/></svg><div class="tipjar-copy"><strong>Scout’s Tip Jar</strong><small>Help fill the jar for a mystery surprise!</small><span class="tipjar-next">'+(tipGoalReached?'GOAL REACHED':'Next tip: '+money(tipNext))+'</span><small>Raised: '+money(tipTotal)+' / $10,000.00</small><div class="tipjar-track"><span style="width:'+(progress*100)+'%"></span></div><small>'+Math.floor(progress*100)+'% full · '+coinCount+' coins in the jar</small></div>'+(tipGoalReached?'<small style="grid-column:1/-1">Scout has enough for a surprise!</small>':'<button type="button" class="tipjar-donate" data-tipjar="1">Drop in '+money(tipNext)+'</button>')+'</section>';
}
function renderBM(){
  $('bmItems').innerHTML=BM_ITEMS.map(([n,c,s,id])=>{
    const price='$'+(c/100).toLocaleString();
    if(id==='ghost'){const nOwned=PU.stock.ghost||0;return '<button type="button" class="bmbuy" data-bm="ghost">'+n+'<b>'+price+'</b>'+(s?'<small>'+s+'</small>':'')+'<small>'+(nOwned?'Unlocked · in stock: '+nOwned+' · buy another':wallet<c?'Need '+money(c-wallet)+' more':'Tap to unlock and buy')+'</small></button>'; }
    if(!id) return '';
    if(id==='dualpaint'){const unlocked=!!(PS&&PS.dualUnlocked);return '<button type="button" class="bmbuy'+(unlocked?' own':'')+'" data-bm="dualpaint">'+n+'<b>'+(unlocked?'Unlocked':price)+'</b>'+(s?'<small>'+s+'</small>':'')+'<small>'+(unlocked?'Available in Paint menu':wallet<c?'Need '+money(c-wallet)+' more':'Tap to unlock')+'</small></button>';}
    const own=CS.owned.includes(id);
    return '<button type="button" class="bmbuy'+(own?' own':'')+'" data-car="'+id+'">'+n+'<b>'+(own?'Owned':price)+'</b>'+(s?'<small>'+s+'</small>':'')
      +'<small>'+(own?'In your garage':wallet<c?'Need '+money(c-wallet)+' more':'Tap to buy')+'</small></button>';
  }).join('') + renderTipJar();
}
$('bmItems').addEventListener('click',e=>{
  const tip=e.target.closest('[data-tipjar]');if(tip){if(tipGoalReached)return;if(!spend(tipNext)){popup('NOT ENOUGH CASH','bad');return;}tipTotal+=tipNext;tipNext*=2;tipGoalReached=tipTotal>=1000000;if(tipGoalReached){PU.rocketUnlocked=true;PU.equipped.rocket=false;savePU();}saveTipJar();renderBM();if(tipGoalReached)renderPowerups();typeScoutLine(tipGoalReached?'I have something that goes and makes an Kaboom!':'one tiny step closer to a surprise.');return;}
  const b=e.target.closest('.bmbuy'); if(!b) return;
  if(b.dataset.bm==='ghost'){const it=BM_ITEMS.find(x=>x[3]==='ghost');if(!it||!spend(it[1]))return;PU.stock.ghost=(PU.stock.ghost||0)+1;PU.ghostUnlocked=true;savePU();renderBM();renderWallet();popup('GHOST CHASSIS ACQUIRED','good');return;}
  if(b.dataset.bm==='dualpaint'){if(PS.dualUnlocked)return;const it=BM_ITEMS.find(x=>x[3]==='dualpaint');if(!it||!spend(it[1]))return;PS.dualUnlocked=true;if(!PS.owned.includes('dualpaint'))PS.owned.push('dualpaint');savePaint();renderBM();renderWallet();popup('DUAL PAINT UNLOCKED','good');return;}
  const it=BM_ITEMS.find(x=>x[3]===b.dataset.car); if(!it||CS.owned.includes(it[3])) return;
  if(!spend(it[1])) return;
  CS.owned.push(it[3]); saveCars(); renderBM(); popup(it[0]+' added to your garage','good');
});
const SCOUT_LINES=["Yo, I'm scout. Purchase one of my totally legit goods please",'what do you mean ripping you off?','I wonder what the cars taste like.','Tonight on top gea-wait wrong thing.','Very cheap new beta car for sale great deal totally!','Anyone named silas is pretty cool','Some random kid created me, idk why','Keep that V10 safe. Would be a shame if someone stole it right out of the bay.','Your car is an supercar.','I could use some mac & cheese right about now.','Your paint looks cool bud'];
let scoutAudioCtx=null; function scoutBlip(){ try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;if(!scoutAudioCtx)scoutAudioCtx=new AC();if(scoutAudioCtx.state==='suspended')scoutAudioCtx.resume();const t=scoutAudioCtx.currentTime,base=620+Math.random()*520, dur=.052+Math.random()*.018, master=scoutAudioCtx.createGain(),tone=scoutAudioCtx.createBiquadFilter(),voice=scoutAudioCtx.createOscillator(),buzz=scoutAudioCtx.createOscillator(),env=scoutAudioCtx.createGain();tone.type='bandpass';tone.frequency.setValueAtTime(1050+Math.random()*950,t);tone.Q.setValueAtTime(.8+Math.random()*1.4,t);voice.type='sawtooth';voice.frequency.setValueAtTime(base,t);voice.frequency.exponentialRampToValueAtTime(base*(.78+Math.random()*.12),t+dur);buzz.type='triangle';buzz.frequency.setValueAtTime(base*(1.98+Math.random()*.04),t);buzz.detune.setValueAtTime((Math.random()-.5)*24,t);env.gain.setValueAtTime(.0001,t);env.gain.linearRampToValueAtTime(.28+Math.random()*.07,t+.006);env.gain.exponentialRampToValueAtTime(.0001,t+dur);voice.connect(tone);buzz.connect(tone);tone.connect(env);env.connect(master);master.gain.setValueAtTime(1.65,t);master.connect(scoutAudioCtx.destination);voice.start(t);buzz.start(t);voice.stop(t+dur+.005);buzz.stop(t+dur+.005);}catch(e){} } function typeScoutLine(line){const el=$('scoutLine');if(!el)return;el.textContent='';el.classList.add('typing');let i=0;const tick=()=>{if(!bmOpen)return;if(i>=line.length){el.classList.remove('typing');return;}const ch=line[i++];el.textContent+=ch;if(ch!==' '&&ch!=='\n')scoutBlip();setTimeout(tick,/[,.;!?]/.test(ch)?115:27+Math.random()*9);};tick();} function setBM(on){ bmOpen=on; $('bm').classList.toggle('show',on); renderWallet(); if(on){renderBM();typeScoutLine(PU.rocketUnlocked?'I have something that goes and makes an Kaboom!':SCOUT_LINES[Math.floor(Math.random()*SCOUT_LINES.length)]);} syncMenuMusic(); }
/* ---------------- garage: shows only the cars you own (the Carrera GT, plus the Beta Car once bought). Reuses the showroom orbit camera. */
let garageOpen=false;
function renderGarage(){
  const own=CARS.filter(c=>CS.owned.includes(c.id));
  $('gCount').textContent=own.length+(own.length===1?' car':' cars');
  $('gList').innerHTML=own.map(c=>{ const spec=c.id==='beta'?'310 MPH · ~1 s 0–60 · impact immunity · UNRANKED':'205 MPH · ~3.9 s 0–60 · standard scoring'; return '<button type="button" class="gcar'+(CS.sel===c.id?' eq':'')+'" data-id="'+c.id+'"><span class="gn">'+c.name+'</span><span class="gd">'+c.desc+'<br><small>'+spec+'</small></span><span class="gs">'+(CS.sel===c.id?'Selected':'Select')+'</span></button>'; }).join('');
}
function setGarage(on){
  if(on===garageOpen) return; garageOpen=on; shopOpen=on; paintView=on;
  document.body.classList.toggle('pv',on); $('garage').classList.toggle('show',on); if(on) renderGarage();
}
$('gList').addEventListener('click',e=>{ const b=e.target.closest('.gcar'); if(!b||!CS.owned.includes(b.dataset.id)) return; CS.sel=b.dataset.id; saveCars(); applyCar(); renderGarage(); });
$('gBack').addEventListener('click',()=>setGarage(false));
$('garageBtn').addEventListener('click',()=>setGarage(true)); $('tGarage').addEventListener('click',()=>setGarage(true));
$('smile').addEventListener('click',()=>{ const a=prompt('ask me:'); if(a===null) return; if(a.trim().toLowerCase()==='anything') setBM(true); else alert('wrong answer'); });
$('bmClose').addEventListener('click',()=>setBM(false));
$('shopBtn').addEventListener('click',()=>setShop(true)); $('shopClose').addEventListener('click',()=>setShop(false));
renderWallet(); renderPowerups();
/* ---------------- paint shop. Prices in cents. Rainbow + special $50, premium (real Carrera GT factory colours) $200, custom $400. */
const PRICE={special:5000,rainbow:5000,premium:20000,custom:40000};
const FIN={metal:{m:.9,r:.3,cc:1,ccr:.025,fl:.22},gloss:{m:.35,r:.24,cc:1,ccr:.03,fl:.06},matte:{m:.55,r:.62,cc:0,ccr:.3,fl:.1},
           chrome:{m:1,r:.05,cc:1,ccr:.02,fl:0},pearl:{m:.5,r:.25,cc:1,ccr:.03,fl:.14}};
const PAINTS=[
 ['seal','special','Seal Grey Metallic','#848a93','metal',0],
 ['pearl','special','Pearl White','#ecebe6','pearl'],['gunmetal','special','Gunmetal','#4a4f57','metal'],
 ['satin','special','Satin Graphite','#3a3d42','matte'],['gold','special','Champagne Gold','#c9b27c','metal'],['chrome','special','Mirror Chrome','#d8dce2','chrome'],
 ['red','rainbow','Red','#d1121b','gloss'],['orange','rainbow','Orange','#ff6a00','gloss'],['yellow','rainbow','Yellow','#ffd400','gloss'],
 ['green','rainbow','Green','#12a34a','gloss'],['blue','rainbow','Blue','#1457d9','gloss'],['indigo','rainbow','Indigo','#3a2fa8','gloss'],['violet','rainbow','Violet','#8a2be2','gloss'],
 ['basalt','premium','Basalt Black Metallic','#1b1d21','metal'],['gtsilver','premium','GT Silver Metallic','#b7bcc4','metal'],
 ['fayence','premium','Fayence Yellow','#e4c847','gloss'],['guards','premium','Guards Red','#c4121a','gloss'],['black','premium','Black','#0a0a0b','gloss']
].map(a=>({id:a[0],grp:a[1],name:a[2],c:a[3],fin:a[4],price:a[5]!==undefined?a[5]:PRICE[a[1]]}));
const GROUPS=[['special','Special shades · $50 each'],['rainbow','Rainbow · $50 each'],['premium','Premium · factory Carrera GT colours · $200 each'],['custom','Custom colour · $400']];
let PS={owned:['seal'],sel:'seal',cc:'#ff3d7f',cf:'metal',dualUnlocked:false,dc:'#246bce',df:'metal',dualFin2:'metal'}, pvId='seal';
try{ const j=JSON.parse(localStorage.getItem('cgt_paint')||'null');
  if(j&&Array.isArray(j.owned)){ PS.owned=['seal',...j.owned.filter(x=>x!=='seal'&&(x==='custom'||x==='dualpaint'||PAINTS.some(p=>p.id===x)))]; if(PS.owned.includes(j.sel)) PS.sel=j.sel;
    if(/^#[0-9a-f]{6}$/i.test(j.cc)) PS.cc=j.cc; if(FIN[j.cf]) PS.cf=j.cf; PS.dualUnlocked=!!j.dualUnlocked; if(/^#[0-9a-f]{6}$/i.test(j.dc)) PS.dc=j.dc; if(FIN[j.df]) PS.df=j.df; if(FIN[j.dualFin2]) PS.dualFin2=j.dualFin2; } }catch(e){}
function savePaint(){ try{store.set('cgt_paint',JSON.stringify(PS))}catch(e){} }
function paintDef(id){ return id==='custom'?{id:'custom',grp:'custom',name:'Custom colour',c:PS.cc,fin:PS.cf,price:PRICE.custom}:id==='dualpaint'?{id:'dualpaint',grp:'custom',name:'Dual Paint',c:PS.cc,fin:PS.cf,c2:PS.dc,fin2:PS.df,price:0}:(PAINTS.find(p=>p.id===id)||PAINTS[0]); }
function applyPaint(d){ const f=FIN[d.fin], m=M.paint;
  m.color.set(d.c); m.metalness=f.m; m.roughness=f.r; m.clearcoat=Q.coat?f.cc:0; m.clearcoatRoughness=f.ccr; m.normalMap=Q.flake?flake:null; m.normalScale.set(f.fl,f.fl);
  m.onBeforeCompile=shader=>{ if(d.id!=='dualpaint') return; const f2=FIN[d.fin2]||FIN.metal; shader.uniforms.uDualColor={value:new THREE.Color(d.c2)}; shader.uniforms.uDualRoughness={value:f2.r}; shader.uniforms.uDualMetalness={value:f2.m}; shader.vertexShader=shader.vertexShader.replace('#include <common>','#include <common>\nvarying float vDualSide;').replace('#include <begin_vertex>','#include <begin_vertex>\nvDualSide = sign(position.x);'); shader.fragmentShader=shader.fragmentShader.replace('#include <common>','#include <common>\nvarying float vDualSide; uniform vec3 uDualColor; uniform float uDualRoughness; uniform float uDualMetalness;').replace('#include <color_fragment>','#include <color_fragment>\nif(vDualSide > 0.0) diffuseColor.rgb = uDualColor;').replace('#include <roughnessmap_fragment>','#include <roughnessmap_fragment>\nif(vDualSide > 0.0) roughnessFactor = uDualRoughness;').replace('#include <metalnessmap_fragment>','#include <metalnessmap_fragment>\nif(vDualSide > 0.0) metalnessFactor = uDualMetalness;'); };
  m.customProgramCacheKey=()=>d.id==='dualpaint'?'dualpaint-split-v1':'single-paint-v1'; m.needsUpdate=true; }
const dotCss=d=>d.fin==='chrome'?'linear-gradient(135deg,#fff,#8f97a4 45%,#f6f8fb)':'radial-gradient(circle at 30% 28%,rgba(255,255,255,'+(d.fin==='matte'?.12:.5)+'),transparent 40%),'+d.c;
function spend(c){ if(wallet<c) return false; wallet-=c; try{store.set('cgt_cash',String(wallet))}catch(e){} renderWallet(); return true; }
function renderPaint(keepScroll){
  const list=$('ppList'), st=list.scrollTop; $('ppWal').textContent='Wallet '+money(wallet);
  let h='';
  for(const [g,label] of GROUPS){
    h+='<h3>'+label+'</h3><div class="sws">';
    for(const d of (g==='custom'?[paintDef('custom'),...(PS.dualUnlocked?[paintDef('dualpaint')]:[])]:PAINTS.filter(p=>p.grp===g))){
      const own=PS.owned.includes(d.id);
      h+='<button type="button" class="sw'+(own?' own':'')+(PS.sel===d.id?' eq':'')+(pvId===d.id?' pv':'')+'" data-id="'+d.id+'"><span class="dot" style="background:'+dotCss(d)+'"></span><span class="nm">'+d.name+'</span><span class="pr">'+(PS.sel===d.id?'Equipped':own?'Owned':money(d.price))+'</span></button>';
    }
    h+='</div>';
  }
  list.innerHTML=h; if(keepScroll) list.scrollTop=st;
  const d=paintDef(pvId), own=PS.owned.includes(pvId), b=$('ppBuy');
  $('ppName').textContent=d.name; $('ppCustom').hidden=pvId!=='custom'&&pvId!=='dualpaint'; $('dualControls').hidden=pvId!=='dualpaint';
  if(pvId==='custom'||pvId==='dualpaint'){ $('ppCol').value=PS.cc; $('ppFin').value=PS.cf; $('ppCol2').value=PS.dc; $('ppFin2').value=PS.df; }
  $('ppNote').textContent='';
  if(PS.sel===pvId){ b.textContent='Equipped'; b.disabled=true; }
  else if(own){ b.textContent='Equip'; b.disabled=false; }
  else { b.textContent='Buy · '+money(d.price); b.disabled=wallet<d.price; if(b.disabled) $('ppNote').textContent='Need '+money(d.price-wallet)+' more — take exits to bank cash'; }
}
function equipPaint(id){ PS.sel=id; savePaint(); applyPaint(paintDef(id)); $('paintSub').textContent=paintDef(id).name; }
function pickPaint(id){ pvId=id; applyPaint(paintDef(id)); if(PS.owned.includes(id)) equipPaint(id); renderPaint(true); }
$('ppList').addEventListener('click',e=>{ const b=e.target.closest('.sw'); if(b) pickPaint(b.dataset.id); });
$('ppBuy').addEventListener('click',()=>{
  if(PS.owned.includes(pvId)){ equipPaint(pvId); }
  else if(spend(paintDef(pvId).price)){ PS.owned.push(pvId); equipPaint(pvId); }
  renderPaint(true);
});
function customChanged(){ PS.cc=$('ppCol').value; PS.cf=$('ppFin').value; PS.dc=$('ppCol2').value||PS.dc; PS.df=$('ppFin2').value||PS.df; const d=paintDef(pvId==='dualpaint'?'dualpaint':'custom'); if(pvId==='dualpaint'||PS.sel==='custom') applyPaint(d);
  if(PS.owned.includes('custom')||PS.dualUnlocked) savePaint();
  const dot=document.querySelector('.sw[data-id="custom"] .dot'); if(dot) dot.style.background=dotCss(paintDef('custom')); }
$('ppCol').addEventListener('input',customChanged); $('ppFin').addEventListener('change',customChanged); $('ppCol2').addEventListener('input',customChanged); $('ppFin2').addEventListener('change',customChanged);
function enterPaint(){ paintView=true; powerView=false; carsView=false; $('powerPanel').style.display='none'; $('carsPanel').style.display='none'; $('paintPanel').style.display=''; pvId=PS.sel; document.body.classList.add('pv'); $('shop').classList.add('paint'); renderPaint(false); }
function leavePaint(){ if(!paintView) return; paintView=false; $('paintPanel').style.display=''; document.body.classList.remove('pv'); $('shop').classList.remove('paint'); applyPaint(paintDef(PS.sel)); }
$('ppBack').addEventListener('click',leavePaint);
applyPaint(paintDef(PS.sel)); $('paintSub').textContent=paintDef(PS.sel).name;
function popup(txt,cls){ const d=document.createElement('div'); d.className='pop '+cls; d.textContent=txt; $('pops').appendChild(d); setTimeout(()=>d.remove(),1500); }
function fixGear(){ eng.gear=0; while(eng.gear<5&&ECFG.ratio[eng.gear]*speed>ECFG.redline*.55) eng.gear++; eng.rpm=Math.max(ECFG.idle,ECFG.ratio[eng.gear]*speed); eng.sT=-1; }
function startRun(){
  ghostLeft=0;ghostUsed=false;ghostVisual(false);runPU={insurance:false,nitrous:false,double:false,ghost:false,rocket:false};rocketCooldown=0;clearRocket();for(const p of POWERUPS){if(p.id==='rocket'){if(PU.rocketUnlocked&&PU.equipped.rocket)runPU.rocket=true;}else if(PU.equipped[p.id]&&(PU.stock[p.id]||0)>0){runPU[p.id]=true;PU.stock[p.id]--;}PU.equipped[p.id]=false;}if(runPU.rocket){runPU={insurance:false,nitrous:false,double:false,ghost:false,rocket:true};}savePU();insuranceSpent=false;nitrousLeft=0;nitrousUsed=false;$('powerHud').classList.remove('show');
  biomeBase=dist; biomeSeed=Math.random(); _bc=[0]; _lastBi=-1;      // biomes restart: open highway first, then a fresh random order
  leaveTitle(); goView('chase'); if(window.__rainLock===undefined) rainPlan(); state='run'; score=0; miles=0; mult=1; clean=0; timeLeft=RUN_T; speed=20; yaw=0; px=0; vl=0; steer=0; inv=2.5;
  runDist=0; exitT=0; $('cine').classList.remove('on'); $('cineCap').classList.remove('in'); firstCam=true;
  trafficCars.forEach(t=>{ if(t.oncoming){ respawn(t,true); t.g.visible=true; } }); resetRows(); weave=0; tStreak=0; lastGap=-1; nextBonus=100000; runT=0; bHeat=0; lastBT=-999; fixGear(); $('ov').classList.add('hide');
  if(!eng.on&&!eng.manualOff) setSound(true);
  if(!radio.manualOff){ if(!radio.on) setRadio(true); else if(radio.a.paused) radio.a.play().catch(()=>{}); }
}
function recordRun(){                       // high-score tables; returns the "new record" notes
  if(!CAR_STATS[CS.sel].leaderboard) return []; // Black Market cars never write local or online records
  const sc=Math.floor(score), nb=[];
  if(sc>0&&sc>(HS.pts[0]||0)) nb.push('New points record!');
  if(miles>.01&&miles>(HS.mi[0]||0)) nb.push('New miles record!');
  if(sc>0){HS.pts.push(sc);HS.pts.sort((a,b)=>b-a);HS.pts.length=Math.min(5,HS.pts.length)}
  if(miles>.01){HS.mi.push(+miles.toFixed(3));HS.mi.sort((a,b)=>b-a);HS.mi.length=Math.min(5,HS.mi.length)}
  try{store.set('cgt_hs',JSON.stringify(HS))}catch(e){}
  renderHS(); return nb;
}
function showOver(title,html,cashed){
  $('ovt').textContent=title; $('ovb').innerHTML=html; $('goBtn').textContent='Drive again'; $('ov').classList.remove('hide');
  $('cine').classList.remove('on'); $('cineCap').classList.remove('in'); renderWallet();
  if(cashed){ const el=$('ovb').querySelector('b'), t0=performance.now();      // count the cash up
    (function tick(){ const f=Math.min(1,(performance.now()-t0)/1300), e=1-Math.pow(1-f,3); el.textContent='+'+money(Math.round(exitCash*e)); if(f<1&&state==='over') requestAnimationFrame(tick); })(); }
}
function endRun(why){
  ghostLeft=0;ghostVisual(false);
  if(why==='exit'){ if(isBetaCar()){ state='over'; showOver('Black Market run','<b>UNRANKED</b><div class="nb">Beta Car · no cash or leaderboard records</div>',false); return; } state='over'; const sc=Math.floor(score); showOver('Cashed out!','<b>+'+money(exitCash)+'</b><div class="nb">'+sc.toLocaleString()+' pts banked · '+miles.toFixed(2)+' mi</div>',true); return; }
  if(why==='esc'){ state='over'; showOver('Run abandoned','<div class="nb">Quit early - nothing was recorded</div>',false); return; }   // quitting counts for nothing: no records, miles or leaderboard stats
  state='over'; const sc=Math.floor(score); let extra='';
  if(!CAR_STATS[CS.sel].leaderboard){ showOver('Black Market run','<b>UNRANKED</b><div class="nb">Beta Car · no points, cash, or leaderboard records</div><div class="nb">'+miles.toFixed(2)+' mi travelled</div>',false); return; }
  if(CASH_ON_TIMEOUT&&sc>0) addCash(centsFor(sc));
  else if(sc>=1000) extra='<div class="nb" style="color:#ff9b8f">'+money(centsFor(sc))+' not cashed — take an exit to bank your points</div>';
  const nb=recordRun();
  showOver('Run complete','<b>'+sc.toLocaleString()+'</b> pts · <b>'+miles.toFixed(2)+'</b> mi'+(nb.length?'<div class="nb">'+nb.join(' · ')+'</div>':'')+extra,false);
}
/* taking the exit: bank the points, then a short front-facing cinematic while the car rolls down the ramp */
const CINE_T=7;
function startExit(E){
  if(!CAR_STATS[CS.sel].leaderboard) return; // no cash-out or banking for the Beta Car
  state='exit'; exitAt=E; exitT=0; exitCash=centsFor(Math.floor(score)); addCash(exitCash); recordRun();
  mult=1; weave=0; shake=0; inv=0;
  camFrom={p:camera.position.clone(),l:_lk.clone(),fov:camera.fov};
  trafficCars.forEach(t=>{ t.g.visible=false; });
  $('cine').classList.add('on'); popup('EXIT '+Math.round(E/EX),'good');
  setTimeout(()=>{ if(state==='exit'){ $('cineCap').innerHTML='Exit '+Math.round(E/EX)+'<em>+'+money(exitCash)+'</em>'; $('cineCap').classList.add('in'); } },2600);
}
function crash(label,rel){
  if(isBetaCar()||ghostLeft>0||inv>0||state!=='run') return;
  if(runPU.insurance&&!insuranceSpent){insuranceSpent=true;inv=1.6;shake=1;popup('INSURANCE USED · NO SCORE OR TIME LOST','good');$('flash').style.opacity=.35;setTimeout(()=>{$('flash').style.opacity=0},120);return;}
  const rm=Math.max(0,rel)*MPH, pct=Math.min(.4,.08+rm*.004);      // 8-40% of your current score, harder the faster you hit
  const pen=Math.min(Math.floor(score),Math.round(1000+rm*30+score*pct));
  score-=pen; mult=1; clean=0; tStreak=0; timeLeft=Math.max(0,timeLeft-20); inv=1.6; shake=1; weave=0; lastGap=-1;
  popup((pen?'−'+pen.toLocaleString()+'  ':'')+'−20s  '+label,'bad');
  $('flash').style.opacity=.55; setTimeout(()=>{$('flash').style.opacity=0},120); pop(.9,3);
}
/* TIME is earned by clean driving: every thread / wall cleared adds seconds, and the reward grows with an unbroken streak (up to 3.7 s per row).
   A crash or a missed gap breaks the streak, and a crash also costs 4 s. At full difficulty a row passes every 90/(speed - traffic) s, so a long
   streak at ~100+ mph earns more time than it burns - in theory you can go forever - while sloppy driving slowly bleeds the clock. */
function gainTime(base){ if(isBetaCar()) return 0; tStreak++; const g=base+.3*Math.min(8,tStreak-1); timeLeft=Math.min(TIME_CAP,timeLeft+g); return g; }
function threadGap(r){
  if(isBetaCar()) return;
  const ch=lastGap>=0&&r.gap!==lastGap; weave=ch?Math.min(8,weave+1):1; lastGap=r.gap;
  const b=Math.round(400*mult*(runPU.double?2:1)*weave*speedK()); score+=b;
  const ts=gainTime(1.3); popup((weave>1?'WEAVE x'+weave:'THREAD THE GAP')+'  +'+b.toLocaleString()+'  ·  +'+ts.toFixed(1)+'s','good');
}
// Scout's RPG: a reusable rocket, one shot every 90 seconds.
const rocketMat=new THREE.MeshStandardMaterial({color:0x2d343b,metalness:.65,roughness:.32,emissive:0x351008});
const rocketTipMat=new THREE.MeshStandardMaterial({color:0xff8a32,emissive:0xff4b12,emissiveIntensity:1.8});
function clearRocket(){if(rocketMesh){scene.remove(rocketMesh);rocketMesh.traverse(o=>{if(o.geometry)o.geometry.dispose();});rocketMesh=null;}if(rocketExplosion){scene.remove(rocketExplosion);rocketExplosion.traverse(o=>{if(o.geometry)o.geometry.dispose();});rocketExplosion=null;}}
function fireRocket(){if(!runPU.rocket||rocketCooldown>0||rocketMesh)return;const g=new THREE.Group();const body=new THREE.Mesh(new THREE.CylinderGeometry(.13,.16,1.35,8),rocketMat);body.rotation.x=Math.PI/2;g.add(body);const nose=new THREE.Mesh(new THREE.ConeGeometry(.16,.42,8),rocketTipMat);nose.rotation.x=Math.PI/2;nose.position.z=.82;g.add(nose);const flame=new THREE.Mesh(new THREE.ConeGeometry(.11,.42,8),rocketTipMat);flame.rotation.x=-Math.PI/2;flame.position.z=-.82;g.add(flame);g.position.set(px,1.15,3);scene.add(g);rocketMesh=g;rocketCooldown=90;popup('RPG FIRED · RELOADING 1:30','good');}
function detonateRocket(x,z){const blast=new THREE.Group();const sphere=new THREE.Mesh(new THREE.SphereGeometry(1,16,12),new THREE.MeshBasicMaterial({color:0xffa33b,transparent:true,opacity:.72,depthWrite:false}));blast.add(sphere);blast.position.set(x,1.1,z);scene.add(blast);rocketExplosion={group:blast,age:0};for(const t of trafficCars){if(!t.g.visible||t.gone)continue;const dx=t.x-x,dz=t.z-z,d=Math.hypot(dx,dz);if(d<15){const dir=dx===0?(Math.random()<.5?-1:1):Math.sign(dx);t.crashT=1.35;t.vx=dir*(8+Math.random()*5)*(1-d/18);t.spin=dir*(5+Math.random()*4);t.gone=false;t.g.visible=true;}}popup('KABOOM! PATH CLEARED','good');}
function updateRocket(dt){if(rocketCooldown>0)rocketCooldown=Math.max(0,rocketCooldown-dt);if(rocketMesh){rocketMesh.position.z+=92*dt;rocketMesh.position.x+=(px-rocketMesh.position.x)*Math.min(1,dt*1.2);let target=null,best=Infinity;for(const t of trafficCars){if(!t.g.visible||t.gone||t.z<rocketMesh.position.z-2)continue;const dx=Math.abs(t.x-rocketMesh.position.x),dz=t.z-rocketMesh.position.z;if(dx<5&&dz>=0&&dz<best){best=dz;target=t;}}if(target&&best<4){const x=target.x,z=target.z;scene.remove(rocketMesh);rocketMesh=null;detonateRocket(x,z);}else if(rocketMesh.position.z>155){const x=rocketMesh.position.x,z=rocketMesh.position.z;scene.remove(rocketMesh);rocketMesh=null;detonateRocket(x,z);}}if(rocketExplosion){rocketExplosion.age+=dt;const f=Math.min(1,rocketExplosion.age/.42);rocketExplosion.group.scale.setScalar(.5+f*7);rocketExplosion.group.children[0].material.opacity=.72*(1-f);if(f>=1){scene.remove(rocketExplosion.group);rocketExplosion.group.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material)o.material.dispose();});rocketExplosion=null;}}}

function physics(dt){
  const run=state==='run', k=keys; let thr=0,br=0,st=0,hb=0;
  if(run){
    thr=(k.KeyW||k.ArrowUp||tch.g)?1:0; br=(k.KeyS||k.ArrowDown||tch.b)?1:0;
    st=((k.KeyA||k.ArrowLeft||tch.l)?1:0)-((k.KeyD||k.ArrowRight||tch.r)?1:0); hb=k.Space?1:0;
  }else if(paintView){ br=1; }   // showroom: park the car
  else if(state==='menu'){ thr=speed<33?.7:.12; } else if(state==='exit'){ if(speed>14) br=.5; else thr=.2; } else br=.35;
  const gp=navigator.getGamepads&&navigator.getGamepads()[0];
  if(gp){
    if(run){ const ax=gp.axes[0]||0; if(Math.abs(ax)>.12) st=-ax; thr=Math.max(thr,gp.buttons[7]?gp.buttons[7].value:0); br=Math.max(br,gp.buttons[6]?gp.buttons[6].value:0); }
    else if(gp.buttons[0]&&gp.buttons[0].pressed&&!shopOpen&&(state==='menu'||state==='over')) requestStartRun();
  }
  thrS+=(thr-thrS)*(1-Math.exp(-9*dt)); brkS+=(Math.min(1,br+hb*.6)-brkS)*(1-Math.exp(-28*dt));
  inv=Math.max(0,inv-dt); shake=Math.max(0,shake-dt*1.8); if(ghostLeft>0){ghostLeft=Math.max(0,ghostLeft-dt);if(ghostLeft<=0){ghostVisual(false);popup('GHOST CHASSIS EXPIRED','bad');}} if(runPU.rocket&&state==='run'){$('powerHud').textContent=rocketCooldown>0?'🚀 RPG RELOAD · '+Math.ceil(rocketCooldown)+'s':'🚀 RPG READY · E';$('powerHud').classList.add('show');}else if(nitrousLeft>0){$('powerHud').textContent='💨 NITROUS '+nitrousLeft.toFixed(1)+'s';$('powerHud').classList.add('show');}else if(ghostLeft>0){$('powerHud').textContent='👻 GHOST CHASSIS '+ghostLeft.toFixed(1)+'s';$('powerHud').classList.add('show');}else if(state==='run'&&runPU.nitrous&&!nitrousUsed){$('powerHud').textContent='💨 NITROUS READY · E';$('powerHud').classList.add('show');}else if(state==='run'&&runPU.ghost&&!ghostUsed){$('powerHud').textContent='👻 GHOST CHASSIS READY · E';$('powerHud').classList.add('show');}else if(state!=='run')$('powerHud').classList.remove('show');
  const inTunnelNow=run&&tunnelAtDistance(dist);
  if(inTunnelNow) inv=Math.max(inv,.12); // tunnel immunity is active before this frame's collision tests
  // simcade steering: speed-sensitive lock, grip-limited yaw rate, heading self-centres when steering is released
  const v=speed, steerV=isBetaCar()?Math.min(v,58):v, rate=(Math.abs(st)>Math.abs(steer)?3.4:5)/(1+steerV/45), d=st-steer;
  steer+=Math.sign(d)*Math.min(Math.abs(d),rate*dt);
  const dmax=.55/(1+Math.pow(steerV/14,1.5)), amax=(11-4*brkS-2*hb)*(1-.07*rainK), lim=amax/Math.max(steerV,3);
  yr=Math.max(-lim,Math.min(lim,v*Math.tan(dmax*steer)/2.7))*(1+.5*hb);
  yaw+=(yr-.8*v*kappaAt(dist))*dt;                         // road turns under you; steering assist follows ~80% of it
  yaw-=yaw*Math.min(1,(2.2-1.2*hb)*(1-Math.abs(steer))*dt); yaw=Math.max(-.5,Math.min(.5,yaw));
  const v0=speed; driveStep(dt); if(run&&ghostLeft>0)speed=Math.max(0,speed-.12*dt); if(run&&nitrousLeft>0){nitrousLeft=Math.max(0,nitrousLeft-dt);speed=Math.min((CAR_STATS[CS.sel].topSpeedMph||205)/MPH*1.55,speed+30*dt);}
  accS+=(Math.max(-14,Math.min(8,(speed-v0)/Math.max(dt,.001)))-accS)*(1-Math.exp(-6*dt)); ayS+=(v*yr-ayS)*(1-Math.exp(-8*dt));
  vl+=(v*Math.sin(yaw)-vl)*(1-Math.exp(-dt/(.13+.3*hb)*(1+.2*rainK)));   // tyres lag the heading: the car slides a little
  fwd=speed*Math.cos(yaw); px+=vl*dt;
  { const lz0=runDist-exitK()*EX; exZone=state==='exit'||((state==='run'||state==='menu')&&lz0>-160&&lz0<60); }   // rail is open and the shoulder is a free lane next to an exit
  if(state==='exit'){ const lz=runDist-exitAt; px+=(rampX(lz)-px)*Math.min(1,3*dt); yaw+=(-Math.atan(rampSlope(lz))-yaw)*Math.min(1,4*dt); vl=speed*Math.sin(yaw); }
  const pxMin=exZone?-11:-7.6;
  if(state!=='exit'&&!inTunnelNow&&(px>6.3||px<pxMin)){
    const sd=px>0?1:-1; px=sd>0?6.3:pxMin;
    if(vl*sd>1) crash(sd>0?'BARRIER':'GUARDRAIL',speed*.4);
    if(vl*sd>0) vl=-vl*.3;                         // bounce off
    if(yaw*sd>0) yaw=-yaw*.3;                      // and turn the nose away so the car never sits clipped in the wall
    if(ghostLeft<=0)speed=Math.max(0,speed-(5+.06*speed)*dt); shake=Math.max(shake,.25);
  }
  const off=!inTunnelNow&&((px<-5.3&&!exZone)||px>5.3); // no shoulder/off-road penalty inside tunnels
  if(off){ speed=Math.max(0,speed-(3+.04*speed)*dt); shake=Math.max(shake,.12); }
  if(!(speed>=0)) speed=0; if(!isFinite(px)) px=0; if(!isFinite(yaw)) yaw=0; if(!isFinite(vl)) vl=0;
  if(run&&off&&!wasOff) popup('OFF ROAD','bad'); wasOff=off;
  if(run){
    const mph=speed*MPH;
    if(!isBetaCar()&&mph>40&&!off) score+=3*Math.pow((mph-40)/8,2)*mult*(runPU.double?2:1)*dt;
    miles+=fwd*dt/1609.34; clean+=dt; mult=(1+Math.min(4,Math.floor(clean/8)))*(raining()?1.5:1);   // rain: x1.5 on the multiplier
    if(!isBetaCar()){ const kE=exitK(), lz=runDist-kE*EX; if(lz>-10&&lz<40&&px<-5.2){ startExit(kE*EX); return; } }   // in the exit lane at the gore: take the exit
    while(false){    // +10 s every 100k pts; each bonus earned within BONUS_WIN s of the last one makes the next gap 40% bigger (up to x3.4), and it cools off again when you slow down
      const gap=runT-lastBT; bHeat=gap<BONUS_WIN?Math.min(6,bHeat+1):Math.max(0,bHeat-Math.floor(gap/BONUS_WIN)); lastBT=runT;
      nextBonus+=Math.round(100000*(1+.4*bHeat)); timeLeft+=0; popup('+10 SECONDS'+(bHeat>0?'  ·  next +'+Math.round(100000*(1+.4*bHeat)/1000)+'k':''),'good'); }
    runT+=dt; timeLeft-=dt; timeLeft=Math.min(timeLeft,TIME_CAP); if(timeLeft<=0){ timeLeft=0; endRun('time'); }
  }
}
let _hudAt=0;
function updateHud(){
  const _n=performance.now(); if(_n-_hudAt<90) return; _hudAt=_n;     // ~11 Hz is plenty for text
  kmhEl.textContent=Math.round(speed*MPH);
  { const c=todText(tod)+' · '+todStage(tod)+(rainK>.12?' · Rain':''); if($('clk').textContent!==c) $('clk').textContent=c; $('gRain').textContent=raining()?'RAIN x1.5':''; }
  $('gScore').textContent=isBetaCar()?'—':Math.floor(score).toLocaleString(); $('gMult').textContent=isBetaCar()?'UNRANKED':'x'+(mult*(runPU.double?2:1));
  $('gMiles').textContent=miles.toFixed(2); $('nextB').textContent=isBetaCar()?'BLACK MARKET · NO POINTS':tStreak+'  (+'+(1.3+.3*Math.min(8,tStreak)).toFixed(1)+' s next)';
  $('gExit').textContent=Math.max(0,((Math.floor(runDist/EX)+1)*EX-runDist)/1609.34).toFixed(2); $('gCash').textContent=isBetaCar()?'$0.00':money(centsFor(Math.floor(Math.max(0,score))));
  const t=Math.ceil(timeLeft); $('gTime').textContent=Math.floor(t/60)+':'+String(t%60).padStart(2,'0');
}

/* ---------------- rev gauge (bottom right): white = revved, grey = unrevved, red = redline zone */
const G_RED=8400, G_MAX=10000;          // redline = ECFG.redline (declared further down)
{
  const NS='http://www.w3.org/2000/svg', g=document.getElementById('gTicks');
  for(let i=0;i<=20;i++){
    const r=i*500, major=i%2===0, a=gAng(r)*Math.PI/180, r1=103, r2=major?94:99, red=r>=G_RED-1;
    const l=document.createElementNS(NS,'line');
    l.setAttribute('x1',150+r1*Math.sin(a)); l.setAttribute('y1',150-r1*Math.cos(a)); l.setAttribute('x2',150+r2*Math.sin(a)); l.setAttribute('y2',150-r2*Math.cos(a));
    l.setAttribute('stroke',red?'#ff7a4a':'#fff'); l.setAttribute('stroke-opacity',major?.95:.5); l.setAttribute('stroke-width',major?2.4:1.4); g.appendChild(l);
    if(major){ const t=document.createElementNS(NS,'text'), rr=84;
      t.setAttribute('x',150+rr*Math.sin(a)); t.setAttribute('y',150-rr*Math.cos(a)+5); t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','13'); t.setAttribute('font-weight','600');
      t.setAttribute('fill',red?'#ff7a4a':'rgba(255,255,255,.8)'); t.textContent=i/2; g.appendChild(t); }
  }
  document.getElementById('gGrey').setAttribute('d',gArc(0,G_RED)); document.getElementById('gRed').setAttribute('d',gArc(G_RED,G_MAX));
}
function gAng(rpm){ return -135+270*Math.min(1,Math.max(0,rpm/G_MAX)); }          // degrees clockwise from 12 o'clock
function gArc(r0,r1,rad=118){
  const a0=gAng(r0)*Math.PI/180, a1=gAng(r1)*Math.PI/180;
  return 'M'+(150+rad*Math.sin(a0)).toFixed(2)+' '+(150-rad*Math.cos(a0)).toFixed(2)+' A'+rad+' '+rad+' 0 '+((a1-a0)>Math.PI?1:0)+' 1 '+(150+rad*Math.sin(a1)).toFixed(2)+' '+(150-rad*Math.cos(a1)).toFixed(2);
}
let _gS=-1, _gG=-1, _gR=-1;
function gaugeTick(){
  if(titleOn) return;
  const rpm=Math.min(eng.rpm,G_RED), q=Math.round(rpm/8);
  if(q!==_gR){ _gR=q;
    $('gWhite').setAttribute('d',rpm>20?gArc(0,rpm):'');
    const a=gAng(rpm)*Math.PI/180, m=$('gMark'); m.setAttribute('x1',150+106*Math.sin(a)); m.setAttribute('y1',150-106*Math.cos(a)); m.setAttribute('x2',150+130*Math.sin(a)); m.setAttribute('y2',150-130*Math.cos(a));
  }
  const sp=Math.round(speed*MPH); if(sp!==_gS){ _gS=sp; $('gSpd').textContent=sp; }
  const gr=eng.gear+1; if(gr!==_gG){ _gG=gr; $('gGear').textContent=gr; }
}
/* ------------------------------------------------------------------ loop */
/* ------------------------------------------------------------------ vehicle + engine model (Porsche Carrera GT)
   Specs: 5.7 L V10, 612 hp @ 8000, 590 Nm @ 5750, redline 8400, ~1450 kg, 335/30R20 rear, 330 km/h top speed, 0-100 ~3.9 s.
   Gear ratios 1-6 are from tooth counts (rennlist "CGT gearbox details"); the final drive (4.325) is chosen so 6th at
   8000 rpm = 330 km/h. Speed now follows from engine torque x gear (traction-, drag- and shift-limited), not a smooth lerp.
   Sound: AudioWorklet V10 (see #v10-worklet) with a Web Audio synth fallback. A recorded-loop backend can replace
   `engineBackend` if it has init(ctx,out) / update(state,t) / pop(strength,count).
   state = {rpm, rn (0..1 rpm), thr (0..1 load), gm (volume mod: shudder + limiter), v (m/s)} */
const VEH={m:1450, R:.355, fd:4.325, eta:.88, cdA:.83, roll:170, pw:388000, grip:10800, brake:15};
const ECFG={idle:900, redline:8400 /* 8600 with upgraded cam */, cyl:10, period:.31, gears:[3.20,1.87,1.36,1.07,.90,.75]};
ECFG.tot=ECFG.gears.map(g=>g*VEH.fd);
ECFG.ratio=ECFG.tot.map(t=>t*60/(2*Math.PI*VEH.R));          // engine rpm per m/s in each gear
const TQ=[[0,0],[900,230],[1500,350],[2000,430],[3000,510],[4000,555],[5000,580],[5750,590],[7000,575],[8000,544],[8400,515],[9000,380]];
function torque(r){
  for(let i=1;i<TQ.length;i++) if(r<=TQ[i][0]){const a=TQ[i-1],b=TQ[i];return a[1]+(b[1]-a[1])*(r-a[0])/(b[0]-a[0])}
  return 0;
}
const A={ctx:null,master:null,ready:false};
const eng={on:false,gear:0,rpm:ECFG.idle,thr:.3,mode:0,blip:0,prev:speed,sT:-1,sDur:0,popT:0,hud:0};
while(eng.gear<5 && ECFG.ratio[eng.gear]*speed>ECFG.redline*.55) eng.gear++;
eng.rpm=Math.max(ECFG.idle,ECFG.ratio[eng.gear]*speed);

/* longitudinal dynamics: pedals -> engine torque x gear (traction-, drag-, shift- and redline-limited) + brakes */
function driveStep(dt){
  if(isBetaCar()){
    // Black Market Beta: huge launch torque, almost no aerodynamic fade until the hard 310 mph limiter.
    // Full throttle reaches its cap in roughly four seconds from rest; braking remains controllable.
    const cap=CAR_STATS.beta.topSpeedMph/MPH;
    const accel=36*thrS - 1.1*(thrS<.02?1:0) - 25*brkS*(1+brkAssist);
    speed=Math.max(0,Math.min(cap,speed+accel*dt));
    eng.gear=5; eng.rpm=900+Math.min(7400,speed/cap*7400); eng.thr=thrS;
    return;
  }
  const v=speed, res=.5*1.2*VEH.cdA*v*v+VEH.roll; let F=0;
  if(thrS>.01){
    const sh=eng.sT<0?1:Math.min(1,Math.max(0,(eng.sT-.12)/.12));
    const cut=Math.min(1,Math.max(0,(ECFG.redline-ECFG.ratio[eng.gear]*v)/250));
    F=Math.min(torque(Math.max(eng.rpm,1800))*ECFG.tot[eng.gear]*VEH.eta/VEH.R*thrS,VEH.grip)*sh*cut;
  }
  const Feb=thrS>.01?0:(40+70*Math.min(1,eng.rpm/ECFG.redline))*ECFG.tot[eng.gear]*.9/VEH.R;
  speed=Math.max(0,speed+((F-res-Feb)/VEH.m-VEH.brake*brkS*(1+brkAssist)*(1-.08*rainK))*dt);
}

const synth={      // fallback when AudioWorklet is unavailable
  init(ctx,out){
    const n=this.n={ctx};
    const mk=(type,det,dest)=>{const o=ctx.createOscillator();o.type=type;o.detune.value=det;o.connect(dest);o.start();return o};
    const bq=(type,f,q,g)=>{const b=ctx.createBiquadFilter();b.type=type;b.frequency.value=f;b.Q.value=q;if(g!==undefined)b.gain.value=g;return b};
    const gain=(v,dest)=>{const g=ctx.createGain();g.gain.value=v;if(dest)g.connect(dest);return g};
    const mix=gain(.3);
    n.o=[mk('sawtooth',0,mix),mk('sawtooth',9,mix),mk('sawtooth',-9,mix)];
    n.h2=mk('square',4,gain(.22,mix)); n.sub=mk('triangle',0,gain(.3,mix));
    const sh=ctx.createWaveShaper(),c=new Float32Array(1024);
    for(let i=0;i<1024;i++) c[i]=Math.tanh(2.2*(i/512-1));
    sh.curve=c; sh.oversample='2x';
    n.f1=bq('peaking',600,2.5,8); n.f2=bq('peaking',2000,3,6);
    n.lp=bq('lowpass',1500,.7); n.eng=gain(0,out);
    mix.connect(sh); sh.connect(n.f1); n.f1.connect(n.f2); n.f2.connect(n.lp); n.lp.connect(n.eng);
    const nb=ctx.createBuffer(1,ctx.sampleRate*2,ctx.sampleRate),d=nb.getChannelData(0);
    for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1;
    const ns=ctx.createBufferSource(); ns.buffer=nb; ns.loop=true; ns.start();
    n.ibp=bq('bandpass',1500,.7); n.ig=gain(0,out); ns.connect(n.ibp); n.ibp.connect(n.ig);
    n.rg=gain(0,out); ns.connect(bq('lowpass',140,.5)).connect(n.rg);
    n.rs=mk('sine',0,gain(.07,out));
    n.pbp=bq('bandpass',250,1.2); n.pg=gain(0,out); ns.connect(n.pbp); n.pbp.connect(n.pg);
  },
  update(s,t){
    const n=this.n,f=s.rpm/60*ECFG.cyl/2,set=(p,v,tc)=>p.setTargetAtTime(v,t,tc||.03);
    for(const o of n.o) set(o.frequency,f,.02);
    set(n.h2.frequency,f*2,.02); set(n.sub.frequency,f*.5,.02);
    set(n.rs.frequency,Math.max(30,s.rpm/60*2));
    set(n.f1.frequency,500+s.rpm*.06); set(n.f2.frequency,1500+s.rpm*.25);
    set(n.lp.frequency,Math.min(9000,700+s.rpm*.55+s.thr*2500),.05);
    set(n.eng.gain,(.16+.5*s.rn)*(.45+.55*s.thr)*s.gm,.02);
    set(n.ig.gain,s.thr*(.03+.3*s.rn*s.rn),.04); set(n.ibp.frequency,700+s.rpm*.35);
    set(n.rg.gain,(.35+.5*s.rn)*(.6+.4*s.thr),.05);
  },
  pop(str,cnt){
    const n=this.n,t=n.ctx.currentTime,g=n.pg.gain;
    n.pbp.frequency.setValueAtTime(140+Math.random()*420,t);
    g.cancelScheduledValues(t); g.setValueAtTime(.0001,t);
    let o=0;
    for(let k=0;k<cnt;k++){const d=.05+Math.random()*.06;
      g.setValueAtTime(.0001,t+o); g.linearRampToValueAtTime(4*str*(k?.6:1),t+o+.004); g.exponentialRampToValueAtTime(.0001,t+o+d); o+=d+.03}
  }
};

const v10={        // physical-model V10 in an AudioWorklet (+ gear whine)
  async init(ctx,out){
    const url=URL.createObjectURL(new Blob([document.getElementById('v10-worklet').textContent],{type:'application/javascript'}));
    try{ await ctx.audioWorklet.addModule(url); } finally{ URL.revokeObjectURL(url); }
    const n=this.n={ctx};
    n.node=new AudioWorkletNode(ctx,'v10-engine',{numberOfInputs:0,numberOfOutputs:1,outputChannelCount:[1]});
    n.lp=ctx.createBiquadFilter(); n.lp.type='lowpass'; n.lp.frequency.value=4000; n.lp.Q.value=.5;
    n.node.connect(n.lp); n.lp.connect(out);
    n.wh=ctx.createOscillator(); n.wh.type='triangle'; n.wh.frequency.value=100;
    n.whg=ctx.createGain(); n.whg.gain.value=0; n.wh.connect(n.whg); n.whg.connect(out); n.wh.start();
  },
  update(s,t){
    const n=this.n,P=n.node.parameters;
    P.get('rpm').value=s.rpm; P.get('thr').value=s.thr; P.get('wind').value=s.v;
    P.get('gain').value=(.8+.2*s.rn)*(.6+.4*s.thr)*s.gm;
    n.lp.frequency.setTargetAtTime(Math.min(14000,2200+s.rn*9000+s.thr*3000),t,.05);   // opens with rpm and load
    n.wh.frequency.setTargetAtTime(Math.max(40,s.v*12),t,.05);                           // transaxle whine follows road speed
    n.whg.gain.setTargetAtTime(.01*Math.min(1,s.v/50)*(.35+.65*s.thr),t,.05);
  },
  pop(str,cnt){
    for(let k=0;k<cnt;k++) setTimeout(()=>{ if(this.n) this.n.node.port.postMessage({pop:str*(k?.6:1)}) },k*85);
  }
};
let engineBackend=synth;

function buildAudio(){
  const AC=window.AudioContext||window.webkitAudioContext; if(!AC) return false;
  const ctx=A.ctx=new AC();
  A.master=ctx.createGain(); A.master.gain.value=0;
  const comp=ctx.createDynamicsCompressor(); comp.threshold.value=-16; comp.ratio.value=5; comp.attack.value=.005; comp.release.value=.2;
  A.master.connect(comp); comp.connect(ctx.destination);
  (ctx.audioWorklet ? v10.init(ctx,A.master).then(()=>v10) : Promise.reject())
    .catch(e=>{ console.warn('AudioWorklet engine unavailable, using synth fallback',e); synth.init(ctx,A.master); return synth; })
    .then(b=>{ engineBackend=b; A.ready=true; });
  return true;
}
const sndBtn=document.getElementById('snd'), sndLbl=document.getElementById('sndl'), engEl=document.getElementById('eng');
function setSound(on){ soundAsked=true;
  if(on && !A.ctx && !buildAudio()){ on=false; sndBtn.disabled=true; }
  eng.on=on;
  if(A.ctx){
    const t=A.ctx.currentTime;
    if(on){ A.ctx.resume(); A.master.gain.cancelScheduledValues(t); A.master.gain.setTargetAtTime(.8,t,.08); }
    else { A.master.gain.setTargetAtTime(0,t,.06); setTimeout(()=>{ if(!eng.on) A.ctx.suspend(); },500); }
  }
  sndBtn.setAttribute('aria-pressed',on); sndLbl.textContent=on?'Engine on':'Engine off';
}
sndBtn.addEventListener('click',()=>toggleEngine());
addEventListener('keydown',e=>{ if(window.__lbModal) return; if((e.key==='m'||e.key==='M')&&!inRun()) toggleEngine() });
document.addEventListener('visibilitychange',()=>{ if(!A.ctx) return; if(document.hidden) A.ctx.suspend(); else if(eng.on) A.ctx.resume(); });
function pop(str,cnt){ if(eng.on&&A.ready) engineBackend.pop(str,cnt||1) }

function engineTick(dt){
  const v=speed, res=.5*1.2*VEH.cdA*v*v+VEH.roll;
  const hold=Math.min(1,.08+1.1*Math.sqrt(res*v/VEH.pw));              // part-throttle needed to cruise
  eng.mode=thrS>.02?1:-1; const decel=eng.mode<0;
  let raw=thrS>.02?Math.max(.15,thrS):0;
  if(eng.blip>0){ eng.blip-=dt; raw=Math.max(raw,.55); }               // rev-match blip on downshifts
  eng.thr+=(raw-eng.thr)*(1-Math.exp(-(raw>eng.thr?10:6)*dt));
  // gearbox: earlier upshifts at light throttle, near redline at full throttle; downshift under braking
  let g=eng.gear;
  if(eng.sT<0){
    const up=ECFG.redline*(.30+.67*eng.thr), dn=decel?2800:1500+1200*eng.thr;
    if(g<5 && !decel && ECFG.ratio[g]*speed>up){
      eng.gear=++g; eng.sT=0; eng.sDur=ECFG.period*(1+.5*eng.thr);       // 0.31 s period, 1.0..1.5 cycles
      if(eng.thr>.6) pop(.5,1);
    } else if(g>0 && ECFG.ratio[g]*speed<dn){
      eng.gear=--g; if(decel){ eng.blip=.2; pop(.8,2); }
    }
  }
  // upshift shudder: rpm + throttle dip, then decaying oscillation on volume and pitch
  let gm=1,pm=1,cut=1,dip=0;
  if(eng.sT>=0){
    eng.sT+=dt; const t=eng.sT;
    if(t>=eng.sDur) eng.sT=-1;
    else{
      const m=Math.sin(6.2832*t/ECFG.period)*(1-t/eng.sDur), k=.5+.5*eng.thr;
      gm=1+.2*k*m; pm=1+.03*k*m;
      dip=500*Math.sin(Math.PI*Math.min(t/.18,1));
      if(t<.12) cut=.3+.7*(t/.12);
    }
  }
  let tgt=ECFG.ratio[eng.gear]*speed;
  if(eng.gear===0 && eng.thr>.4) tgt=Math.max(tgt,1500+3300*eng.thr);   // clutch slip on launch
  tgt=Math.max(ECFG.idle,tgt-dip);
  eng.rpm+=(tgt-eng.rpm)*(1-Math.exp(-dt/.07));
  if(eng.rpm<1100) eng.rpm+=Math.sin(time*5.3)*18+Math.sin(time*11.1)*8;  // idle lope
  let lim=1;                                                              // rev limiter fuel cut
  if(tgt>ECFG.redline*.985 && eng.thr>.5) lim=(Math.floor(time*16)&1)?.25:1;
  eng.rpm=Math.min(eng.rpm,ECFG.redline);
  if(eng.on && decel && eng.rpm>2500){                                    // lift-off burble
    eng.popT-=dt;
    if(eng.popT<=0){ pop(.25+.5*Math.random()*(eng.rpm/ECFG.redline+.3),1+(Math.random()<.35)); eng.popT=.07+Math.random()*.3; }
  }
  if(eng.on && A.ready){
    engineBackend.update({rpm:eng.rpm*pm-(lim<1?120:0), rn:(eng.rpm-ECFG.idle)/(ECFG.redline-ECFG.idle), thr:eng.thr*cut, gm:gm*lim, v:speed},A.ctx.currentTime);
  }
  eng.hud-=dt;
  if(eng.hud<=0){ eng.hud=.1; engEl.textContent='G'+(eng.gear+1)+' · '+(Math.round(eng.rpm/10)*10)+' rpm'; }
}

/* ---------------- radio: shuffle weighted by 1/length, so long tracks come up less often.
   Default songs: audio1-11.mp3 in the same folder as index.html. Add more by appending to RADIO (or use the + button). */
/* g = loudness correction in dB so every song plays as loud as Liberate (measured: integrated LUFS, Liberate = -9.1).
   Songs you add with + are measured in the browser and corrected the same way. */
const RADIO=[
 {f:'audio11.mp3',t:'Chromatically',a:'Haywyre',d:198,g:0},
 {f:'audio10.mp3',t:'A Moment Apart',a:'ODESZA',d:240,g:0},
 {f:'audio9.mp3',t:"It's Tricky",a:'Run-DMC',d:184,g:0},
 {f:'audio8.mp3',t:'Train in Vain',a:'The Clash',d:180,g:0},
 {f:'audio7.mp3',t:'The Power (feat. Dizzee Rascal)',a:'DJ Fresh',d:167,g:0},
 {f:'audio6.mp3',t:'Turbo Fire',a:'TANTRON x Nakamura Minami',d:195,g:15.2},
 {f:'audio5.mp3',t:'Route 174',a:'Metrik',d:220,g:4.9},
 {f:'audio4.mp3',t:'Sunrise',a:'Fred V & Grafix',d:590,g:3.2},
 {f:'audio3.mp3',t:'Constellations',a:'Fred V & Grafix',d:277,g:-1.2},
 {f:'audio2.mp3',t:'Liberate',a:'Eric Prydz',d:164,g:0},
 {f:'audio1.mp3',t:'Everyday (Netsky VIP Remix)',a:'Rusko',d:249,g:-2.0}];
const radio={a:new Audio(),on:false,cur:null,hist:[]}, npEl=$('np'), radBtn=$('rad');
const RADIO_VOL=.7, REF_RMS_DB=-9.35;   // REF_RMS_DB: Liberate measured with measureDb() below (used for songs you add)
radio.a.preload='auto'; radio.a.volume=RADIO_VOL;
/* the radio goes through WebAudio (gain per song + a limiter) so quiet songs can be boosted past element.volume=1.
   From file:// the browser would mute a MediaElementSource, so there it falls back to plain element volume. */
const RG={ctx:null,gain:null,failed:false};
function rgInit(){
  if(RG.ctx||RG.failed) return;
  const C=window.AudioContext||window.webkitAudioContext;
  if(!C||location.protocol==='file:'){ RG.failed=true; return; }
  try{
    RG.ctx=new C(); const src=RG.ctx.createMediaElementSource(radio.a); RG.gain=RG.ctx.createGain();
    const lim=RG.ctx.createDynamicsCompressor(); lim.threshold.value=-3; lim.knee.value=0; lim.ratio.value=20; lim.attack.value=.002; lim.release.value=.15;
    src.connect(RG.gain); RG.gain.connect(lim); lim.connect(RG.ctx.destination); RG.out=lim; radio.a.volume=1;
  }catch(e){ RG.failed=true; RG.ctx=null; radio.a.volume=RADIO_VOL; }
}
function rgResume(){ if(RG.ctx&&RG.ctx.state==='suspended') RG.ctx.resume().catch(()=>{}); }
function rgApply(t){ const lin=Math.pow(10,((t&&t.g)||0)/20)*RADIO_VOL; if(RG.ctx) RG.gain.gain.value=lin; else radio.a.volume=Math.min(1,lin); }
async function measureDb(file){   // gated mean-square level in dB (400 ms blocks, -50 dB absolute gate, -10 dB relative gate)
  if(file.size>24e6) return null;
  try{
    const C=window.AudioContext||window.webkitAudioContext, ac=new C(); const buf=await ac.decodeAudioData(await file.arrayBuffer()); ac.close();
    const sr=buf.sampleRate, n=Math.floor(.4*sr), chs=[...Array(buf.numberOfChannels).keys()].map(i=>buf.getChannelData(i)), pw=[];
    for(let b=0;b+n<=buf.length;b+=n){ let sum=0; for(const c of chs) for(let i=b;i<b+n;i++) sum+=c[i]*c[i]; pw.push(sum/(n*chs.length)); }
    const db=p=>10*Math.log10(p+1e-12), keep=pw.filter(p=>db(p)>-50); if(!keep.length) return null;
    const mean=a=>a.reduce((x,y)=>x+y,0)/a.length, rel=db(mean(keep))-10, keep2=keep.filter(p=>db(p)>rel);
    return db(mean(keep2));
  }catch(e){ return null; }
}
function nextTrack(){
  const ok=RADIO.filter(t=>!t.bad); if(!ok.length) return null;
  const fresh=ok.filter(t=>!radio.hist.includes(t)), pool=fresh.length?fresh:ok;
  let r=Math.random()*pool.reduce((n,t)=>n+1/t.d,0), pick=pool[pool.length-1];
  for(const t of pool){ r-=1/t.d; if(r<=0){ pick=t; break; } }
  radio.hist.push(pick); while(radio.hist.length>Math.min(2,ok.length-1)) radio.hist.shift();
  return pick;
}
function playTrack(t){
  if(!t){ npEl.textContent='No music found — put audio1–11.mp3 next to index.html'; return; }
  rgInit(); rgApply(t); rgResume();
  radio.cur=t; radio.a.src=t.u||encodeURI(t.f); radio.a.play().catch(()=>{});   // may be blocked until the first key press / click
  npEl.textContent='♪ '+t.t+(t.a?' — '+t.a:'');
}
function skipTrack(){ if(radio.on) playTrack(nextTrack()); }
function setRadio(on){
  soundAsked=true; radio.on=on;
  radBtn.setAttribute('aria-pressed',on); $('radl').textContent=on?'Radio on':'Radio off';
  if(on){ rgResume(); if(radio.cur&&radio.a.src) radio.a.play().catch(()=>{}); else playTrack(nextTrack()); }
  else{ radio.a.pause(); npEl.textContent=''; }
}
function toggleRadio(){ radio.manualOff=radio.on; setRadio(!radio.on); }
function toggleEngine(){ eng.manualOff=eng.on; setSound(!eng.on); }
radio.a.addEventListener('ended',skipTrack);
radio.a.addEventListener('play',rgResume);
radio.a.addEventListener('loadedmetadata',()=>{ if(radio.cur&&isFinite(radio.a.duration)) radio.cur.d=radio.a.duration; });
radio.a.addEventListener('error',()=>{ if(radio.cur) radio.cur.bad=true; skipTrack(); });
radBtn.addEventListener('click',toggleRadio);
$('nxt').addEventListener('click',skipTrack);
$('addm').addEventListener('click',()=>$('addf').click());
$('addf').addEventListener('change',e=>{
  for(const f of e.target.files){
    const t={u:URL.createObjectURL(f),t:f.name.replace(/\.[^.]+$/,''),a:'',d:240}, m=new Audio(t.u);
    m.preload='metadata'; m.onloadedmetadata=()=>{ if(isFinite(m.duration)) t.d=m.duration; }; RADIO.push(t);
    measureDb(f).then(db=>{ if(db!==null){ t.g=Math.max(-18,Math.min(18,REF_RMS_DB-db)); if(radio.cur===t) rgApply(t); } });
  }
  e.target.value=''; if(!radio.on&&!titleOn) setRadio(true);
});
document.addEventListener('visibilitychange',()=>{ if(!radio.on||!radio.cur) return; if(document.hidden) radio.a.pause(); else radio.a.play().catch(()=>{}); });

/* autoplay: try immediately; browsers usually block audio until the first key press / click, so that
   first input starts the radio (and engine) unless you switched them off yourself. */
/* Mutually exclusive menu music: title, regular shop, or Black Market. */
const titleA=new Audio('title.mp3'); titleA.loop=true; titleA.volume=.8; titleA.preload='auto';
const shopA=new Audio('shop.mp3'); shopA.loop=true; shopA.volume=.8; shopA.preload='auto';
const blackMarketA=new Audio('bshop.mp3'); blackMarketA.loop=true; blackMarketA.volume=.8; blackMarketA.preload='auto';
function syncMenuMusic(){
  const inShop=!!document.getElementById('shop')?.classList.contains('show');
  const active=document.hidden?null:bmOpen?blackMarketA:inShop?shopA:titleOn?titleA:null;
  [titleA,shopA,blackMarketA].forEach(a=>{if(a!==active){a.pause();try{a.currentTime=0}catch(e){}}});
  if(active) active.play().catch(()=>{});
}
function playTitle(){ syncMenuMusic(); }
function stopTitle(){ titleA.pause(); try{titleA.currentTime=0}catch(e){} }
function showTitle(){          // back to the title screen from the results / scores card
  state='menu'; titleOn=true; $('ov').classList.add('hide'); $('title').classList.remove('hide');
  setRadio(false); setSound(false); syncMenuMusic(); renderWallet();
}
function leaveTitle(){ titleOn=false; $('title').classList.add('hide'); stopTitle(); syncMenuMusic(); }
$('tStart').addEventListener('click',()=>requestStartRun());
$('tShop').addEventListener('click',()=>setShop(true));
$('tHelp').addEventListener('click',()=>{ $('title').classList.add('hide'); $('ovt').textContent='Carrera GT'; $('ovb').innerHTML=''; $('goBtn').textContent='Start run'; $('ov').classList.remove('hide'); });
$('menuBtn').addEventListener('click',showTitle);
if(!titleOn) setRadio(true);
playTitle();
document.addEventListener('visibilitychange',syncMenuMusic);
function unlockAudio(e){
  if(e.code==='KeyM'||e.code==='KeyR'||e.code==='KeyN'||(e.target.closest&&e.target.closest('#ui'))) return;
  if(titleOn){ if(titleA.paused) playTitle(); if(!titleA.paused){ removeEventListener('keydown',unlockAudio); removeEventListener('pointerdown',unlockAudio); } return; }
  if(!radio.manualOff){ if(!radio.on) setRadio(true); else if(radio.a.paused) radio.a.play().catch(()=>{}); }
  if(!eng.on&&!eng.manualOff) setSound(true);
  if(!radio.a.paused||radio.manualOff){ removeEventListener('keydown',unlockAudio); removeEventListener('pointerdown',unlockAudio); }
}
addEventListener('keydown',unlockAudio); addEventListener('pointerdown',unlockAudio);

const _fp=new THREE.Vector3(); const dbg={noSprites:true};   // light glows are OFF by default (they flashbanged on some GPUs); Shift+2 in the debug panel turns them back on
const DAY_LEN=600; /* real seconds per 24 h day */ const clock=new THREE.Clock(); let time=0;
const _cp=new THREE.Vector3(), _cl=new THREE.Vector3(), _lk=new THREE.Vector3(); let camYaw=0, firstCam=true;
/* exit courtesy zone: no traffic within half a mile of an exit, either side (a 1-mile stretch). Cars thin out over a short band just outside that radius
   (they fade and pull away ahead of you, like they drove off) and come back the same way on the far side. */
const CLEAR_R=804.67, CLEAR_FB=80;     // 1 mile across: half a mile each side of an exit
function trafficAlpha(rz){ const a=runDist+rz, E=Math.max(1,Math.round(a/EX))*EX; return {a:smooth(CLEAR_R,CLEAR_R+CLEAR_FB,Math.abs(a-E)),before:a<E}; }
function applyCarAlpha(t){
  const a=t.alpha, vis=state!=='exit'&&a>.02; t.g.visible=vis; if(!vis) return;
  if(t.fa!==a){ t.fa=a; for(const m of t.mats) m.opacity=a; }
  t.tl.emissiveIntensity=redTail.emissiveIntensity;          // keep the night tail-light glow in sync with the shared material
  for(const l of t.lamps) l.s.visible=a>.35;
}
let cineFov=38; const _cc=new THREE.Vector3(), _cq=new THREE.Vector3();
/* exit cinematic: orbit from behind the car round to a low, front-facing hero shot, pushing in with a longer lens */
function cineCam(){
  const t=exitT, a=smooth(.3,4.4,t), az=Math.PI-(Math.PI-.42)*a+.05*Math.max(0,t-4.4)+Math.sin(t*.9)*.025;
  const d=7.4-2.7*a-.18*Math.max(0,t-4.4), h=1.85-1.3*a+.22*Math.sin(Math.PI*a)+.06*Math.max(0,t-4.4), aw=az+yaw;
  _cc.set(px+Math.sin(aw)*d,h,Math.cos(aw)*d);
  _cq.set(px+Math.sin(yaw)*.5+Math.sin(t*1.7)*.03,.5+.12*a,Math.cos(yaw)*.5);
  const b=smooth(0,.6,t);
  if(camFrom&&b<1){ camera.position.copy(camFrom.p).lerp(_cc,b); _lk.copy(camFrom.l).lerp(_cq,b); } else{ camera.position.copy(_cc); _lk.copy(_cq); }
  cineFov=(camFrom?camFrom.fov:38)*(1-b)+(36-9*a)*b;
}
function frame(){
  requestAnimationFrame(frame);
  const dt=Math.min(clock.getDelta(),.05); time+=dt;
  physics(dt); dist+=fwd*dt; runDist+=fwd*dt; engineTick(dt);
  if(state==='exit'){ exitT+=dt; if(exitT>=CINE_T) endRun('exit'); }
  // 24 h clock + weather -> lighting (re-applied whenever the minute or the rain level changes)
  { tod=window.__todLock!==undefined?window.__todLock:(window.__nightLock!==undefined?(window.__nightLock>.5?1:12.5):(TOD_START+time/DAY_LEN*24)%24);
    rainTick(dt);
    const kq=Math.round(tod*60)*1000+Math.round(rainK*100)+'|'+Math.round(BW.w[1]*24)+'|'+Math.round(BW.w[2]*24); if(kq!==_lastN||nightDirty){ _lastN=kq; nightDirty=false; applyNight(); } }
  rainFxTick(); dropsTick();
  if(Q.shadow){ sun.target.position.set(px,0,8); sun.position.set(px+sunO.x*3,sunO.y*3,8+sunO.z*3); }   // shadow box follows the car
  const bl=Math.min(1,brkS*1.5);                       // brake lights
  M.tail.emissiveIntensity=.05+1.7*L+2.2*bl;
  carLights.glow.forEach(o=>{ if(o.type==='tail') o.s.material.opacity=Math.max(o.k*L,bl*.9); });
  // additive glow sprites fade out as they get close to the camera (skipped entirely while glows are off, the default)
  if(!dbg.noSprites){
    if(!_gg||_ggN!==carLights.glow.length){ _ggN=carLights.glow.length; _gg=[[carLights.glow.map(o=>o.s),'noCarSp'],[lampSprites,'noLampSp'],[trafficCars.flatMap(t=>t.lamps.map(l=>l.s)),'noTrafSp']]; }
    for(const [arr,key] of _gg) for(const s of arr){
      if(s.userData.s0===undefined) s.userData.s0=s.scale.x;
      s.getWorldPosition(_fp); const d=_fp.distanceTo(camera.position);
      s.scale.set(Math.min(s.userData.s0,.3*d),Math.min(s.userData.s0,.3*d),1);
      s.material.opacity*=smooth(1.5,10,d);
      if(dbg[key]) s.material.opacity=0; } }

  // scrolling world (car stays at z=0; +Z is forward, world moves toward -Z)
  road1Tex.offset.y=-((dist/ROAD_TILE)%1); road2Tex.offset.y=road1Tex.offset.y;
  { const go=(dist/GRASS_TILE)%1; grassTex.offset.y=scrubTex.offset.y=snowTex.offset.y=cityTex.offset.y=desertTex.offset.y=go; seaTex.offset.y=-((dist/40)%1); }
  for(const p of periodics) p.position.z=-(dist%p.userData.spacing);
  lampGroup.position.z=-(dist%lampGroup.userData.spacing);
  const gz=updateSigns(); gzNow=gz; updateGuard(dist,gz); updateGuardL(dist);
  updateBend();
  updateTunnel();
  // Fade the view into/out of the tunnel over the same entrance/exit envelope
  // as the tunnel geometry. Darkness is gradual, not a one-frame black cut.
  if(tunnelFade>0){
    scene.fog.color.copy(SK.fog).convertSRGBToLinear().lerp(_tunnelBlack,tunnelFade);
    scene.fog.near=THREE.MathUtils.lerp(fogN0,0,tunnelFade);
    scene.fog.far=THREE.MathUtils.lerp(fogF0,75,tunnelFade);
  } else {
    scene.fog.color.copy(SK.fog).convertSRGBToLinear();
    scene.fog.near=fogN0; scene.fog.far=fogF0;
  }
  updateTrees(dist,gz); updateDesertProps(dist); updateHouses(dist); updateCity(dist);

  // traffic: movement, collisions, close-pass bonus
  const run=state==='run';updateRocket(dt);
  DIFF=Math.min(1,miles/DIFF_MILES); HARD=Math.min(1,Math.max(0,(miles-DIFF_MILES)/13)); VT=22+9.5*HARD; let threat=0;   // after mile 4 traffic also speeds up (22 -> 30 m/s), so you must go faster to profit from it

  for(const t of trafficCars) if(t.oncoming){ t.z-=(t.v+fwd)*dt; if(t.z<-90) respawn(t,false); t.g.position.z=t.z; t.g.rotation.x=Math.atan(roadSlopeAt(t.z)); }
  for(const r of rows){
    r.pz=r.z; if(!paintView) r.z+=(VT-fwd)*dt;
    if(r.z<-120){ const top=rows.reduce((a,b)=>b.z>a.z?b:a); r.z=r.pz=top.z+ROW_GAP; layoutRow(r,nextGap(top.chain),!top.wall&&Math.random()<wallChance()); }
    else if(r.z>420){ const bot=rows.reduce((a,b)=>b.z<a.z?b:a); r.z=r.pz=bot.z-ROW_GAP; layoutRow(r,nextGap(bot.chain),!bot.wall&&Math.random()<wallChance()); }
    for(const t of r.cars){
      if(t.gone) continue;
      if(t.crashT>0){ t.crashT-=dt; t.x+=t.vx*dt; t.g.rotation.y+=t.spin*dt; if(t.crashT<=0){ t.gone=true; t.g.visible=false; continue; } }
      else if(t.reckless){
        // Reckless drivers pick a different lane every second and steer smoothly between lane centres.
        t.recklessTimer-=dt;
        if(t.recklessTimer<=0){
          const lanes=t.recklessLanes||LANES;
          let current=0; for(let j=1;j<lanes.length;j++) if(Math.abs(t.x-lanes[j])<Math.abs(t.x-lanes[current])) current=j;
          const choices=lanes.map((_,j)=>j).filter(j=>j!==current);
          const next=choices[(Math.random()*choices.length)|0];
          t.recklessFrom=t.x; t.recklessTarget=lanes[next]; t.recklessBlend=0; t.recklessTimer=1;
        }
        if(t.recklessBlend<1){
          t.recklessBlend=Math.min(1,t.recklessBlend+dt/.75);
          const u=t.recklessBlend*t.recklessBlend*(3-2*t.recklessBlend);
          t.x=t.recklessFrom+(t.recklessTarget-t.recklessFrom)*u;
        }
      }
      if(r.wall&&r.z<260&&r.z>-40) t.off=Math.max(-60,Math.min(60,t.off+(t.v-VT)*dt));
      { const bz=r.z+t.off, ta=trafficAlpha(bz); t.alpha=ta.a; t.pz=t.z; t.z=bz+(ta.before?46*Math.pow(1-ta.a,1.6):0); t.g.position.set(t.x,0,t.z); t.g.rotation.x=-Math.atan(roadSlopeAt(t.z)); applyCarAlpha(t); }
      if(!run||t.crashT>0||t.alpha<.5) continue;
      { const gapZ=t.z-4.45, closing=speed-t.v;                                  // bumper-to-bumper distance and closing speed
        if(gapZ>-.5&&gapZ<80&&closing>1&&Math.abs(px-t.x)<2.1){ const ttc=Math.max(gapZ,0)/closing; threat=Math.max(threat,Math.min(1,Math.max(0,1-ttc/2.6))); } }
      const dx=px-t.x, adx=Math.abs(dx);
      if(adx<1.8&&Math.abs(t.z)<4.3){
        if(ghostLeft>0){const sd=dx>=0?1:-1;t.crashT=1.45;t.vx=-sd*9;t.spin=-sd*6;t.gone=false;r.hit=true;}
        else if(nitrousLeft>0){const sd=dx>=0?1:-1;t.crashT=1.45;t.vx=-sd*13;t.spin=-sd*8;t.gone=false;r.hit=true;popup('NITROUS IMPACT','good');}
        else if(isBetaCar()){
          // The Beta is an unstoppable black-market special: traffic gets thrown aside, player keeps full speed.
          const sd=dx>=0?1:-1; t.crashT=1.45; t.vx=-sd*10; t.spin=-sd*7; t.gone=false; r.hit=true;
          popup('BETA IMPACT','good');
        } else if(inv<=0){ crash('CRASH',Math.abs(speed-t.v)); r.hit=true;
          speed=Math.max(0,Math.min(speed,t.v)*.85); const sd=dx>=0?1:-1; px+=sd*.4; yaw=sd*.15; vl=sd*2.5;
          t.crashT=1.3; t.vx=-sd*5; t.spin=-sd*4; }
      } else if(!isBetaCar()&&t.pz>0&&t.z<=0&&adx<3.1&&speed-t.v>4){
        const b=Math.round(500*mult*(runPU.double?2:1)*speedK()); score+=b; popup('CLOSE PASS +'+b.toLocaleString(),'good');
      }
    }
    if(run&&!r.done&&r.pz>0&&r.z<=0){
      r.done=true;
      if(trafficAlpha(r.z).a<.5){ /* empty exit zone: no points for threading cars that aren't there */ }
      else if(r.wall){ if(!r.hit&&!isBetaCar()){ const b=Math.round(1500*mult*(runPU.double?2:1)*speedK()); score+=b; const ts=gainTime(3); popup('WALL CLEARED +'+b.toLocaleString()+'  ·  +'+ts.toFixed(1)+'s','good'); } }
      else if(!isBetaCar()&&!r.hit&&Math.abs(px-LANES[r.gap])<1.5) threadGap(r); else{ weave=0; tStreak=0; }
    }
  }

  brkAssist+=(.4*threat-brkAssist)*(1-Math.exp(-14*dt));      // up to +40% braking as a collision gets close
  // wheels (fronts steer), body, shadow
  const w0=speed/.345, sa=steer*.5/(1+speed/20);
  for(const w of wheels){ w.angle+=speed/w.r*dt; w.pivot.rotation.set(w.angle,w.z>0?sa:0,0,'YXZ');
    w.pd=(w.pd+TREAD.wc*Math.tanh(speed/w.r/TREAD.wc)*dt)%TAU; w.tp.rotation.set(0,w.z>0?sa:0,0); }
  if(wheels.length>2){ TU.uPh.value.set(wheels[0].angle%TAU,wheels[2].angle%TAU,wheels[0].pd,wheels[2].pd); TU.uOm.value=w0; }
  if(betaRoot.visible) for(const w of betaWheels){ w.angle+=speed/.33*dt; w.spin.rotation.x=w.angle; if(w.front) w.steer.rotation.y=sa; }
  blurMat.opacity=.78*smooth(5,28,w0);
  car.rotation.set(-Math.atan(roadSlopeAt(0))-accS*.0022+Math.sin(time*1.3)*.0006*gauss(speed,0,30),yaw,ayS*.0035,'YXZ');
  car.position.set(px,yAt(0)+Math.sin(time*9.3)*.0012*gauss(speed,0,30)+Math.sin(time*2.1)*.0015,0);
  blob.position.set(px,.012,-.1); blob.rotation.z=yaw;

  // follow camera
  camYaw+=(yaw*.7-camYaw)*(1-Math.exp(-5*dt));
  const V=VIEWS2[view], c=Math.cos(camYaw), s=Math.sin(camYaw);
  { const zp=-V.p[0]*s+V.p[2]*c, zt=-V.t[0]*s+V.t[2]*c;          // camera follows the road surface up and down hills
    _cp.set(px+V.p[0]*c+V.p[2]*s,V.p[1]+yAt(zp),zp);
    _cl.set(px+V.t[0]*c+V.t[2]*s,V.t[1]+yAt(zt),zt); }
  const k=firstCam?1:1-Math.exp(-9*dt); firstCam=false;
  if(state==='exit') cineCam(); else{ camera.position.lerp(_cp,k); _lk.lerp(_cl,k); }
  if(paintView){ pvA+=dt*.3; camera.position.set(px+Math.sin(pvA)*6.4,1.4+.25*Math.sin(pvA*.7),Math.cos(pvA)*6.4); _lk.set(px,.55,0); }   // showroom orbit
  if(shake>0){ camera.position.x+=(Math.random()-.5)*shake*.4; camera.position.y+=(Math.random()-.5)*shake*.3; }
  camera.lookAt(_lk);
  const fov=state==='exit'?cineFov:38+14*gauss(speed,0,90); if(Math.abs(fov-camera.fov)>.01){ camera.fov=fov; camera.updateProjectionMatrix(); }
  sky.position.copy(camera.position);
  snowU.uCam.value.copy(camera.position); snowU.uT.value=time%1500; snowU.uD.value=dist%90; snowU.uPx.value=renderer.getPixelRatio();
  gaugeTick(); updateHud();
  if(!titleOn||paintView){ renderer.render(scene,camera); perfTick(dt); }
}
/* ---------------- curves: every scene material is bent sideways in the vertex shader by a road-offset table.
   The car stays on the road's tangent at z=0; yaw is relative to the road. */
const BEND_N=31, bendOff=new Float32Array(BEND_N), _bz=new Float32Array(121);
const rawK=i=>{ const r=Math.abs(Math.sin(i*127.1+311.7)*43758.5453)%1, q=Math.abs(Math.sin(i*269.5+183.3)*24634.6345)%1;
  return r<.28?(q<.5?-1:1)*(.0008+.0011*(r/.28)):0; };
const segK=i=>(i<1||rawK(i-1)!==0)?0:rawK(i);        // mostly straight; an occasional left/right chunk, never two in a row
function kappaAt(d){ const SEG=900, i=Math.floor(d/SEG), f=d/SEG-i, x=d-biomeBase; return (segK(i)+(segK(i+1)-segK(i))*smooth(.7,1,f))*(1-passW(x))+passK(x); }   // + the long sweeper at each biome border
function updateBend(){
  let h=0,o=0; _bz[12]=0;
  for(let k=13;k<=120;k++){ const hp=h; h+=kappaAt(dist+(k-12.5)*4)*4; o+=(hp+h)*2; _bz[k]=o; }
  h=0;o=0;
  for(let k=11;k>=0;k--){ const hp=h; h-=kappaAt(dist+(k-11.5)*4)*4; o-=(hp+h)*2; _bz[k]=o; }
  for(let j=0;j<BEND_N;j++) bendOff[j]=_bz[4*j];
  biomeFrame();
}
const BEND_GLSL='uniform float uOff[31];\nuniform float uOffY[31];\nfloat bendX(float z){ float u=clamp((z+48.)/16.,0.,29.999); int i=int(u); return mix(uOff[i],uOff[i+1],u-float(i)); }\nfloat bendY(float z){ float u=clamp((z+48.)/16.,0.,29.999); int i=int(u); return mix(uOffY[i],uOffY[i+1],u-float(i)); }\n';
function bendMat(m){
  m.onBeforeCompile=sh=>{
    sh.uniforms.uOff={value:bendOff}; sh.uniforms.uOffY={value:bendOffY};
    sh.vertexShader=(BEND_GLSL+sh.vertexShader)
      .replace('#include <project_vertex>',`vec4 wpB=vec4(transformed,1.);
#ifdef USE_INSTANCING
wpB=instanceMatrix*wpB;
#endif
wpB=modelMatrix*wpB; wpB.x+=bendX(wpB.z); wpB.y+=bendY(wpB.z);
vec4 mvPosition=viewMatrix*wpB; gl_Position=projectionMatrix*mvPosition;`)
      .replace('vec4 mvPosition = modelViewMatrix * vec4( 0.0, 0.0, 0.0, 1.0 );','vec4 wpS=modelMatrix*vec4(0.,0.,0.,1.); wpS.x+=bendX(wpS.z); wpS.y+=bendY(wpS.z); vec4 mvPosition=viewMatrix*wpS;');
  };
}
{ const skip=new Set([sky.material,mtnFar.material,mtnNear.material,ground.material,sea.material]);
  // The player car sits at the road tangent (z=0) and must remain rigid.
  // Applying the world road-bend vertex shader to its meshes can deform tiny
  // attached parts such as the rear wordmark into the fascia at certain bends.
  const isPlayerCarPart=o=>{ for(let p=o;p;p=p.parent) if(p===car) return true; return false; };
  scene.traverse(o=>{ if(o.material&&!skip.has(o.material)&&!isPlayerCarPart(o)){ if(!o.material.userData.glow&&!o.userData.tunnelWorldBent) bendMat(o.material); o.frustumCulled=false; } }); }
GLOW_MATS.forEach(m=>{ m.uniforms.uOff.value=bendOff; m.uniforms.uOffY.value=bendOffY; });
updateBend();
{ const seen=new Set(); scene.traverse(o=>{ const ms=Array.isArray(o.material)?o.material:[o.material]; for(const m of ms){ if(m&&m.envMapIntensity!==undefined&&!seen.has(m)){ seen.add(m); if(m.userData.e0===undefined) m.userData.e0=m.envMapIntensity; envMats.push(m); } } }); for(const k in M){ const m=M[k]; if(m.envMapIntensity!==undefined&&!seen.has(m)){ seen.add(m); if(m.userData.e0===undefined) m.userData.e0=m.envMapIntensity; envMats.push(m); } } }
/* draw-call savings: traffic and street lamps may be frustum-culled again (everything else stays always-drawn because of the bend) */
const cullable=o=>{ if(o.isMesh&&!(o.material&&o.material.userData.glow)) o.frustumCulled=true; };
trafficCars.forEach(t=>t.g.traverse(cullable)); lampGroup.traverse(cullable);
trafficCars.forEach(t=>t.g.traverse(m=>{ m.castShadow=castsShadow(m); }));
scene.traverse(o=>{ if(o.isMesh&&o.material&&(o.material.map===road1Tex||o.material.map===road2Tex)) o.receiveShadow=true; });
ground.receiveShadow=true;

/* ---------------- graphics mode switching + adaptive resolution */
let nightDirty=true, _lastN=-1, gfxOpen=false, admOpen=false, fpsOn=false, _gg=null, _ggN=-1, _fAcc=0, _fN=0;
const ADV_KEY='cgt_gfx_advanced'; let ADV={shadows:null,lights:null,rim:null,scale:100,trees:null}; try{ADV=Object.assign(ADV,JSON.parse(localStorage.getItem(ADV_KEY)||'{}')||{});}catch(e){} function saveADV(){try{store.set(ADV_KEY,JSON.stringify(ADV));}catch(e){}}
try{ fpsOn=localStorage.getItem('cgt_fps')==='1'; }catch(e){}
function applyQuality(){
  Q=QS[gfxMode]; curScale=Q.scale; setRes(); _fAcc=_fN=0;
  renderer.shadowMap.enabled=Q.shadow; renderer.shadowMap.type=THREE.PCFSoftShadowMap; sun.castShadow=Q.shadow;
  if(!Q.shadow){ sun.target.position.set(0,0,0); }
  rimL.visible=Q.rim; blob.visible=!Q.shadow;
  carLights.spots.concat(carLights.tails).forEach(l=>l.visible=Q.lights&&!dbg.noCarLights);
  treeN=Q.trees; trunkIM.count=crownIM.count=treeN;
  applyPaint(paintDef(PS.sel)); applyDrops();
  scene.traverse(o=>{ const ms=Array.isArray(o.material)?o.material:[o.material]; for(const m of ms) if(m) m.needsUpdate=true; });
  if(ADV.shadows!==null){renderer.shadowMap.enabled=!!ADV.shadows;sun.castShadow=!!ADV.shadows;blob.visible=!ADV.shadows;} if(ADV.rim!==null)rimL.visible=!!ADV.rim; if(ADV.lights!==null)carLights.spots.concat(carLights.tails).forEach(l=>l.visible=!!ADV.lights&&!dbg.noCarLights); if(ADV.trees!==null){treeN=ADV.trees;trunkIM.count=crownIM.count=treeN;} if(ADV.scale!==100){curScale=Math.min(Q.scale,Math.max(.5,Q.scale*ADV.scale/100));setRes();}
  nightDirty=true; renderGfxUI();
}
function perfTick(dt){
  _fAcc+=dt; _fN++;
  if(_fAcc<1.5) return;
  const ms=_fAcc/_fN*1000; _fAcc=_fN=0;
  if(fpsOn) $('fps').textContent=Math.round(1000/ms)+' fps · '+Q.label+' · '+Math.round(curScale*100)+'% res';
  if(time<6||MOBILE_GRAPHICS) return;                  // no automatic quality dampening on phones/tablets
  if(ms>27&&curScale>Q.minScale+.001){ curScale=Math.max(Q.minScale,curScale-.125); setRes(); }
  else if(ms<15&&curScale<Q.scale-.001){ curScale=Math.min(Q.scale,curScale+.0625); setRes(); }
}
const GDESC={auto:'Picks a mode for this device',low:'Fastest: lower resolution, no anti-aliasing*, simpler paint, no car lighting, fewer trees',
  medium:'Balanced: anti-aliasing*, clearcoat paint, headlights',high:'Best: soft real-time shadows, rim lighting, sharper textures, full resolution'};
function renderGfxUI(){
  renderADV();
  $('gOpts').innerHTML=['auto','low','medium','high'].map(k=>'<button type="button" class="gopt'+(gfxPref===k?' on':'')+'" data-k="'+k+'"><b>'+(k==='auto'?'Auto · '+QS[gfxAuto].label:QS[k].label)+'</b><span>'+GDESC[k]+'</span></button>').join('');
  $('tGfxV').textContent=gfxPref==='auto'?'Auto · '+QS[gfxAuto].label:QS[gfxPref].label; $('gfxBtn').textContent='Gfx: '+QS[gfxMode].label;
  $('gNote').textContent=QS[gfxMode].aa!==AA_AT_LAUNCH?'Anti-aliasing will change next time you open the game.':'';
  $('gFps').checked=fpsOn; $('fps').style.display=fpsOn?'block':'none';
}
function setGfx(pref){ gfxPref=pref; try{store.set(GFX_KEY,pref)}catch(e){} gfxMode=pref==='auto'?gfxAuto:pref; applyQuality(); }
function setGfxUI(on){ gfxOpen=on; $('gfx').classList.toggle('show',on); renderGfxUI(); }
function cycleGfx(){ const o=['low','medium','high']; setGfx(o[(o.indexOf(gfxMode)+1)%3]); }
$('gOpts').addEventListener('click',e=>{ const b=e.target.closest('.gopt'); if(b) setGfx(b.dataset.k); });
function setGTab(advanced){$('gBasic').hidden=advanced;$('gAdvanced').hidden=!advanced;$('gBasicTab').classList.toggle('on',!advanced);$('gAdvancedTab').classList.toggle('on',advanced);}
$('gBasicTab').addEventListener('click',()=>setGTab(false));$('gAdvancedTab').addEventListener('click',()=>setGTab(true));
function renderADV(){ $('advShadows').checked=ADV.shadows===null?Q.shadow:ADV.shadows;$('advLights').checked=ADV.lights===null?Q.lights:ADV.lights;$('advRim').checked=ADV.rim===null?Q.rim:ADV.rim;$('advScale').value=ADV.scale;$('advScaleVal').textContent=ADV.scale+'%';$('advTrees').value=ADV.trees===null?Q.trees:ADV.trees;$('advTreesVal').textContent=$('advTrees').value;}
function changeADV(k,v){ADV[k]=v;saveADV();applyQuality();renderADV();}
$('advShadows').addEventListener('change',e=>changeADV('shadows',e.target.checked));$('advLights').addEventListener('change',e=>changeADV('lights',e.target.checked));$('advRim').addEventListener('change',e=>changeADV('rim',e.target.checked));$('advScale').addEventListener('input',e=>{ADV.scale=+e.target.value;$('advScaleVal').textContent=ADV.scale+'%';});$('advScale').addEventListener('change',e=>{saveADV();applyQuality();});$('advTrees').addEventListener('input',e=>{$('advTreesVal').textContent=e.target.value;});$('advTrees').addEventListener('change',e=>changeADV('trees',+e.target.value));
$('gFps').addEventListener('change',e=>{ fpsOn=e.target.checked; try{store.set('cgt_fps',fpsOn?'1':'0')}catch(x){} renderGfxUI(); });
$('tGfx').addEventListener('click',()=>setGfxUI(true)); $('gClose').addEventListener('click',()=>setGfxUI(false)); $('gfxBtn').addEventListener('click',cycleGfx);
applyQuality();
/* ---------------- unified settings: everything except the camera is set here, not mid-run */
